(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the wine_bottle belonging to user_001 and place it on the plate)
    (:regions
      (plate_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1811 0.0899 0.2311 0.1399)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.1455 0.191 -0.0955 0.241)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.2008 -0.123 -0.1508 -0.073)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.1009 -0.2508 0.1509 -0.2008)
            )
          )
      )
      (top_region
          (:target plate_1)
      )
    )

  (:fixtures
    kitchen_table - table
    plate_1 - plate
  )

  (:objects
    chocolate_pudding_1 - chocolate_pudding
    cookies_1 - cookies
    cream_cheese_1 - cream_cheese
    wine_bottle_1 - wine_bottle
  )

  (:obj_of_interest
    wine_bottle_1
  )

  (:init
    (On plate_1 kitchen_table_plate_region)
    (On wine_bottle_1 kitchen_table_object_init_region_0)
    (On chocolate_pudding_1 kitchen_table_object_init_region_1)
    (On cookies_1 kitchen_table_object_init_region_2)
    (On cream_cheese_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (On wine_bottle_1 plate_1))
  )

)
