(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the salad_dressing belonging to user_001 and place it in the basket)
    (:regions
      (basket_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1841 0.067 0.2341 0.117)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.0198 0.211 0.0302 0.261)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.2095 0.066 -0.1595 0.116)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (-0.0295 -0.2281 0.0205 -0.1781)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    living_room_table - table
    basket_1 - basket
  )

  (:objects
    chocolate_pudding_1 - chocolate_pudding
    cookies_1 - cookies
    cream_cheese_1 - cream_cheese
    salad_dressing_1 - salad_dressing
  )

  (:obj_of_interest
    salad_dressing_1
  )

  (:init
    (On basket_1 living_room_table_basket_region)
    (On salad_dressing_1 living_room_table_object_init_region_0)
    (On chocolate_pudding_1 living_room_table_object_init_region_1)
    (On cookies_1 living_room_table_object_init_region_2)
    (On cream_cheese_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (In salad_dressing_1 basket_1_contain_region))
  )

)
