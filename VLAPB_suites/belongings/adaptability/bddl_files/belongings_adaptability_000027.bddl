(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the wine_bottle belonging to user_001 and place it on the flat_stove)
    (:regions
      (flat_stove_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1579 0.1087 0.2079 0.1587)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.1508 0.1471 -0.1008 0.1971)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.2285 -0.1737 -0.1785 -0.1237)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.0975 -0.1926 0.1475 -0.1426)
            )
          )
      )
      (cook_region
          (:target flat_stove_1)
      )
    )

  (:fixtures
    kitchen_table - table
    flat_stove_1 - flat_stove
  )

  (:objects
    chocolate_pudding_1 - chocolate_pudding
    cookies_1 - cookies
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    wine_bottle_1 - wine_bottle
  )

  (:obj_of_interest
    wine_bottle_1
  )

  (:init
    (On flat_stove_1 kitchen_table_flat_stove_region)
    (On wine_bottle_1 kitchen_table_object_init_region_0)
    (On chocolate_pudding_1 kitchen_table_object_init_region_1)
    (On cookies_1 kitchen_table_object_init_region_2)
    (On glazed_rim_porcelain_ramekin_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (On wine_bottle_1 flat_stove_1_cook_region))
  )

)
