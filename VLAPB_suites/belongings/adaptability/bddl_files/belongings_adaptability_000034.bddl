(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the white_bowl belonging to user_001 and place it in the wooden_tray)
    (:regions
      (wooden_tray_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.2008 0.0999 0.2508 0.1499)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.1359 0.1755 -0.0859 0.2255)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.213 -0.129 -0.163 -0.079)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.0843 -0.2226 0.1343 -0.1726)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    living_room_table - table
    wooden_tray_1 - wooden_tray
  )

  (:objects
    chocolate_pudding_1 - chocolate_pudding
    cookies_1 - cookies
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    white_bowl_1 - white_bowl
  )

  (:obj_of_interest
    white_bowl_1
  )

  (:init
    (On wooden_tray_1 living_room_table_wooden_tray_region)
    (On white_bowl_1 living_room_table_object_init_region_0)
    (On chocolate_pudding_1 living_room_table_object_init_region_1)
    (On cookies_1 living_room_table_object_init_region_2)
    (On glazed_rim_porcelain_ramekin_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (In white_bowl_1 wooden_tray_1_contain_region))
  )

)
