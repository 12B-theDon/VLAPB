(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the white_yellow_mug belonging to user_001 and place it on the flat_stove)
    (:regions
      (flat_stove_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1585 0.1331 0.2085 0.1831)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.1782 0.1528 -0.1282 0.2028)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.2073 -0.1821 -0.1573 -0.1321)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.1237 -0.1975 0.1737 -0.1475)
            )
          )
      )
      (cook_region
          (:target flat_stove_1)
      )
    )

  (:fixtures
    living_room_table - table
    flat_stove_1 - flat_stove
  )

  (:objects
    chocolate_pudding_1 - chocolate_pudding
    cookies_1 - cookies
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    white_yellow_mug_1 - white_yellow_mug
  )

  (:obj_of_interest
    white_yellow_mug_1
  )

  (:init
    (On flat_stove_1 living_room_table_flat_stove_region)
    (On white_yellow_mug_1 living_room_table_object_init_region_0)
    (On chocolate_pudding_1 living_room_table_object_init_region_1)
    (On cookies_1 living_room_table_object_init_region_2)
    (On glazed_rim_porcelain_ramekin_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (On white_yellow_mug_1 flat_stove_1_cook_region))
  )

)
