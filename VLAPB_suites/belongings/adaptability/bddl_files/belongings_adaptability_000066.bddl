(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the tomato_sauce belonging to user_001 and place it in the wooden_tray)
    (:regions
      (wooden_tray_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1455 0.1009 0.1955 0.1509)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.1654 0.1651 -0.1154 0.2151)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.2279 -0.1749 -0.1779 -0.1249)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.1167 -0.2168 0.1667 -0.1668)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    living_room_table - table
    wooden_tray_1 - wooden_tray
  )

  (:objects
    chocolate_pudding_1 - chocolate_pudding
    cookies_1 - cookies
    ketchup_1 - ketchup
    tomato_sauce_1 - tomato_sauce
  )

  (:obj_of_interest
    tomato_sauce_1
  )

  (:init
    (On wooden_tray_1 living_room_table_wooden_tray_region)
    (On tomato_sauce_1 living_room_table_object_init_region_0)
    (On chocolate_pudding_1 living_room_table_object_init_region_1)
    (On cookies_1 living_room_table_object_init_region_2)
    (On ketchup_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (In tomato_sauce_1 wooden_tray_1_contain_region))
  )

)
