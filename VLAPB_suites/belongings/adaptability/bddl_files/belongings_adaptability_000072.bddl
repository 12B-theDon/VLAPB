(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the white_yellow_mug belonging to user_001 and place it on the plate)
    (:regions
      (plate_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1595 0.138 0.2095 0.188)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.1783 0.1485 -0.1283 0.1985)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.208 -0.1866 -0.158 -0.1366)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.1291 -0.1995 0.1791 -0.1495)
            )
          )
      )
      (top_region
          (:target plate_1)
      )
    )

  (:fixtures
    living_room_table - table
    plate_1 - plate
  )

  (:objects
    chocolate_pudding_1 - chocolate_pudding
    cookies_1 - cookies
    ketchup_1 - ketchup
    white_yellow_mug_1 - white_yellow_mug
  )

  (:obj_of_interest
    white_yellow_mug_1
  )

  (:init
    (On plate_1 living_room_table_plate_region)
    (On white_yellow_mug_1 living_room_table_object_init_region_0)
    (On chocolate_pudding_1 living_room_table_object_init_region_1)
    (On cookies_1 living_room_table_object_init_region_2)
    (On ketchup_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (On white_yellow_mug_1 plate_1))
  )

)
