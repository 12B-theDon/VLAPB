(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the wine_bottle belonging to user_001 and place it in the basket)
    (:regions
      (basket_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.2135 0.0604 0.2635 0.1104)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.0018 0.2244 0.0482 0.2744)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.2256 0.0923 -0.1756 0.1423)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (-0.0439 -0.2287 0.0061 -0.1787)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    living_room_table - table
    basket_1 - basket
  )

  (:objects
    chocolate_pudding_1 - chocolate_pudding
    cookies_1 - cookies
    milk_1 - milk
    wine_bottle_1 - wine_bottle
  )

  (:obj_of_interest
    wine_bottle_1
  )

  (:init
    (On basket_1 living_room_table_basket_region)
    (On wine_bottle_1 living_room_table_object_init_region_0)
    (On chocolate_pudding_1 living_room_table_object_init_region_1)
    (On cookies_1 living_room_table_object_init_region_2)
    (On milk_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (In wine_bottle_1 basket_1_contain_region))
  )

)
