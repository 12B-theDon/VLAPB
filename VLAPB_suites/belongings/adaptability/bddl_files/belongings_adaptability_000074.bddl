(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the wine_bottle belonging to user_001 and place it in the wooden_tray)
    (:regions
      (wooden_tray_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1307 0.1226 0.1807 0.1726)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.1946 0.1539 -0.1446 0.2039)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.1777 -0.1697 -0.1277 -0.1197)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.139 -0.198 0.189 -0.148)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    living_room_table - table
    wooden_tray_1 - wooden_tray
  )

  (:objects
    chocolate_pudding_1 - chocolate_pudding
    cookies_1 - cookies
    milk_1 - milk
    wine_bottle_1 - wine_bottle
  )

  (:obj_of_interest
    wine_bottle_1
  )

  (:init
    (On wooden_tray_1 living_room_table_wooden_tray_region)
    (On wine_bottle_1 living_room_table_object_init_region_0)
    (On chocolate_pudding_1 living_room_table_object_init_region_1)
    (On cookies_1 living_room_table_object_init_region_2)
    (On milk_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (In wine_bottle_1 wooden_tray_1_contain_region))
  )

)
