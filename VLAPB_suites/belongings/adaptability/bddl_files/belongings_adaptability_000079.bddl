(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the salad_dressing belonging to user_001 and place it on the flat_stove)
    (:regions
      (flat_stove_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1381 0.1205 0.1881 0.1705)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.1766 0.1451 -0.1266 0.1951)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.194 -0.1757 -0.144 -0.1257)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.1094 -0.1757 0.1594 -0.1257)
            )
          )
      )
      (cook_region
          (:target flat_stove_1)
      )
    )

  (:fixtures
    living_room_table - table
    flat_stove_1 - flat_stove
  )

  (:objects
    chocolate_pudding_1 - chocolate_pudding
    cookies_1 - cookies
    milk_1 - milk
    salad_dressing_1 - salad_dressing
  )

  (:obj_of_interest
    salad_dressing_1
  )

  (:init
    (On flat_stove_1 living_room_table_flat_stove_region)
    (On salad_dressing_1 living_room_table_object_init_region_0)
    (On chocolate_pudding_1 living_room_table_object_init_region_1)
    (On cookies_1 living_room_table_object_init_region_2)
    (On milk_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (On salad_dressing_1 flat_stove_1_cook_region))
  )

)
