(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the red_coffee_mug belonging to user_005 and place it on the plate)
    (:regions
      (plate_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1302 0.1266 0.1802 0.1766)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.1677 0.1211 -0.1177 0.1711)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.1927 -0.1889 -0.1427 -0.1389)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.1396 -0.1934 0.1896 -0.1434)
            )
          )
      )
      (top_region
          (:target plate_1)
      )
    )

  (:fixtures
    living_room_table - table
    plate_1 - plate
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    chocolate_pudding_1 - chocolate_pudding
    cookies_1 - cookies
    red_coffee_mug_1 - red_coffee_mug
  )

  (:obj_of_interest
    red_coffee_mug_1
  )

  (:init
    (On plate_1 living_room_table_plate_region)
    (On red_coffee_mug_1 living_room_table_object_init_region_0)
    (On akita_black_bowl_1 living_room_table_object_init_region_1)
    (On chocolate_pudding_1 living_room_table_object_init_region_2)
    (On cookies_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (On red_coffee_mug_1 plate_1))
  )

)
