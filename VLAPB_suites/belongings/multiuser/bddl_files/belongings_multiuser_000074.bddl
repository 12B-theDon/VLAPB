(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the glazed_rim_porcelain_ramekin belonging to user_007 and place it in the wooden_tray)
    (:regions
      (wooden_tray_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1494 0.1434 0.1994 0.1934)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.1897 0.1455 -0.1397 0.1955)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.1697 -0.1648 -0.1197 -0.1148)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.1405 -0.1963 0.1905 -0.1463)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    kitchen_table - table
    wooden_tray_1 - wooden_tray
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    cookies_1 - cookies
    cream_cheese_1 - cream_cheese
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
  )

  (:obj_of_interest
    glazed_rim_porcelain_ramekin_1
  )

  (:init
    (On wooden_tray_1 kitchen_table_wooden_tray_region)
    (On glazed_rim_porcelain_ramekin_1 kitchen_table_object_init_region_0)
    (On akita_black_bowl_1 kitchen_table_object_init_region_1)
    (On cookies_1 kitchen_table_object_init_region_2)
    (On cream_cheese_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (In glazed_rim_porcelain_ramekin_1 wooden_tray_1_contain_region))
  )

)
