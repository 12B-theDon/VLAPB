(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the new_salad_dressing belonging to user_007 and place it on the plate)
    (:regions
      (plate_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.135 0.1338 0.185 0.1838)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.2064 0.1577 -0.1564 0.2077)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.1726 -0.1715 -0.1226 -0.1215)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.1259 -0.177 0.1759 -0.127)
            )
          )
      )
      (top_region
          (:target plate_1)
      )
    )

  (:fixtures
    living_room_table - table
    plate_1 - plate
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    cookies_1 - cookies
    cream_cheese_1 - cream_cheese
    new_salad_dressing_1 - new_salad_dressing
  )

  (:obj_of_interest
    new_salad_dressing_1
  )

  (:init
    (On plate_1 living_room_table_plate_region)
    (On new_salad_dressing_1 living_room_table_object_init_region_0)
    (On akita_black_bowl_1 living_room_table_object_init_region_1)
    (On cookies_1 living_room_table_object_init_region_2)
    (On cream_cheese_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (On new_salad_dressing_1 plate_1))
  )

)
