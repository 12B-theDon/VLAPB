(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the cream_cheese belonging to user_002 and place it on the plate)
    (:regions
      (plate_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1258 0.122 0.1758 0.172)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.1823 0.1364 -0.1323 0.1864)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.1987 -0.1942 -0.1487 -0.1442)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.1281 -0.1821 0.1781 -0.1321)
            )
          )
      )
      (top_region
          (:target plate_1)
      )
    )

  (:fixtures
    living_room_table - table
    plate_1 - plate
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    bbq_sauce_1 - bbq_sauce
    butter_1 - butter
    cream_cheese_1 - cream_cheese
  )

  (:obj_of_interest
    cream_cheese_1
  )

  (:init
    (On plate_1 living_room_table_plate_region)
    (On cream_cheese_1 living_room_table_object_init_region_0)
    (On alphabet_soup_1 living_room_table_object_init_region_1)
    (On bbq_sauce_1 living_room_table_object_init_region_2)
    (On butter_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (On cream_cheese_1 plate_1))
  )

)
