(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the cookies belonging to user_008 and place it in the wooden_tray)
    (:regions
      (wooden_tray_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1888 0.0918 0.2388 0.1418)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.1422 0.1894 -0.0922 0.2394)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.2338 -0.1391 -0.1838 -0.0891)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.0936 -0.2419 0.1436 -0.1919)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    living_room_table - table
    wooden_tray_1 - wooden_tray
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    bbq_sauce_1 - bbq_sauce
    butter_1 - butter
    cookies_1 - cookies
  )

  (:obj_of_interest
    cookies_1
  )

  (:init
    (On wooden_tray_1 living_room_table_wooden_tray_region)
    (On cookies_1 living_room_table_object_init_region_0)
    (On akita_black_bowl_1 living_room_table_object_init_region_1)
    (On bbq_sauce_1 living_room_table_object_init_region_2)
    (On butter_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (In cookies_1 wooden_tray_1_contain_region))
  )

)
