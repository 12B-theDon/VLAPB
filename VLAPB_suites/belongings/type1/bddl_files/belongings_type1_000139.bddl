(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the milk belonging to user_009 and place it on the flat_stove)
    (:regions
      (flat_stove_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1815 0.1188 0.2315 0.1688)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.1403 0.1406 -0.0903 0.1906)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.2039 -0.1496 -0.1539 -0.0996)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.1177 -0.2299 0.1677 -0.1799)
            )
          )
      )
      (cook_region
          (:target flat_stove_1)
      )
    )

  (:fixtures
    kitchen_table - table
    flat_stove_1 - flat_stove
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    bbq_sauce_1 - bbq_sauce
    butter_1 - butter
    milk_1 - milk
  )

  (:obj_of_interest
    milk_1
  )

  (:init
    (On flat_stove_1 kitchen_table_flat_stove_region)
    (On milk_1 kitchen_table_object_init_region_0)
    (On akita_black_bowl_1 kitchen_table_object_init_region_1)
    (On bbq_sauce_1 kitchen_table_object_init_region_2)
    (On butter_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (On milk_1 flat_stove_1_cook_region))
  )

)
