(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the cream_cheese belonging to user_009 and place it on the plate)
    (:regions
      (plate_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1593 0.154 0.2093 0.204)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.1967 0.1519 -0.1467 0.2019)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.1958 -0.1908 -0.1458 -0.1408)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.1435 -0.1986 0.1935 -0.1486)
            )
          )
      )
      (top_region
          (:target plate_1)
      )
    )

  (:fixtures
    kitchen_table - table
    plate_1 - plate
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    bbq_sauce_1 - bbq_sauce
    butter_1 - butter
    cream_cheese_1 - cream_cheese
  )

  (:obj_of_interest
    cream_cheese_1
  )

  (:init
    (On plate_1 kitchen_table_plate_region)
    (On cream_cheese_1 kitchen_table_object_init_region_0)
    (On akita_black_bowl_1 kitchen_table_object_init_region_1)
    (On bbq_sauce_1 kitchen_table_object_init_region_2)
    (On butter_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (On cream_cheese_1 plate_1))
  )

)
