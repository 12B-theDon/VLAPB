(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the red_coffee_mug belonging to user_014 and place it in the wooden_tray)
    (:regions
      (wooden_tray_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1582 0.107 0.2082 0.157)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.17 0.1762 -0.12 0.2262)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.1848 -0.1401 -0.1348 -0.0901)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.0946 -0.191 0.1446 -0.141)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    kitchen_table - table
    wooden_tray_1 - wooden_tray
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    alphabet_soup_1 - alphabet_soup
    bbq_sauce_1 - bbq_sauce
    red_coffee_mug_1 - red_coffee_mug
  )

  (:obj_of_interest
    red_coffee_mug_1
  )

  (:init
    (On wooden_tray_1 kitchen_table_wooden_tray_region)
    (On red_coffee_mug_1 kitchen_table_object_init_region_0)
    (On akita_black_bowl_1 kitchen_table_object_init_region_1)
    (On alphabet_soup_1 kitchen_table_object_init_region_2)
    (On bbq_sauce_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (In red_coffee_mug_1 wooden_tray_1_contain_region))
  )

)
