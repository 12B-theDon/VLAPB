(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the ketchup belonging to user_017 and place it in the wooden_tray)
    (:regions
      (wooden_tray_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1622 0.0737 0.2122 0.1237)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.1286 0.1716 -0.0786 0.2216)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.245 -0.1409 -0.195 -0.0909)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.0939 -0.2505 0.1439 -0.2005)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    living_room_table - table
    wooden_tray_1 - wooden_tray
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    alphabet_soup_1 - alphabet_soup
    bbq_sauce_1 - bbq_sauce
    ketchup_1 - ketchup
  )

  (:obj_of_interest
    ketchup_1
  )

  (:init
    (On wooden_tray_1 living_room_table_wooden_tray_region)
    (On ketchup_1 living_room_table_object_init_region_0)
    (On akita_black_bowl_1 living_room_table_object_init_region_1)
    (On alphabet_soup_1 living_room_table_object_init_region_2)
    (On bbq_sauce_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (In ketchup_1 wooden_tray_1_contain_region))
  )

)
