(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the glazed_rim_porcelain_ramekin belonging to user_016 and place it in the wooden_tray)
    (:regions
      (wooden_tray_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1448 0.1461 0.1948 0.1961)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.1729 0.1218 -0.1229 0.1718)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.1801 -0.1813 -0.1301 -0.1313)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.1256 -0.1744 0.1756 -0.1244)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    living_room_table - table
    wooden_tray_1 - wooden_tray
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    alphabet_soup_1 - alphabet_soup
    bbq_sauce_1 - bbq_sauce
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
  )

  (:obj_of_interest
    glazed_rim_porcelain_ramekin_1
  )

  (:init
    (On wooden_tray_1 living_room_table_wooden_tray_region)
    (On glazed_rim_porcelain_ramekin_1 living_room_table_object_init_region_0)
    (On akita_black_bowl_1 living_room_table_object_init_region_1)
    (On alphabet_soup_1 living_room_table_object_init_region_2)
    (On bbq_sauce_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (In glazed_rim_porcelain_ramekin_1 wooden_tray_1_contain_region))
  )

)
