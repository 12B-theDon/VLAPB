(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the glazed_rim_porcelain_ramekin belonging to user_016 and place it on the plate)
    (:regions
      (plate_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1879 0.0842 0.2379 0.1342)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.1263 0.1723 -0.0763 0.2223)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.2408 -0.1357 -0.1908 -0.0857)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.0924 -0.2538 0.1424 -0.2038)
            )
          )
      )
      (top_region
          (:target plate_1)
      )
    )

  (:fixtures
    living_room_table - table
    plate_1 - plate
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    alphabet_soup_1 - alphabet_soup
    bbq_sauce_1 - bbq_sauce
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
  )

  (:obj_of_interest
    glazed_rim_porcelain_ramekin_1
  )

  (:init
    (On plate_1 living_room_table_plate_region)
    (On glazed_rim_porcelain_ramekin_1 living_room_table_object_init_region_0)
    (On akita_black_bowl_1 living_room_table_object_init_region_1)
    (On alphabet_soup_1 living_room_table_object_init_region_2)
    (On bbq_sauce_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (On glazed_rim_porcelain_ramekin_1 plate_1))
  )

)
