(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the salad_dressing belonging to user_012 and place it in the wooden_tray)
    (:regions
      (wooden_tray_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1494 0.0706 0.1994 0.1206)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.1424 0.1892 -0.0924 0.2392)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.2094 -0.126 -0.1594 -0.076)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.0914 -0.2375 0.1414 -0.1875)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    kitchen_table - table
    wooden_tray_1 - wooden_tray
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    alphabet_soup_1 - alphabet_soup
    butter_1 - butter
    salad_dressing_1 - salad_dressing
  )

  (:obj_of_interest
    salad_dressing_1
  )

  (:init
    (On wooden_tray_1 kitchen_table_wooden_tray_region)
    (On salad_dressing_1 kitchen_table_object_init_region_0)
    (On akita_black_bowl_1 kitchen_table_object_init_region_1)
    (On alphabet_soup_1 kitchen_table_object_init_region_2)
    (On butter_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (In salad_dressing_1 wooden_tray_1_contain_region))
  )

)
