(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the white_bowl belonging to user_017 and place it in the wooden_tray)
    (:regions
      (wooden_tray_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1539 0.1014 0.2039 0.1514)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.1642 0.172 -0.1142 0.222)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.2197 -0.1626 -0.1697 -0.1126)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.1043 -0.2079 0.1543 -0.1579)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    living_room_table - table
    wooden_tray_1 - wooden_tray
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    alphabet_soup_1 - alphabet_soup
    bbq_sauce_1 - bbq_sauce
    white_bowl_1 - white_bowl
  )

  (:obj_of_interest
    white_bowl_1
  )

  (:init
    (On wooden_tray_1 living_room_table_wooden_tray_region)
    (On white_bowl_1 living_room_table_object_init_region_0)
    (On akita_black_bowl_1 living_room_table_object_init_region_1)
    (On alphabet_soup_1 living_room_table_object_init_region_2)
    (On bbq_sauce_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (In white_bowl_1 wooden_tray_1_contain_region))
  )

)
