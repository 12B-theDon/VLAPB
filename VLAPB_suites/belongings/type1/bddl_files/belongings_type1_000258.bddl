(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the cream_cheese belonging to user_012 and place it in the wooden_tray)
    (:regions
      (wooden_tray_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1246 0.1062 0.1746 0.1562)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.1835 0.1557 -0.1335 0.2057)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.2053 -0.1832 -0.1553 -0.1332)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.1372 -0.2099 0.1872 -0.1599)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    kitchen_table - table
    wooden_tray_1 - wooden_tray
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    alphabet_soup_1 - alphabet_soup
    butter_1 - butter
    cream_cheese_1 - cream_cheese
  )

  (:obj_of_interest
    cream_cheese_1
  )

  (:init
    (On wooden_tray_1 kitchen_table_wooden_tray_region)
    (On cream_cheese_1 kitchen_table_object_init_region_0)
    (On akita_black_bowl_1 kitchen_table_object_init_region_1)
    (On alphabet_soup_1 kitchen_table_object_init_region_2)
    (On butter_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (In cream_cheese_1 wooden_tray_1_contain_region))
  )

)
