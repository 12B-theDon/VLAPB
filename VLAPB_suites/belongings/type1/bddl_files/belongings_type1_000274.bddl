(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the red_coffee_mug belonging to user_020 and place it in the wooden_tray)
    (:regions
      (wooden_tray_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1395 0.1322 0.1895 0.1822)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.2031 0.1614 -0.1531 0.2114)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.1675 -0.1611 -0.1175 -0.1111)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.1404 -0.1981 0.1904 -0.1481)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    living_room_table - table
    wooden_tray_1 - wooden_tray
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    alphabet_soup_1 - alphabet_soup
    bbq_sauce_1 - bbq_sauce
    red_coffee_mug_1 - red_coffee_mug
  )

  (:obj_of_interest
    red_coffee_mug_1
  )

  (:init
    (On wooden_tray_1 living_room_table_wooden_tray_region)
    (On red_coffee_mug_1 living_room_table_object_init_region_0)
    (On akita_black_bowl_1 living_room_table_object_init_region_1)
    (On alphabet_soup_1 living_room_table_object_init_region_2)
    (On bbq_sauce_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (In red_coffee_mug_1 wooden_tray_1_contain_region))
  )

)
