(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the salad_dressing belonging to user_017 and place it on the plate)
    (:regions
      (plate_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1606 0.0921 0.2106 0.1421)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.1498 0.1727 -0.0998 0.2227)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.2358 -0.158 -0.1858 -0.108)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.0938 -0.2133 0.1438 -0.1633)
            )
          )
      )
      (top_region
          (:target plate_1)
      )
    )

  (:fixtures
    living_room_table - table
    plate_1 - plate
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    alphabet_soup_1 - alphabet_soup
    bbq_sauce_1 - bbq_sauce
    salad_dressing_1 - salad_dressing
  )

  (:obj_of_interest
    salad_dressing_1
  )

  (:init
    (On plate_1 living_room_table_plate_region)
    (On salad_dressing_1 living_room_table_object_init_region_0)
    (On akita_black_bowl_1 living_room_table_object_init_region_1)
    (On alphabet_soup_1 living_room_table_object_init_region_2)
    (On bbq_sauce_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (On salad_dressing_1 plate_1))
  )

)
