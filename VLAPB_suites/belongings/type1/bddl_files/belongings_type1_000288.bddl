(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the milk belonging to user_019 and place it on the plate)
    (:regions
      (plate_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1691 0.1102 0.2191 0.1602)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.1595 0.1681 -0.1095 0.2181)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.2097 -0.1536 -0.1597 -0.1036)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.0888 -0.1884 0.1388 -0.1384)
            )
          )
      )
      (top_region
          (:target plate_1)
      )
    )

  (:fixtures
    living_room_table - table
    plate_1 - plate
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    alphabet_soup_1 - alphabet_soup
    bbq_sauce_1 - bbq_sauce
    milk_1 - milk
  )

  (:obj_of_interest
    milk_1
  )

  (:init
    (On plate_1 living_room_table_plate_region)
    (On milk_1 living_room_table_object_init_region_0)
    (On akita_black_bowl_1 living_room_table_object_init_region_1)
    (On alphabet_soup_1 living_room_table_object_init_region_2)
    (On bbq_sauce_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (On milk_1 plate_1))
  )

)
