(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the akita_black_bowl belonging to user_001 and place it in the basket)
    (:regions
      (basket_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.2198 0.0559 0.2698 0.1059)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (0.0038 0.2193 0.0538 0.2693)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.2129 0.0911 -0.1629 0.1411)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (-0.0484 -0.224 0.0016 -0.174)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    living_room_table - table
    basket_1 - basket
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    cream_cheese_1 - cream_cheese
    milk_1 - milk
    white_yellow_mug_1 - white_yellow_mug
  )

  (:obj_of_interest
    akita_black_bowl_1
  )

  (:init
    (On basket_1 living_room_table_basket_region)
    (On akita_black_bowl_1 living_room_table_object_init_region_0)
    (On cream_cheese_1 living_room_table_object_init_region_1)
    (On milk_1 living_room_table_object_init_region_2)
    (On white_yellow_mug_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (In akita_black_bowl_1 basket_1_contain_region))
  )

)
