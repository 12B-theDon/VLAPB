(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the akita_black_bowl belonging to user_001 and place it on the flat_stove)
    (:regions
      (flat_stove_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1898 0.1099 0.2398 0.1599)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.144 0.1645 -0.094 0.2145)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.1919 -0.1299 -0.1419 -0.0799)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.1039 -0.2302 0.1539 -0.1802)
            )
          )
      )
      (cook_region
          (:target flat_stove_1)
      )
    )

  (:fixtures
    kitchen_table - table
    flat_stove_1 - flat_stove
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    milk_1 - milk
    porcelain_mug_1 - porcelain_mug
  )

  (:obj_of_interest
    akita_black_bowl_1
  )

  (:init
    (On flat_stove_1 kitchen_table_flat_stove_region)
    (On akita_black_bowl_1 kitchen_table_object_init_region_0)
    (On glazed_rim_porcelain_ramekin_1 kitchen_table_object_init_region_1)
    (On milk_1 kitchen_table_object_init_region_2)
    (On porcelain_mug_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (On akita_black_bowl_1 flat_stove_1_cook_region))
  )

)
