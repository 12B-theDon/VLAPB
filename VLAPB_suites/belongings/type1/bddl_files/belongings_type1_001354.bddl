(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the akita_black_bowl belonging to user_001 and place it in the wooden_tray)
    (:regions
      (wooden_tray_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1626 0.0907 0.2126 0.1407)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.1569 0.189 -0.1069 0.239)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.209 -0.1385 -0.159 -0.0885)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.0953 -0.2201 0.1453 -0.1701)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    living_room_table - table
    wooden_tray_1 - wooden_tray
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    milk_1 - milk
    new_salad_dressing_1 - new_salad_dressing
    salad_dressing_1 - salad_dressing
  )

  (:obj_of_interest
    akita_black_bowl_1
  )

  (:init
    (On wooden_tray_1 living_room_table_wooden_tray_region)
    (On akita_black_bowl_1 living_room_table_object_init_region_0)
    (On milk_1 living_room_table_object_init_region_1)
    (On new_salad_dressing_1 living_room_table_object_init_region_2)
    (On salad_dressing_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (In akita_black_bowl_1 wooden_tray_1_contain_region))
  )

)
