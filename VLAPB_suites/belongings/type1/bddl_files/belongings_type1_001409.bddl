(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the akita_black_bowl belonging to user_001 and place it in the basket)
    (:regions
      (basket_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1911 0.1014 0.2411 0.1514)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.0462 0.2019 0.0038 0.2519)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.2108 0.0414 -0.1608 0.0914)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (-0.0065 -0.2236 0.0435 -0.1736)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    living_room_table - table
    basket_1 - basket
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    milk_1 - milk
    porcelain_mug_1 - porcelain_mug
    tomato_sauce_1 - tomato_sauce
  )

  (:obj_of_interest
    akita_black_bowl_1
  )

  (:init
    (On basket_1 living_room_table_basket_region)
    (On akita_black_bowl_1 living_room_table_object_init_region_0)
    (On milk_1 living_room_table_object_init_region_1)
    (On porcelain_mug_1 living_room_table_object_init_region_2)
    (On tomato_sauce_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (In akita_black_bowl_1 basket_1_contain_region))
  )

)
