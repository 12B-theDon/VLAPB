(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the akita_black_bowl belonging to user_001 and place it in the basket)
    (:regions
      (basket_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1882 0.0862 0.2382 0.1362)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.035 0.2013 0.015 0.2513)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.211 0.0519 -0.161 0.1019)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (-0.0155 -0.2386 0.0345 -0.1886)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    kitchen_table - table
    basket_1 - basket
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    milk_1 - milk
    tomato_sauce_1 - tomato_sauce
    white_yellow_mug_1 - white_yellow_mug
  )

  (:obj_of_interest
    akita_black_bowl_1
  )

  (:init
    (On basket_1 kitchen_table_basket_region)
    (On akita_black_bowl_1 kitchen_table_object_init_region_0)
    (On milk_1 kitchen_table_object_init_region_1)
    (On tomato_sauce_1 kitchen_table_object_init_region_2)
    (On white_yellow_mug_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (In akita_black_bowl_1 basket_1_contain_region))
  )

)
