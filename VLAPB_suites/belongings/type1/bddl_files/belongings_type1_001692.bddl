(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the akita_black_bowl belonging to user_001 and place it on the plate)
    (:regions
      (plate_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1704 0.083 0.2204 0.133)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.1283 0.1618 -0.0783 0.2118)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.2106 -0.1276 -0.1606 -0.0776)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.0834 -0.221 0.1334 -0.171)
            )
          )
      )
      (top_region
          (:target plate_1)
      )
    )

  (:fixtures
    living_room_table - table
    plate_1 - plate
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    porcelain_mug_1 - porcelain_mug
    red_coffee_mug_1 - red_coffee_mug
    white_bowl_1 - white_bowl
  )

  (:obj_of_interest
    akita_black_bowl_1
  )

  (:init
    (On plate_1 living_room_table_plate_region)
    (On akita_black_bowl_1 living_room_table_object_init_region_0)
    (On porcelain_mug_1 living_room_table_object_init_region_1)
    (On red_coffee_mug_1 living_room_table_object_init_region_2)
    (On white_bowl_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (On akita_black_bowl_1 plate_1))
  )

)
