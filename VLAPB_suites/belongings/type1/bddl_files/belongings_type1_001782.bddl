(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the akita_black_bowl belonging to user_001 and place it in the wooden_tray)
    (:regions
      (wooden_tray_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1417 0.0977 0.1917 0.1477)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.1456 0.1388 -0.0956 0.1888)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.2006 -0.1543 -0.1506 -0.1043)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.1036 -0.1997 0.1536 -0.1497)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    living_room_table - table
    wooden_tray_1 - wooden_tray
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    salad_dressing_1 - salad_dressing
    tomato_sauce_1 - tomato_sauce
    white_bowl_1 - white_bowl
  )

  (:obj_of_interest
    akita_black_bowl_1
  )

  (:init
    (On wooden_tray_1 living_room_table_wooden_tray_region)
    (On akita_black_bowl_1 living_room_table_object_init_region_0)
    (On salad_dressing_1 living_room_table_object_init_region_1)
    (On tomato_sauce_1 living_room_table_object_init_region_2)
    (On white_bowl_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (In akita_black_bowl_1 wooden_tray_1_contain_region))
  )

)
