(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the alphabet_soup belonging to user_001 and place it on the flat_stove)
    (:regions
      (flat_stove_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1617 0.1249 0.2117 0.1749)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.1668 0.1515 -0.1168 0.2015)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.2131 -0.1761 -0.1631 -0.1261)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.1106 -0.1938 0.1606 -0.1438)
            )
          )
      )
      (cook_region
          (:target flat_stove_1)
      )
    )

  (:fixtures
    kitchen_table - table
    flat_stove_1 - flat_stove
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    chocolate_pudding_1 - chocolate_pudding
    cream_cheese_1 - cream_cheese
    orange_juice_1 - orange_juice
  )

  (:obj_of_interest
    alphabet_soup_1
  )

  (:init
    (On flat_stove_1 kitchen_table_flat_stove_region)
    (On alphabet_soup_1 kitchen_table_object_init_region_0)
    (On chocolate_pudding_1 kitchen_table_object_init_region_1)
    (On cream_cheese_1 kitchen_table_object_init_region_2)
    (On orange_juice_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (On alphabet_soup_1 flat_stove_1_cook_region))
  )

)
