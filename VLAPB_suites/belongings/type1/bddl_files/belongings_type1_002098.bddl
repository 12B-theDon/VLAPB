(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the alphabet_soup belonging to user_001 and place it in the wooden_tray)
    (:regions
      (wooden_tray_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1586 0.0837 0.2086 0.1337)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.1306 0.1533 -0.0806 0.2033)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.2147 -0.1373 -0.1647 -0.0873)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.0799 -0.2022 0.1299 -0.1522)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    living_room_table - table
    wooden_tray_1 - wooden_tray
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    chocolate_pudding_1 - chocolate_pudding
    orange_juice_1 - orange_juice
    wine_bottle_1 - wine_bottle
  )

  (:obj_of_interest
    alphabet_soup_1
  )

  (:init
    (On wooden_tray_1 living_room_table_wooden_tray_region)
    (On alphabet_soup_1 living_room_table_object_init_region_0)
    (On chocolate_pudding_1 living_room_table_object_init_region_1)
    (On orange_juice_1 living_room_table_object_init_region_2)
    (On wine_bottle_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (In alphabet_soup_1 wooden_tray_1_contain_region))
  )

)
