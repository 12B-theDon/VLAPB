(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the alphabet_soup belonging to user_001 and place it on the flat_stove)
    (:regions
      (flat_stove_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1464 0.1123 0.1964 0.1623)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.1734 0.1602 -0.1234 0.2102)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.2139 -0.1764 -0.1639 -0.1264)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.1313 -0.2201 0.1813 -0.1701)
            )
          )
      )
      (cook_region
          (:target flat_stove_1)
      )
    )

  (:fixtures
    living_room_table - table
    flat_stove_1 - flat_stove
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    cookies_1 - cookies
    milk_1 - milk
    new_salad_dressing_1 - new_salad_dressing
  )

  (:obj_of_interest
    alphabet_soup_1
  )

  (:init
    (On flat_stove_1 living_room_table_flat_stove_region)
    (On alphabet_soup_1 living_room_table_object_init_region_0)
    (On cookies_1 living_room_table_object_init_region_1)
    (On milk_1 living_room_table_object_init_region_2)
    (On new_salad_dressing_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (On alphabet_soup_1 flat_stove_1_cook_region))
  )

)
