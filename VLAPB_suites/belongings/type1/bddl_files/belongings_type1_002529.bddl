(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the alphabet_soup belonging to user_001 and place it in the basket)
    (:regions
      (basket_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1734 0.0651 0.2234 0.1151)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.0225 0.2254 0.0275 0.2754)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.2543 0.0847 -0.2043 0.1347)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (-0.027 -0.2271 0.023 -0.1771)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    kitchen_table - table
    basket_1 - basket
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    cream_cheese_1 - cream_cheese
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    white_bowl_1 - white_bowl
  )

  (:obj_of_interest
    alphabet_soup_1
  )

  (:init
    (On basket_1 kitchen_table_basket_region)
    (On alphabet_soup_1 kitchen_table_object_init_region_0)
    (On cream_cheese_1 kitchen_table_object_init_region_1)
    (On glazed_rim_porcelain_ramekin_1 kitchen_table_object_init_region_2)
    (On white_bowl_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (In alphabet_soup_1 basket_1_contain_region))
  )

)
