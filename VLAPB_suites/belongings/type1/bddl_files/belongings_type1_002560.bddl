(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the alphabet_soup belonging to user_001 and place it on the plate)
    (:regions
      (plate_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1845 0.1166 0.2345 0.1666)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.1682 0.1868 -0.1182 0.2368)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.2162 -0.1542 -0.1662 -0.1042)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.1037 -0.2155 0.1537 -0.1655)
            )
          )
      )
      (top_region
          (:target plate_1)
      )
    )

  (:fixtures
    living_room_table - table
    plate_1 - plate
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    cream_cheese_1 - cream_cheese
    ketchup_1 - ketchup
    red_coffee_mug_1 - red_coffee_mug
  )

  (:obj_of_interest
    alphabet_soup_1
  )

  (:init
    (On plate_1 living_room_table_plate_region)
    (On alphabet_soup_1 living_room_table_object_init_region_0)
    (On cream_cheese_1 living_room_table_object_init_region_1)
    (On ketchup_1 living_room_table_object_init_region_2)
    (On red_coffee_mug_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (On alphabet_soup_1 plate_1))
  )

)
