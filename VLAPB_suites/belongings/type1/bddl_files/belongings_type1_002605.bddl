(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the alphabet_soup belonging to user_001 and place it in the basket)
    (:regions
      (basket_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1714 0.0531 0.2214 0.1031)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.0134 0.1757 0.0366 0.2257)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.241 0.0913 -0.191 0.1413)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (-0.039 -0.2666 0.011 -0.2166)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    kitchen_table - table
    basket_1 - basket
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    cream_cheese_1 - cream_cheese
    milk_1 - milk
    white_bowl_1 - white_bowl
  )

  (:obj_of_interest
    alphabet_soup_1
  )

  (:init
    (On basket_1 kitchen_table_basket_region)
    (On alphabet_soup_1 kitchen_table_object_init_region_0)
    (On cream_cheese_1 kitchen_table_object_init_region_1)
    (On milk_1 kitchen_table_object_init_region_2)
    (On white_bowl_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (In alphabet_soup_1 basket_1_contain_region))
  )

)
