(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the alphabet_soup belonging to user_001 and place it on the flat_stove)
    (:regions
      (flat_stove_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1692 0.1347 0.2192 0.1847)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.188 0.1732 -0.138 0.2232)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.2199 -0.1853 -0.1699 -0.1353)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.1384 -0.2237 0.1884 -0.1737)
            )
          )
      )
      (cook_region
          (:target flat_stove_1)
      )
    )

  (:fixtures
    kitchen_table - table
    flat_stove_1 - flat_stove
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    ketchup_1 - ketchup
    wine_bottle_1 - wine_bottle
  )

  (:obj_of_interest
    alphabet_soup_1
  )

  (:init
    (On flat_stove_1 kitchen_table_flat_stove_region)
    (On alphabet_soup_1 kitchen_table_object_init_region_0)
    (On glazed_rim_porcelain_ramekin_1 kitchen_table_object_init_region_1)
    (On ketchup_1 kitchen_table_object_init_region_2)
    (On wine_bottle_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (On alphabet_soup_1 flat_stove_1_cook_region))
  )

)
