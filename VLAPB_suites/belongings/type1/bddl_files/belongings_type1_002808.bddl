(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the alphabet_soup belonging to user_001 and place it on the plate)
    (:regions
      (plate_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1897 0.0769 0.2397 0.1269)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.1358 0.2085 -0.0858 0.2585)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.208 -0.1119 -0.158 -0.0619)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.0652 -0.215 0.1152 -0.165)
            )
          )
      )
      (top_region
          (:target plate_1)
      )
    )

  (:fixtures
    kitchen_table - table
    plate_1 - plate
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    milk_1 - milk
    orange_juice_1 - orange_juice
  )

  (:obj_of_interest
    alphabet_soup_1
  )

  (:init
    (On plate_1 kitchen_table_plate_region)
    (On alphabet_soup_1 kitchen_table_object_init_region_0)
    (On glazed_rim_porcelain_ramekin_1 kitchen_table_object_init_region_1)
    (On milk_1 kitchen_table_object_init_region_2)
    (On orange_juice_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (On alphabet_soup_1 plate_1))
  )

)
