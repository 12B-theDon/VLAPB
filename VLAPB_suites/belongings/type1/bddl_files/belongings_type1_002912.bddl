(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the alphabet_soup belonging to user_001 and place it on the plate)
    (:regions
      (plate_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1581 0.0979 0.2081 0.1479)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.1468 0.1564 -0.0968 0.2064)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.2272 -0.1607 -0.1772 -0.1107)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.1181 -0.2382 0.1681 -0.1882)
            )
          )
      )
      (top_region
          (:target plate_1)
      )
    )

  (:fixtures
    kitchen_table - table
    plate_1 - plate
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    porcelain_mug_1 - porcelain_mug
    white_bowl_1 - white_bowl
  )

  (:obj_of_interest
    alphabet_soup_1
  )

  (:init
    (On plate_1 kitchen_table_plate_region)
    (On alphabet_soup_1 kitchen_table_object_init_region_0)
    (On glazed_rim_porcelain_ramekin_1 kitchen_table_object_init_region_1)
    (On porcelain_mug_1 kitchen_table_object_init_region_2)
    (On white_bowl_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (On alphabet_soup_1 plate_1))
  )

)
