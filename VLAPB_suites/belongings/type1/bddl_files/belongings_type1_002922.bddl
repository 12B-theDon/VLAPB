(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the alphabet_soup belonging to user_001 and place it in the wooden_tray)
    (:regions
      (wooden_tray_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1479 0.1253 0.1979 0.1753)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.1808 0.1542 -0.1308 0.2042)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.2036 -0.1802 -0.1536 -0.1302)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.1174 -0.1889 0.1674 -0.1389)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    living_room_table - table
    wooden_tray_1 - wooden_tray
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    red_coffee_mug_1 - red_coffee_mug
    salad_dressing_1 - salad_dressing
  )

  (:obj_of_interest
    alphabet_soup_1
  )

  (:init
    (On wooden_tray_1 living_room_table_wooden_tray_region)
    (On alphabet_soup_1 living_room_table_object_init_region_0)
    (On glazed_rim_porcelain_ramekin_1 living_room_table_object_init_region_1)
    (On red_coffee_mug_1 living_room_table_object_init_region_2)
    (On salad_dressing_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (In alphabet_soup_1 wooden_tray_1_contain_region))
  )

)
