(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the alphabet_soup belonging to user_001 and place it on the plate)
    (:regions
      (plate_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1668 0.1122 0.2168 0.1622)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.1418 0.1383 -0.0918 0.1883)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.2 -0.1502 -0.15 -0.1002)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.1188 -0.226 0.1688 -0.176)
            )
          )
      )
      (top_region
          (:target plate_1)
      )
    )

  (:fixtures
    kitchen_table - table
    plate_1 - plate
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    ketchup_1 - ketchup
    white_bowl_1 - white_bowl
    wine_bottle_1 - wine_bottle
  )

  (:obj_of_interest
    alphabet_soup_1
  )

  (:init
    (On plate_1 kitchen_table_plate_region)
    (On alphabet_soup_1 kitchen_table_object_init_region_0)
    (On ketchup_1 kitchen_table_object_init_region_1)
    (On white_bowl_1 kitchen_table_object_init_region_2)
    (On wine_bottle_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (On alphabet_soup_1 plate_1))
  )

)
