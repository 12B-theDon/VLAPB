(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the alphabet_soup belonging to user_001 and place it on the flat_stove)
    (:regions
      (flat_stove_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1447 0.1437 0.1947 0.1937)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.174 0.1249 -0.124 0.1749)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.1782 -0.1773 -0.1282 -0.1273)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.1395 -0.1905 0.1895 -0.1405)
            )
          )
      )
      (cook_region
          (:target flat_stove_1)
      )
    )

  (:fixtures
    living_room_table - table
    flat_stove_1 - flat_stove
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    milk_1 - milk
    new_salad_dressing_1 - new_salad_dressing
    wine_bottle_1 - wine_bottle
  )

  (:obj_of_interest
    alphabet_soup_1
  )

  (:init
    (On flat_stove_1 living_room_table_flat_stove_region)
    (On alphabet_soup_1 living_room_table_object_init_region_0)
    (On milk_1 living_room_table_object_init_region_1)
    (On new_salad_dressing_1 living_room_table_object_init_region_2)
    (On wine_bottle_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (On alphabet_soup_1 flat_stove_1_cook_region))
  )

)
