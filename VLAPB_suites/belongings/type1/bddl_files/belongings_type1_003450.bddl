(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the alphabet_soup belonging to user_001 and place it in the wooden_tray)
    (:regions
      (wooden_tray_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1897 0.1168 0.2397 0.1668)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.1476 0.1607 -0.0976 0.2107)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.1951 -0.1373 -0.1451 -0.0873)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.115 -0.237 0.165 -0.187)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    living_room_table - table
    wooden_tray_1 - wooden_tray
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    orange_juice_1 - orange_juice
    red_coffee_mug_1 - red_coffee_mug
    white_bowl_1 - white_bowl
  )

  (:obj_of_interest
    alphabet_soup_1
  )

  (:init
    (On wooden_tray_1 living_room_table_wooden_tray_region)
    (On alphabet_soup_1 living_room_table_object_init_region_0)
    (On orange_juice_1 living_room_table_object_init_region_1)
    (On red_coffee_mug_1 living_room_table_object_init_region_2)
    (On white_bowl_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (In alphabet_soup_1 wooden_tray_1_contain_region))
  )

)
