(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the alphabet_soup belonging to user_001 and place it on the plate)
    (:regions
      (plate_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1421 0.1035 0.1921 0.1535)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.1743 0.1691 -0.1243 0.2191)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.2052 -0.1636 -0.1552 -0.1136)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.1173 -0.21 0.1673 -0.16)
            )
          )
      )
      (top_region
          (:target plate_1)
      )
    )

  (:fixtures
    kitchen_table - table
    plate_1 - plate
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    porcelain_mug_1 - porcelain_mug
    salad_dressing_1 - salad_dressing
    white_yellow_mug_1 - white_yellow_mug
  )

  (:obj_of_interest
    alphabet_soup_1
  )

  (:init
    (On plate_1 kitchen_table_plate_region)
    (On alphabet_soup_1 kitchen_table_object_init_region_0)
    (On porcelain_mug_1 kitchen_table_object_init_region_1)
    (On salad_dressing_1 kitchen_table_object_init_region_2)
    (On white_yellow_mug_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (On alphabet_soup_1 plate_1))
  )

)
