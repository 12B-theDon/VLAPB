(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the alphabet_soup belonging to user_001 and place it in the basket)
    (:regions
      (basket_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1649 0.0687 0.2149 0.1187)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.0298 0.1941 0.0202 0.2441)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.2069 0.055 -0.1569 0.105)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (-0.0205 -0.2298 0.0295 -0.1798)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    kitchen_table - table
    basket_1 - basket
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    porcelain_mug_1 - porcelain_mug
    tomato_sauce_1 - tomato_sauce
    white_yellow_mug_1 - white_yellow_mug
  )

  (:obj_of_interest
    alphabet_soup_1
  )

  (:init
    (On basket_1 kitchen_table_basket_region)
    (On alphabet_soup_1 kitchen_table_object_init_region_0)
    (On porcelain_mug_1 kitchen_table_object_init_region_1)
    (On tomato_sauce_1 kitchen_table_object_init_region_2)
    (On white_yellow_mug_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (In alphabet_soup_1 basket_1_contain_region))
  )

)
