(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the bbq_sauce belonging to user_001 and place it in the basket)
    (:regions
      (basket_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1751 0.0439 0.2251 0.0939)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.003 0.1836 0.047 0.2336)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.2227 0.0938 -0.1727 0.1438)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (-0.0517 -0.2783 -0.0017 -0.2283)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    living_room_table - table
    basket_1 - basket
  )

  (:objects
    bbq_sauce_1 - bbq_sauce
    chocolate_pudding_1 - chocolate_pudding
    cream_cheese_1 - cream_cheese
    new_salad_dressing_1 - new_salad_dressing
  )

  (:obj_of_interest
    bbq_sauce_1
  )

  (:init
    (On basket_1 living_room_table_basket_region)
    (On bbq_sauce_1 living_room_table_object_init_region_0)
    (On chocolate_pudding_1 living_room_table_object_init_region_1)
    (On cream_cheese_1 living_room_table_object_init_region_2)
    (On new_salad_dressing_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (In bbq_sauce_1 basket_1_contain_region))
  )

)
