(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the bbq_sauce belonging to user_001 and place it in the basket)
    (:regions
      (basket_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1766 0.0941 0.2266 0.1441)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.0478 0.2091 0.0022 0.2591)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.2314 0.0478 -0.1814 0.0978)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (-0.0013 -0.2681 0.0487 -0.2181)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    kitchen_table - table
    basket_1 - basket
  )

  (:objects
    bbq_sauce_1 - bbq_sauce
    chocolate_pudding_1 - chocolate_pudding
    cream_cheese_1 - cream_cheese
    porcelain_mug_1 - porcelain_mug
  )

  (:obj_of_interest
    bbq_sauce_1
  )

  (:init
    (On basket_1 kitchen_table_basket_region)
    (On bbq_sauce_1 kitchen_table_object_init_region_0)
    (On chocolate_pudding_1 kitchen_table_object_init_region_1)
    (On cream_cheese_1 kitchen_table_object_init_region_2)
    (On porcelain_mug_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (In bbq_sauce_1 basket_1_contain_region))
  )

)
