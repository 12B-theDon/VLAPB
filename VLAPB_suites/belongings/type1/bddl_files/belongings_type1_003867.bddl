(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the bbq_sauce belonging to user_001 and place it on the flat_stove)
    (:regions
      (flat_stove_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1753 0.0877 0.2253 0.1377)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.1386 0.1769 -0.0886 0.2269)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.2291 -0.1399 -0.1791 -0.0899)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.0898 -0.2289 0.1398 -0.1789)
            )
          )
      )
      (cook_region
          (:target flat_stove_1)
      )
    )

  (:fixtures
    kitchen_table - table
    flat_stove_1 - flat_stove
  )

  (:objects
    bbq_sauce_1 - bbq_sauce
    chocolate_pudding_1 - chocolate_pudding
    new_salad_dressing_1 - new_salad_dressing
    porcelain_mug_1 - porcelain_mug
  )

  (:obj_of_interest
    bbq_sauce_1
  )

  (:init
    (On flat_stove_1 kitchen_table_flat_stove_region)
    (On bbq_sauce_1 kitchen_table_object_init_region_0)
    (On chocolate_pudding_1 kitchen_table_object_init_region_1)
    (On new_salad_dressing_1 kitchen_table_object_init_region_2)
    (On porcelain_mug_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (On bbq_sauce_1 flat_stove_1_cook_region))
  )

)
