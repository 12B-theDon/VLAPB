(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the bbq_sauce belonging to user_001 and place it in the wooden_tray)
    (:regions
      (wooden_tray_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1638 0.1114 0.2138 0.1614)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.1692 0.1745 -0.1192 0.2245)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.2223 -0.1676 -0.1723 -0.1176)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.11 -0.2119 0.16 -0.1619)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    kitchen_table - table
    wooden_tray_1 - wooden_tray
  )

  (:objects
    bbq_sauce_1 - bbq_sauce
    cookies_1 - cookies
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    ketchup_1 - ketchup
  )

  (:obj_of_interest
    bbq_sauce_1
  )

  (:init
    (On wooden_tray_1 kitchen_table_wooden_tray_region)
    (On bbq_sauce_1 kitchen_table_object_init_region_0)
    (On cookies_1 kitchen_table_object_init_region_1)
    (On glazed_rim_porcelain_ramekin_1 kitchen_table_object_init_region_2)
    (On ketchup_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (In bbq_sauce_1 wooden_tray_1_contain_region))
  )

)
