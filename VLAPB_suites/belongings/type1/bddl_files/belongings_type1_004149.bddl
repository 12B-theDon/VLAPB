(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the bbq_sauce belonging to user_001 and place it in the basket)
    (:regions
      (basket_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1512 0.0876 0.2012 0.1376)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.0566 0.2124 -0.0066 0.2624)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.2469 0.0446 -0.1969 0.0946)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.0046 -0.2473 0.0546 -0.1973)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    kitchen_table - table
    basket_1 - basket
  )

  (:objects
    bbq_sauce_1 - bbq_sauce
    cookies_1 - cookies
    milk_1 - milk
    red_coffee_mug_1 - red_coffee_mug
  )

  (:obj_of_interest
    bbq_sauce_1
  )

  (:init
    (On basket_1 kitchen_table_basket_region)
    (On bbq_sauce_1 kitchen_table_object_init_region_0)
    (On cookies_1 kitchen_table_object_init_region_1)
    (On milk_1 kitchen_table_object_init_region_2)
    (On red_coffee_mug_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (In bbq_sauce_1 basket_1_contain_region))
  )

)
