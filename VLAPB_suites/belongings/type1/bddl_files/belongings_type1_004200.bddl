(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the bbq_sauce belonging to user_001 and place it on the plate)
    (:regions
      (plate_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1599 0.1545 0.2099 0.2045)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.1818 0.1366 -0.1318 0.1866)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.1832 -0.1785 -0.1332 -0.1285)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.1308 -0.1856 0.1808 -0.1356)
            )
          )
      )
      (top_region
          (:target plate_1)
      )
    )

  (:fixtures
    kitchen_table - table
    plate_1 - plate
  )

  (:objects
    bbq_sauce_1 - bbq_sauce
    cookies_1 - cookies
    new_salad_dressing_1 - new_salad_dressing
    white_yellow_mug_1 - white_yellow_mug
  )

  (:obj_of_interest
    bbq_sauce_1
  )

  (:init
    (On plate_1 kitchen_table_plate_region)
    (On bbq_sauce_1 kitchen_table_object_init_region_0)
    (On cookies_1 kitchen_table_object_init_region_1)
    (On new_salad_dressing_1 kitchen_table_object_init_region_2)
    (On white_yellow_mug_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (On bbq_sauce_1 plate_1))
  )

)
