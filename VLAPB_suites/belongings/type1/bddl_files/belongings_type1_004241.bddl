(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the bbq_sauce belonging to user_001 and place it in the basket)
    (:regions
      (basket_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1742 0.0883 0.2242 0.1383)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.0456 0.2298 0.0044 0.2798)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.265 0.0641 -0.215 0.1141)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (-0.0057 -0.264 0.0443 -0.214)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    kitchen_table - table
    basket_1 - basket
  )

  (:objects
    bbq_sauce_1 - bbq_sauce
    cookies_1 - cookies
    porcelain_mug_1 - porcelain_mug
    tomato_sauce_1 - tomato_sauce
  )

  (:obj_of_interest
    bbq_sauce_1
  )

  (:init
    (On basket_1 kitchen_table_basket_region)
    (On bbq_sauce_1 kitchen_table_object_init_region_0)
    (On cookies_1 kitchen_table_object_init_region_1)
    (On porcelain_mug_1 kitchen_table_object_init_region_2)
    (On tomato_sauce_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (In bbq_sauce_1 basket_1_contain_region))
  )

)
