(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the bbq_sauce belonging to user_001 and place it on the plate)
    (:regions
      (plate_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.137 0.0873 0.187 0.1373)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.1436 0.1461 -0.0936 0.1961)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.2004 -0.1465 -0.1504 -0.0965)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.093 -0.1953 0.143 -0.1453)
            )
          )
      )
      (top_region
          (:target plate_1)
      )
    )

  (:fixtures
    kitchen_table - table
    plate_1 - plate
  )

  (:objects
    bbq_sauce_1 - bbq_sauce
    cream_cheese_1 - cream_cheese
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    new_salad_dressing_1 - new_salad_dressing
  )

  (:obj_of_interest
    bbq_sauce_1
  )

  (:init
    (On plate_1 kitchen_table_plate_region)
    (On bbq_sauce_1 kitchen_table_object_init_region_0)
    (On cream_cheese_1 kitchen_table_object_init_region_1)
    (On glazed_rim_porcelain_ramekin_1 kitchen_table_object_init_region_2)
    (On new_salad_dressing_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (On bbq_sauce_1 plate_1))
  )

)
