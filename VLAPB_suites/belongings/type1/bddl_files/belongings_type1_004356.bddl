(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the bbq_sauce belonging to user_001 and place it on the plate)
    (:regions
      (plate_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.147 0.1158 0.197 0.1658)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.177 0.1607 -0.127 0.2107)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.2068 -0.1738 -0.1568 -0.1238)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.123 -0.2058 0.173 -0.1558)
            )
          )
      )
      (top_region
          (:target plate_1)
      )
    )

  (:fixtures
    living_room_table - table
    plate_1 - plate
  )

  (:objects
    bbq_sauce_1 - bbq_sauce
    cream_cheese_1 - cream_cheese
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    white_yellow_mug_1 - white_yellow_mug
  )

  (:obj_of_interest
    bbq_sauce_1
  )

  (:init
    (On plate_1 living_room_table_plate_region)
    (On bbq_sauce_1 living_room_table_object_init_region_0)
    (On cream_cheese_1 living_room_table_object_init_region_1)
    (On glazed_rim_porcelain_ramekin_1 living_room_table_object_init_region_2)
    (On white_yellow_mug_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (On bbq_sauce_1 plate_1))
  )

)
