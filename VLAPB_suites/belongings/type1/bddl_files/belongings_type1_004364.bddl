(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the bbq_sauce belonging to user_001 and place it on the plate)
    (:regions
      (plate_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1902 0.0749 0.2402 0.1249)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.132 0.2055 -0.082 0.2555)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.244 -0.1267 -0.194 -0.0767)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.0615 -0.2112 0.1115 -0.1612)
            )
          )
      )
      (top_region
          (:target plate_1)
      )
    )

  (:fixtures
    kitchen_table - table
    plate_1 - plate
  )

  (:objects
    bbq_sauce_1 - bbq_sauce
    cream_cheese_1 - cream_cheese
    ketchup_1 - ketchup
    milk_1 - milk
  )

  (:obj_of_interest
    bbq_sauce_1
  )

  (:init
    (On plate_1 kitchen_table_plate_region)
    (On bbq_sauce_1 kitchen_table_object_init_region_0)
    (On cream_cheese_1 kitchen_table_object_init_region_1)
    (On ketchup_1 kitchen_table_object_init_region_2)
    (On milk_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (On bbq_sauce_1 plate_1))
  )

)
