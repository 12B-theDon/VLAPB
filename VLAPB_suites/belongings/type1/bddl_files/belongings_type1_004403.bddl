(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the bbq_sauce belonging to user_001 and place it on the flat_stove)
    (:regions
      (flat_stove_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1736 0.1237 0.2236 0.1737)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.1709 0.1699 -0.1209 0.2199)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.2 -0.156 -0.15 -0.106)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.1177 -0.2156 0.1677 -0.1656)
            )
          )
      )
      (cook_region
          (:target flat_stove_1)
      )
    )

  (:fixtures
    kitchen_table - table
    flat_stove_1 - flat_stove
  )

  (:objects
    bbq_sauce_1 - bbq_sauce
    cream_cheese_1 - cream_cheese
    milk_1 - milk
    new_salad_dressing_1 - new_salad_dressing
  )

  (:obj_of_interest
    bbq_sauce_1
  )

  (:init
    (On flat_stove_1 kitchen_table_flat_stove_region)
    (On bbq_sauce_1 kitchen_table_object_init_region_0)
    (On cream_cheese_1 kitchen_table_object_init_region_1)
    (On milk_1 kitchen_table_object_init_region_2)
    (On new_salad_dressing_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (On bbq_sauce_1 flat_stove_1_cook_region))
  )

)
