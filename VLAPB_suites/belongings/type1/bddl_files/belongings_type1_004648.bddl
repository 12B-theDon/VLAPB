(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the bbq_sauce belonging to user_001 and place it on the plate)
    (:regions
      (plate_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1392 0.0954 0.1892 0.1454)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.1691 0.1715 -0.1191 0.2215)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.1999 -0.1533 -0.1499 -0.1033)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.0985 -0.1934 0.1485 -0.1434)
            )
          )
      )
      (top_region
          (:target plate_1)
      )
    )

  (:fixtures
    living_room_table - table
    plate_1 - plate
  )

  (:objects
    bbq_sauce_1 - bbq_sauce
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    milk_1 - milk
    white_bowl_1 - white_bowl
  )

  (:obj_of_interest
    bbq_sauce_1
  )

  (:init
    (On plate_1 living_room_table_plate_region)
    (On bbq_sauce_1 living_room_table_object_init_region_0)
    (On glazed_rim_porcelain_ramekin_1 living_room_table_object_init_region_1)
    (On milk_1 living_room_table_object_init_region_2)
    (On white_bowl_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (On bbq_sauce_1 plate_1))
  )

)
