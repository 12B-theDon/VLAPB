(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the bbq_sauce belonging to user_001 and place it in the wooden_tray)
    (:regions
      (wooden_tray_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1774 0.1057 0.2274 0.1557)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.1427 0.1573 -0.0927 0.2073)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.2342 -0.1601 -0.1842 -0.1101)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.0901 -0.2032 0.1401 -0.1532)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    kitchen_table - table
    wooden_tray_1 - wooden_tray
  )

  (:objects
    bbq_sauce_1 - bbq_sauce
    milk_1 - milk
    new_salad_dressing_1 - new_salad_dressing
    white_bowl_1 - white_bowl
  )

  (:obj_of_interest
    bbq_sauce_1
  )

  (:init
    (On wooden_tray_1 kitchen_table_wooden_tray_region)
    (On bbq_sauce_1 kitchen_table_object_init_region_0)
    (On milk_1 kitchen_table_object_init_region_1)
    (On new_salad_dressing_1 kitchen_table_object_init_region_2)
    (On white_bowl_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (In bbq_sauce_1 wooden_tray_1_contain_region))
  )

)
