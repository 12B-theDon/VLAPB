(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the bbq_sauce belonging to user_001 and place it on the plate)
    (:regions
      (plate_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1864 0.1174 0.2364 0.1674)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.1475 0.157 -0.0975 0.207)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.1968 -0.1407 -0.1468 -0.0907)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.1099 -0.2253 0.1599 -0.1753)
            )
          )
      )
      (top_region
          (:target plate_1)
      )
    )

  (:fixtures
    kitchen_table - table
    plate_1 - plate
  )

  (:objects
    bbq_sauce_1 - bbq_sauce
    milk_1 - milk
    salad_dressing_1 - salad_dressing
    white_bowl_1 - white_bowl
  )

  (:obj_of_interest
    bbq_sauce_1
  )

  (:init
    (On plate_1 kitchen_table_plate_region)
    (On bbq_sauce_1 kitchen_table_object_init_region_0)
    (On milk_1 kitchen_table_object_init_region_1)
    (On salad_dressing_1 kitchen_table_object_init_region_2)
    (On white_bowl_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (On bbq_sauce_1 plate_1))
  )

)
