(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the bbq_sauce belonging to user_001 and place it in the wooden_tray)
    (:regions
      (wooden_tray_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1397 0.129 0.1897 0.179)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.1683 0.1283 -0.1183 0.1783)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.2 -0.1886 -0.15 -0.1386)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.1121 -0.1717 0.1621 -0.1217)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    kitchen_table - table
    wooden_tray_1 - wooden_tray
  )

  (:objects
    bbq_sauce_1 - bbq_sauce
    new_salad_dressing_1 - new_salad_dressing
    salad_dressing_1 - salad_dressing
    white_yellow_mug_1 - white_yellow_mug
  )

  (:obj_of_interest
    bbq_sauce_1
  )

  (:init
    (On wooden_tray_1 kitchen_table_wooden_tray_region)
    (On bbq_sauce_1 kitchen_table_object_init_region_0)
    (On new_salad_dressing_1 kitchen_table_object_init_region_1)
    (On salad_dressing_1 kitchen_table_object_init_region_2)
    (On white_yellow_mug_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (In bbq_sauce_1 wooden_tray_1_contain_region))
  )

)
