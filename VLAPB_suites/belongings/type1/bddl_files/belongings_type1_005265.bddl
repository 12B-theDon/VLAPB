(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the bbq_sauce belonging to user_001 and place it in the basket)
    (:regions
      (basket_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1912 0.0712 0.2412 0.1212)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.0205 0.2282 0.0295 0.2782)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.235 0.0775 -0.185 0.1275)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (-0.0292 -0.263 0.0208 -0.213)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    living_room_table - table
    basket_1 - basket
  )

  (:objects
    bbq_sauce_1 - bbq_sauce
    orange_juice_1 - orange_juice
    red_coffee_mug_1 - red_coffee_mug
    tomato_sauce_1 - tomato_sauce
  )

  (:obj_of_interest
    bbq_sauce_1
  )

  (:init
    (On basket_1 living_room_table_basket_region)
    (On bbq_sauce_1 living_room_table_object_init_region_0)
    (On orange_juice_1 living_room_table_object_init_region_1)
    (On red_coffee_mug_1 living_room_table_object_init_region_2)
    (On tomato_sauce_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (In bbq_sauce_1 basket_1_contain_region))
  )

)
