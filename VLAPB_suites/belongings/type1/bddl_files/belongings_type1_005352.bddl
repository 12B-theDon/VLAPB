(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the bbq_sauce belonging to user_001 and place it on the plate)
    (:regions
      (plate_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1524 0.0603 0.2024 0.1103)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.1344 0.2026 -0.0844 0.2526)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.2187 -0.1181 -0.1687 -0.0681)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.0627 -0.2074 0.1127 -0.1574)
            )
          )
      )
      (top_region
          (:target plate_1)
      )
    )

  (:fixtures
    kitchen_table - table
    plate_1 - plate
  )

  (:objects
    bbq_sauce_1 - bbq_sauce
    porcelain_mug_1 - porcelain_mug
    salad_dressing_1 - salad_dressing
    white_yellow_mug_1 - white_yellow_mug
  )

  (:obj_of_interest
    bbq_sauce_1
  )

  (:init
    (On plate_1 kitchen_table_plate_region)
    (On bbq_sauce_1 kitchen_table_object_init_region_0)
    (On porcelain_mug_1 kitchen_table_object_init_region_1)
    (On salad_dressing_1 kitchen_table_object_init_region_2)
    (On white_yellow_mug_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (On bbq_sauce_1 plate_1))
  )

)
