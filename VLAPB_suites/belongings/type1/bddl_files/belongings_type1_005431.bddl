(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the bbq_sauce belonging to user_001 and place it on the flat_stove)
    (:regions
      (flat_stove_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1826 0.0951 0.2326 0.1451)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.1447 0.1819 -0.0947 0.2319)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.2186 -0.1371 -0.1686 -0.0871)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.0928 -0.2285 0.1428 -0.1785)
            )
          )
      )
      (cook_region
          (:target flat_stove_1)
      )
    )

  (:fixtures
    living_room_table - table
    flat_stove_1 - flat_stove
  )

  (:objects
    bbq_sauce_1 - bbq_sauce
    salad_dressing_1 - salad_dressing
    tomato_sauce_1 - tomato_sauce
    wine_bottle_1 - wine_bottle
  )

  (:obj_of_interest
    bbq_sauce_1
  )

  (:init
    (On flat_stove_1 living_room_table_flat_stove_region)
    (On bbq_sauce_1 living_room_table_object_init_region_0)
    (On salad_dressing_1 living_room_table_object_init_region_1)
    (On tomato_sauce_1 living_room_table_object_init_region_2)
    (On wine_bottle_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (On bbq_sauce_1 flat_stove_1_cook_region))
  )

)
