(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the butter belonging to user_001 and place it on the flat_stove)
    (:regions
      (flat_stove_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1617 0.1014 0.2117 0.1514)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.1564 0.1692 -0.1064 0.2192)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.1921 -0.1381 -0.1421 -0.0881)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.1037 -0.2153 0.1537 -0.1653)
            )
          )
      )
      (cook_region
          (:target flat_stove_1)
      )
    )

  (:fixtures
    kitchen_table - table
    flat_stove_1 - flat_stove
  )

  (:objects
    butter_1 - butter
    cookies_1 - cookies
    cream_cheese_1 - cream_cheese
    milk_1 - milk
  )

  (:obj_of_interest
    butter_1
  )

  (:init
    (On flat_stove_1 kitchen_table_flat_stove_region)
    (On butter_1 kitchen_table_object_init_region_0)
    (On cookies_1 kitchen_table_object_init_region_1)
    (On cream_cheese_1 kitchen_table_object_init_region_2)
    (On milk_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (On butter_1 flat_stove_1_cook_region))
  )

)
