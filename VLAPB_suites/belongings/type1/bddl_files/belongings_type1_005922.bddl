(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the butter belonging to user_001 and place it in the wooden_tray)
    (:regions
      (wooden_tray_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1682 0.1168 0.2182 0.1668)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.1559 0.1534 -0.1059 0.2034)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.1984 -0.1523 -0.1484 -0.1023)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.1062 -0.2037 0.1562 -0.1537)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    kitchen_table - table
    wooden_tray_1 - wooden_tray
  )

  (:objects
    butter_1 - butter
    cookies_1 - cookies
    ketchup_1 - ketchup
    new_salad_dressing_1 - new_salad_dressing
  )

  (:obj_of_interest
    butter_1
  )

  (:init
    (On wooden_tray_1 kitchen_table_wooden_tray_region)
    (On butter_1 kitchen_table_object_init_region_0)
    (On cookies_1 kitchen_table_object_init_region_1)
    (On ketchup_1 kitchen_table_object_init_region_2)
    (On new_salad_dressing_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (In butter_1 wooden_tray_1_contain_region))
  )

)
