(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the butter belonging to user_001 and place it in the basket)
    (:regions
      (basket_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.166 0.0583 0.216 0.1083)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.0196 0.1928 0.0304 0.2428)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.2141 0.069 -0.1641 0.119)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (-0.0311 -0.2715 0.0189 -0.2215)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    kitchen_table - table
    basket_1 - basket
  )

  (:objects
    butter_1 - butter
    cookies_1 - cookies
    milk_1 - milk
    salad_dressing_1 - salad_dressing
  )

  (:obj_of_interest
    butter_1
  )

  (:init
    (On basket_1 kitchen_table_basket_region)
    (On butter_1 kitchen_table_object_init_region_0)
    (On cookies_1 kitchen_table_object_init_region_1)
    (On milk_1 kitchen_table_object_init_region_2)
    (On salad_dressing_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (In butter_1 basket_1_contain_region))
  )

)
