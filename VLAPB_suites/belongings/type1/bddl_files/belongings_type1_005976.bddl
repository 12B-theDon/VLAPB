(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the butter belonging to user_001 and place it on the plate)
    (:regions
      (plate_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1643 0.0692 0.2143 0.1192)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.1215 0.1688 -0.0715 0.2188)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.2494 -0.1367 -0.1994 -0.0867)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.0775 -0.231 0.1275 -0.181)
            )
          )
      )
      (top_region
          (:target plate_1)
      )
    )

  (:fixtures
    living_room_table - table
    plate_1 - plate
  )

  (:objects
    butter_1 - butter
    cookies_1 - cookies
    milk_1 - milk
    salad_dressing_1 - salad_dressing
  )

  (:obj_of_interest
    butter_1
  )

  (:init
    (On plate_1 living_room_table_plate_region)
    (On butter_1 living_room_table_object_init_region_0)
    (On cookies_1 living_room_table_object_init_region_1)
    (On milk_1 living_room_table_object_init_region_2)
    (On salad_dressing_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (On butter_1 plate_1))
  )

)
