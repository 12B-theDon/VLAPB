(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the butter belonging to user_001 and place it in the basket)
    (:regions
      (basket_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1773 0.0646 0.2273 0.1146)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.0206 0.1989 0.0294 0.2489)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.2227 0.0719 -0.1727 0.1219)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (-0.0292 -0.2421 0.0208 -0.1921)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    kitchen_table - table
    basket_1 - basket
  )

  (:objects
    butter_1 - butter
    cookies_1 - cookies
    milk_1 - milk
    white_bowl_1 - white_bowl
  )

  (:obj_of_interest
    butter_1
  )

  (:init
    (On basket_1 kitchen_table_basket_region)
    (On butter_1 kitchen_table_object_init_region_0)
    (On cookies_1 kitchen_table_object_init_region_1)
    (On milk_1 kitchen_table_object_init_region_2)
    (On white_bowl_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (In butter_1 basket_1_contain_region))
  )

)
