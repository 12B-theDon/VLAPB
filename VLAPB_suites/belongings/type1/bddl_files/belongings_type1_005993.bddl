(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the butter belonging to user_001 and place it in the basket)
    (:regions
      (basket_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.2018 0.0575 0.2518 0.1075)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.0055 0.1977 0.0445 0.2477)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.2218 0.0887 -0.1718 0.1387)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (-0.046 -0.2643 0.004 -0.2143)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    living_room_table - table
    basket_1 - basket
  )

  (:objects
    butter_1 - butter
    cookies_1 - cookies
    new_salad_dressing_1 - new_salad_dressing
    orange_juice_1 - orange_juice
  )

  (:obj_of_interest
    butter_1
  )

  (:init
    (On basket_1 living_room_table_basket_region)
    (On butter_1 living_room_table_object_init_region_0)
    (On cookies_1 living_room_table_object_init_region_1)
    (On new_salad_dressing_1 living_room_table_object_init_region_2)
    (On orange_juice_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (In butter_1 basket_1_contain_region))
  )

)
