(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the butter belonging to user_001 and place it in the basket)
    (:regions
      (basket_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1577 0.0615 0.2077 0.1115)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.0262 0.1873 0.0238 0.2373)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.2513 0.0789 -0.2013 0.1289)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (-0.0237 -0.239 0.0263 -0.189)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    living_room_table - table
    basket_1 - basket
  )

  (:objects
    butter_1 - butter
    cookies_1 - cookies
    orange_juice_1 - orange_juice
    porcelain_mug_1 - porcelain_mug
  )

  (:obj_of_interest
    butter_1
  )

  (:init
    (On basket_1 living_room_table_basket_region)
    (On butter_1 living_room_table_object_init_region_0)
    (On cookies_1 living_room_table_object_init_region_1)
    (On orange_juice_1 living_room_table_object_init_region_2)
    (On porcelain_mug_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (In butter_1 basket_1_contain_region))
  )

)
