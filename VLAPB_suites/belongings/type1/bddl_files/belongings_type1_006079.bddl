(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the butter belonging to user_001 and place it on the flat_stove)
    (:regions
      (flat_stove_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.156 0.1406 0.206 0.1906)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.1982 0.1643 -0.1482 0.2143)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.1732 -0.1606 -0.1232 -0.1106)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.1126 -0.1754 0.1626 -0.1254)
            )
          )
      )
      (cook_region
          (:target flat_stove_1)
      )
    )

  (:fixtures
    living_room_table - table
    flat_stove_1 - flat_stove
  )

  (:objects
    butter_1 - butter
    cookies_1 - cookies
    red_coffee_mug_1 - red_coffee_mug
    salad_dressing_1 - salad_dressing
  )

  (:obj_of_interest
    butter_1
  )

  (:init
    (On flat_stove_1 living_room_table_flat_stove_region)
    (On butter_1 living_room_table_object_init_region_0)
    (On cookies_1 living_room_table_object_init_region_1)
    (On red_coffee_mug_1 living_room_table_object_init_region_2)
    (On salad_dressing_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (On butter_1 flat_stove_1_cook_region))
  )

)
