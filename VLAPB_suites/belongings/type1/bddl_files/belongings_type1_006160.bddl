(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the butter belonging to user_001 and place it on the plate)
    (:regions
      (plate_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1467 0.1075 0.1967 0.1575)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.1606 0.1506 -0.1106 0.2006)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.1815 -0.1459 -0.1315 -0.0959)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.0985 -0.1849 0.1485 -0.1349)
            )
          )
      )
      (top_region
          (:target plate_1)
      )
    )

  (:fixtures
    kitchen_table - table
    plate_1 - plate
  )

  (:objects
    butter_1 - butter
    cream_cheese_1 - cream_cheese
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    red_coffee_mug_1 - red_coffee_mug
  )

  (:obj_of_interest
    butter_1
  )

  (:init
    (On plate_1 kitchen_table_plate_region)
    (On butter_1 kitchen_table_object_init_region_0)
    (On cream_cheese_1 kitchen_table_object_init_region_1)
    (On glazed_rim_porcelain_ramekin_1 kitchen_table_object_init_region_2)
    (On red_coffee_mug_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (On butter_1 plate_1))
  )

)
