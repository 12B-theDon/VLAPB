(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the butter belonging to user_001 and place it in the wooden_tray)
    (:regions
      (wooden_tray_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1564 0.0651 0.2064 0.1151)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.1154 0.157 -0.0654 0.207)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.2543 -0.1388 -0.2043 -0.0888)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.0843 -0.2453 0.1343 -0.1953)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    kitchen_table - table
    wooden_tray_1 - wooden_tray
  )

  (:objects
    butter_1 - butter
    cream_cheese_1 - cream_cheese
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    tomato_sauce_1 - tomato_sauce
  )

  (:obj_of_interest
    butter_1
  )

  (:init
    (On wooden_tray_1 kitchen_table_wooden_tray_region)
    (On butter_1 kitchen_table_object_init_region_0)
    (On cream_cheese_1 kitchen_table_object_init_region_1)
    (On glazed_rim_porcelain_ramekin_1 kitchen_table_object_init_region_2)
    (On tomato_sauce_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (In butter_1 wooden_tray_1_contain_region))
  )

)
