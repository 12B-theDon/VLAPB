(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the butter belonging to user_001 and place it in the wooden_tray)
    (:regions
      (wooden_tray_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1519 0.098 0.2019 0.148)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.153 0.1592 -0.103 0.2092)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.2031 -0.1488 -0.1531 -0.0988)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.1019 -0.2075 0.1519 -0.1575)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    kitchen_table - table
    wooden_tray_1 - wooden_tray
  )

  (:objects
    butter_1 - butter
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    milk_1 - milk
    salad_dressing_1 - salad_dressing
  )

  (:obj_of_interest
    butter_1
  )

  (:init
    (On wooden_tray_1 kitchen_table_wooden_tray_region)
    (On butter_1 kitchen_table_object_init_region_0)
    (On glazed_rim_porcelain_ramekin_1 kitchen_table_object_init_region_1)
    (On milk_1 kitchen_table_object_init_region_2)
    (On salad_dressing_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (In butter_1 wooden_tray_1_contain_region))
  )

)
