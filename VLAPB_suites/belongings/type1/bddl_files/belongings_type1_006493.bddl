(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the butter belonging to user_001 and place it in the basket)
    (:regions
      (basket_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1877 0.0838 0.2377 0.1338)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.034 0.223 0.016 0.273)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.2385 0.0653 -0.1885 0.1153)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (-0.017 -0.2466 0.033 -0.1966)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    living_room_table - table
    basket_1 - basket
  )

  (:objects
    butter_1 - butter
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    new_salad_dressing_1 - new_salad_dressing
    tomato_sauce_1 - tomato_sauce
  )

  (:obj_of_interest
    butter_1
  )

  (:init
    (On basket_1 living_room_table_basket_region)
    (On butter_1 living_room_table_object_init_region_0)
    (On glazed_rim_porcelain_ramekin_1 living_room_table_object_init_region_1)
    (On new_salad_dressing_1 living_room_table_object_init_region_2)
    (On tomato_sauce_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (In butter_1 basket_1_contain_region))
  )

)
