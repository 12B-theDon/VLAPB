(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the butter belonging to user_001 and place it on the plate)
    (:regions
      (plate_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1454 0.1372 0.1954 0.1872)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.1999 0.1587 -0.1499 0.2087)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.1698 -0.1629 -0.1198 -0.1129)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.1373 -0.1955 0.1873 -0.1455)
            )
          )
      )
      (top_region
          (:target plate_1)
      )
    )

  (:fixtures
    kitchen_table - table
    plate_1 - plate
  )

  (:objects
    butter_1 - butter
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    porcelain_mug_1 - porcelain_mug
    tomato_sauce_1 - tomato_sauce
  )

  (:obj_of_interest
    butter_1
  )

  (:init
    (On plate_1 kitchen_table_plate_region)
    (On butter_1 kitchen_table_object_init_region_0)
    (On glazed_rim_porcelain_ramekin_1 kitchen_table_object_init_region_1)
    (On porcelain_mug_1 kitchen_table_object_init_region_2)
    (On tomato_sauce_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (On butter_1 plate_1))
  )

)
