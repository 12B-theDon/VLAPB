(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the butter belonging to user_001 and place it in the basket)
    (:regions
      (basket_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1992 0.0553 0.2492 0.1053)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.0046 0.196 0.0454 0.246)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.2166 0.0869 -0.1666 0.1369)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (-0.0432 -0.2218 0.0068 -0.1718)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    kitchen_table - table
    basket_1 - basket
  )

  (:objects
    butter_1 - butter
    ketchup_1 - ketchup
    new_salad_dressing_1 - new_salad_dressing
    porcelain_mug_1 - porcelain_mug
  )

  (:obj_of_interest
    butter_1
  )

  (:init
    (On basket_1 kitchen_table_basket_region)
    (On butter_1 kitchen_table_object_init_region_0)
    (On ketchup_1 kitchen_table_object_init_region_1)
    (On new_salad_dressing_1 kitchen_table_object_init_region_2)
    (On porcelain_mug_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (In butter_1 basket_1_contain_region))
  )

)
