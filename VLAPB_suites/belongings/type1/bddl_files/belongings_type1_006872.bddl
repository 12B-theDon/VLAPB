(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the butter belonging to user_001 and place it on the plate)
    (:regions
      (plate_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1845 0.0835 0.2345 0.1335)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.1429 0.2027 -0.0929 0.2527)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.2229 -0.1275 -0.1729 -0.0775)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.0816 -0.2308 0.1316 -0.1808)
            )
          )
      )
      (top_region
          (:target plate_1)
      )
    )

  (:fixtures
    kitchen_table - table
    plate_1 - plate
  )

  (:objects
    butter_1 - butter
    milk_1 - milk
    porcelain_mug_1 - porcelain_mug
    tomato_sauce_1 - tomato_sauce
  )

  (:obj_of_interest
    butter_1
  )

  (:init
    (On plate_1 kitchen_table_plate_region)
    (On butter_1 kitchen_table_object_init_region_0)
    (On milk_1 kitchen_table_object_init_region_1)
    (On porcelain_mug_1 kitchen_table_object_init_region_2)
    (On tomato_sauce_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (On butter_1 plate_1))
  )

)
