(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the butter belonging to user_001 and place it in the basket)
    (:regions
      (basket_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.183 0.0838 0.233 0.1338)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.0357 0.2077 0.0143 0.2577)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.2437 0.065 -0.1937 0.115)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (-0.0134 -0.2786 0.0366 -0.2286)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    kitchen_table - table
    basket_1 - basket
  )

  (:objects
    butter_1 - butter
    new_salad_dressing_1 - new_salad_dressing
    red_coffee_mug_1 - red_coffee_mug
    wine_bottle_1 - wine_bottle
  )

  (:obj_of_interest
    butter_1
  )

  (:init
    (On basket_1 kitchen_table_basket_region)
    (On butter_1 kitchen_table_object_init_region_0)
    (On new_salad_dressing_1 kitchen_table_object_init_region_1)
    (On red_coffee_mug_1 kitchen_table_object_init_region_2)
    (On wine_bottle_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (In butter_1 basket_1_contain_region))
  )

)
