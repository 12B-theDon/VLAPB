(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the butter belonging to user_001 and place it on the flat_stove)
    (:regions
      (flat_stove_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1948 0.0933 0.2448 0.1433)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.1275 0.1654 -0.0775 0.2154)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.2 -0.1192 -0.15 -0.0692)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.0903 -0.2391 0.1403 -0.1891)
            )
          )
      )
      (cook_region
          (:target flat_stove_1)
      )
    )

  (:fixtures
    living_room_table - table
    flat_stove_1 - flat_stove
  )

  (:objects
    butter_1 - butter
    orange_juice_1 - orange_juice
    red_coffee_mug_1 - red_coffee_mug
    white_yellow_mug_1 - white_yellow_mug
  )

  (:obj_of_interest
    butter_1
  )

  (:init
    (On flat_stove_1 living_room_table_flat_stove_region)
    (On butter_1 living_room_table_object_init_region_0)
    (On orange_juice_1 living_room_table_object_init_region_1)
    (On red_coffee_mug_1 living_room_table_object_init_region_2)
    (On white_yellow_mug_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (On butter_1 flat_stove_1_cook_region))
  )

)
