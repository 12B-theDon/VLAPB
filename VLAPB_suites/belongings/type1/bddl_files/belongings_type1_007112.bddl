(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the butter belonging to user_001 and place it on the plate)
    (:regions
      (plate_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1565 0.1495 0.2065 0.1995)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.1712 0.1271 -0.1212 0.1771)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.1746 -0.1688 -0.1246 -0.1188)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.1303 -0.1865 0.1803 -0.1365)
            )
          )
      )
      (top_region
          (:target plate_1)
      )
    )

  (:fixtures
    living_room_table - table
    plate_1 - plate
  )

  (:objects
    butter_1 - butter
    orange_juice_1 - orange_juice
    salad_dressing_1 - salad_dressing
    white_yellow_mug_1 - white_yellow_mug
  )

  (:obj_of_interest
    butter_1
  )

  (:init
    (On plate_1 living_room_table_plate_region)
    (On butter_1 living_room_table_object_init_region_0)
    (On orange_juice_1 living_room_table_object_init_region_1)
    (On salad_dressing_1 living_room_table_object_init_region_2)
    (On white_yellow_mug_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (On butter_1 plate_1))
  )

)
