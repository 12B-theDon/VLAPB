(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the butter belonging to user_001 and place it in the basket)
    (:regions
      (basket_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1829 0.0988 0.2329 0.1488)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.0485 0.2073 0.0015 0.2573)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.2248 0.0447 -0.1748 0.0947)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.0007 -0.2794 0.0507 -0.2294)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    living_room_table - table
    basket_1 - basket
  )

  (:objects
    butter_1 - butter
    porcelain_mug_1 - porcelain_mug
    salad_dressing_1 - salad_dressing
    tomato_sauce_1 - tomato_sauce
  )

  (:obj_of_interest
    butter_1
  )

  (:init
    (On basket_1 living_room_table_basket_region)
    (On butter_1 living_room_table_object_init_region_0)
    (On porcelain_mug_1 living_room_table_object_init_region_1)
    (On salad_dressing_1 living_room_table_object_init_region_2)
    (On tomato_sauce_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (In butter_1 basket_1_contain_region))
  )

)
