(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the butter belonging to user_001 and place it in the wooden_tray)
    (:regions
      (wooden_tray_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1567 0.1048 0.2067 0.1548)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.1513 0.1518 -0.1013 0.2018)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.2188 -0.1635 -0.1688 -0.1135)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.1148 -0.2206 0.1648 -0.1706)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    living_room_table - table
    wooden_tray_1 - wooden_tray
  )

  (:objects
    butter_1 - butter
    red_coffee_mug_1 - red_coffee_mug
    tomato_sauce_1 - tomato_sauce
    white_yellow_mug_1 - white_yellow_mug
  )

  (:obj_of_interest
    butter_1
  )

  (:init
    (On wooden_tray_1 living_room_table_wooden_tray_region)
    (On butter_1 living_room_table_object_init_region_0)
    (On red_coffee_mug_1 living_room_table_object_init_region_1)
    (On tomato_sauce_1 living_room_table_object_init_region_2)
    (On white_yellow_mug_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (In butter_1 wooden_tray_1_contain_region))
  )

)
