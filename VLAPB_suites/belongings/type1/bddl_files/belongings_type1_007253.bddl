(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the butter belonging to user_001 and place it in the basket)
    (:regions
      (basket_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1735 0.0474 0.2235 0.0974)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.0035 0.2236 0.0465 0.2736)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.2 0.0758 -0.15 0.1258)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (-0.0426 -0.2284 0.0074 -0.1784)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    living_room_table - table
    basket_1 - basket
  )

  (:objects
    butter_1 - butter
    salad_dressing_1 - salad_dressing
    white_bowl_1 - white_bowl
    white_yellow_mug_1 - white_yellow_mug
  )

  (:obj_of_interest
    butter_1
  )

  (:init
    (On basket_1 living_room_table_basket_region)
    (On butter_1 living_room_table_object_init_region_0)
    (On salad_dressing_1 living_room_table_object_init_region_1)
    (On white_bowl_1 living_room_table_object_init_region_2)
    (On white_yellow_mug_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (In butter_1 basket_1_contain_region))
  )

)
