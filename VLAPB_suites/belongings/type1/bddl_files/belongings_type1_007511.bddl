(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the akita_black_bowl belonging to user_002 and place it on the flat_stove)
    (:regions
      (flat_stove_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1958 0.0985 0.2458 0.1485)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.129 0.1608 -0.079 0.2108)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.2328 -0.1412 -0.1828 -0.0912)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.097 -0.2431 0.147 -0.1931)
            )
          )
      )
      (cook_region
          (:target flat_stove_1)
      )
    )

  (:fixtures
    living_room_table - table
    flat_stove_1 - flat_stove
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    alphabet_soup_1 - alphabet_soup
    new_salad_dressing_1 - new_salad_dressing
    red_coffee_mug_1 - red_coffee_mug
  )

  (:obj_of_interest
    akita_black_bowl_1
  )

  (:init
    (On flat_stove_1 living_room_table_flat_stove_region)
    (On akita_black_bowl_1 living_room_table_object_init_region_0)
    (On alphabet_soup_1 living_room_table_object_init_region_1)
    (On new_salad_dressing_1 living_room_table_object_init_region_2)
    (On red_coffee_mug_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (On akita_black_bowl_1 flat_stove_1_cook_region))
  )

)
