(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the akita_black_bowl belonging to user_002 and place it in the wooden_tray)
    (:regions
      (wooden_tray_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1679 0.1416 0.2179 0.1916)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.1929 0.1694 -0.1429 0.2194)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.2095 -0.1843 -0.1595 -0.1343)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.1116 -0.1832 0.1616 -0.1332)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    living_room_table - table
    wooden_tray_1 - wooden_tray
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    bbq_sauce_1 - bbq_sauce
    new_salad_dressing_1 - new_salad_dressing
    red_coffee_mug_1 - red_coffee_mug
  )

  (:obj_of_interest
    akita_black_bowl_1
  )

  (:init
    (On wooden_tray_1 living_room_table_wooden_tray_region)
    (On akita_black_bowl_1 living_room_table_object_init_region_0)
    (On bbq_sauce_1 living_room_table_object_init_region_1)
    (On new_salad_dressing_1 living_room_table_object_init_region_2)
    (On red_coffee_mug_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (In akita_black_bowl_1 wooden_tray_1_contain_region))
  )

)
