(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the akita_black_bowl belonging to user_002 and place it on the plate)
    (:regions
      (plate_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1387 0.0928 0.1887 0.1428)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.1696 0.1759 -0.1196 0.2259)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.1897 -0.1435 -0.1397 -0.0935)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.116 -0.2209 0.166 -0.1709)
            )
          )
      )
      (top_region
          (:target plate_1)
      )
    )

  (:fixtures
    living_room_table - table
    plate_1 - plate
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    butter_1 - butter
    new_salad_dressing_1 - new_salad_dressing
    porcelain_mug_1 - porcelain_mug
  )

  (:obj_of_interest
    akita_black_bowl_1
  )

  (:init
    (On plate_1 living_room_table_plate_region)
    (On akita_black_bowl_1 living_room_table_object_init_region_0)
    (On butter_1 living_room_table_object_init_region_1)
    (On new_salad_dressing_1 living_room_table_object_init_region_2)
    (On porcelain_mug_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (On akita_black_bowl_1 plate_1))
  )

)
