(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the akita_black_bowl belonging to user_002 and place it on the flat_stove)
    (:regions
      (flat_stove_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1214 0.1158 0.1714 0.1658)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.1728 0.1287 -0.1228 0.1787)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.1669 -0.1614 -0.1169 -0.1114)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.1399 -0.1964 0.1899 -0.1464)
            )
          )
      )
      (cook_region
          (:target flat_stove_1)
      )
    )

  (:fixtures
    living_room_table - table
    flat_stove_1 - flat_stove
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    butter_1 - butter
    orange_juice_1 - orange_juice
    white_bowl_1 - white_bowl
  )

  (:obj_of_interest
    akita_black_bowl_1
  )

  (:init
    (On flat_stove_1 living_room_table_flat_stove_region)
    (On akita_black_bowl_1 living_room_table_object_init_region_0)
    (On butter_1 living_room_table_object_init_region_1)
    (On orange_juice_1 living_room_table_object_init_region_2)
    (On white_bowl_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (On akita_black_bowl_1 flat_stove_1_cook_region))
  )

)
