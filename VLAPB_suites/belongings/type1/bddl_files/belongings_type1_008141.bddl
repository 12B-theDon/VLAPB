(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the akita_black_bowl belonging to user_002 and place it in the basket)
    (:regions
      (basket_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.186 0.1021 0.236 0.1521)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.0466 0.1786 0.0034 0.2286)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.2529 0.0532 -0.2029 0.1032)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.0018 -0.2774 0.0518 -0.2274)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    living_room_table - table
    basket_1 - basket
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    butter_1 - butter
    porcelain_mug_1 - porcelain_mug
    salad_dressing_1 - salad_dressing
  )

  (:obj_of_interest
    akita_black_bowl_1
  )

  (:init
    (On basket_1 living_room_table_basket_region)
    (On akita_black_bowl_1 living_room_table_object_init_region_0)
    (On butter_1 living_room_table_object_init_region_1)
    (On porcelain_mug_1 living_room_table_object_init_region_2)
    (On salad_dressing_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (In akita_black_bowl_1 basket_1_contain_region))
  )

)
