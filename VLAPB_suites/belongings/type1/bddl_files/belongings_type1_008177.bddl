(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the akita_black_bowl belonging to user_002 and place it in the basket)
    (:regions
      (basket_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1769 0.0456 0.2269 0.0956)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.0012 0.2127 0.0488 0.2627)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.233 0.0986 -0.183 0.1486)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (-0.0503 -0.2779 -0.0003 -0.2279)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    living_room_table - table
    basket_1 - basket
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    butter_1 - butter
    red_coffee_mug_1 - red_coffee_mug
    wine_bottle_1 - wine_bottle
  )

  (:obj_of_interest
    akita_black_bowl_1
  )

  (:init
    (On basket_1 living_room_table_basket_region)
    (On akita_black_bowl_1 living_room_table_object_init_region_0)
    (On butter_1 living_room_table_object_init_region_1)
    (On red_coffee_mug_1 living_room_table_object_init_region_2)
    (On wine_bottle_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (In akita_black_bowl_1 basket_1_contain_region))
  )

)
