(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the akita_black_bowl belonging to user_002 and place it on the plate)
    (:regions
      (plate_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1326 0.1307 0.1826 0.1807)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.2023 0.1545 -0.1523 0.2045)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.1856 -0.1837 -0.1356 -0.1337)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.1426 -0.1946 0.1926 -0.1446)
            )
          )
      )
      (top_region
          (:target plate_1)
      )
    )

  (:fixtures
    kitchen_table - table
    plate_1 - plate
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    new_salad_dressing_1 - new_salad_dressing
    tomato_sauce_1 - tomato_sauce
  )

  (:obj_of_interest
    akita_black_bowl_1
  )

  (:init
    (On plate_1 kitchen_table_plate_region)
    (On akita_black_bowl_1 kitchen_table_object_init_region_0)
    (On glazed_rim_porcelain_ramekin_1 kitchen_table_object_init_region_1)
    (On new_salad_dressing_1 kitchen_table_object_init_region_2)
    (On tomato_sauce_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (On akita_black_bowl_1 plate_1))
  )

)
