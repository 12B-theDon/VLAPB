(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the akita_black_bowl belonging to user_002 and place it on the plate)
    (:regions
      (plate_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1684 0.1436 0.2184 0.1936)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.1822 0.1553 -0.1322 0.2053)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.1757 -0.1564 -0.1257 -0.1064)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.1231 -0.1949 0.1731 -0.1449)
            )
          )
      )
      (top_region
          (:target plate_1)
      )
    )

  (:fixtures
    living_room_table - table
    plate_1 - plate
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    ketchup_1 - ketchup
    orange_juice_1 - orange_juice
    red_coffee_mug_1 - red_coffee_mug
  )

  (:obj_of_interest
    akita_black_bowl_1
  )

  (:init
    (On plate_1 living_room_table_plate_region)
    (On akita_black_bowl_1 living_room_table_object_init_region_0)
    (On ketchup_1 living_room_table_object_init_region_1)
    (On orange_juice_1 living_room_table_object_init_region_2)
    (On red_coffee_mug_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (On akita_black_bowl_1 plate_1))
  )

)
