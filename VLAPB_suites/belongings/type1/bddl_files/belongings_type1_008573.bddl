(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the akita_black_bowl belonging to user_002 and place it in the basket)
    (:regions
      (basket_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1947 0.0634 0.2447 0.1134)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.0122 0.2125 0.0378 0.2625)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.2102 0.0738 -0.1602 0.1238)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (-0.0364 -0.2371 0.0136 -0.1871)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    living_room_table - table
    basket_1 - basket
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    ketchup_1 - ketchup
    red_coffee_mug_1 - red_coffee_mug
    white_yellow_mug_1 - white_yellow_mug
  )

  (:obj_of_interest
    akita_black_bowl_1
  )

  (:init
    (On basket_1 living_room_table_basket_region)
    (On akita_black_bowl_1 living_room_table_object_init_region_0)
    (On ketchup_1 living_room_table_object_init_region_1)
    (On red_coffee_mug_1 living_room_table_object_init_region_2)
    (On white_yellow_mug_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (In akita_black_bowl_1 basket_1_contain_region))
  )

)
