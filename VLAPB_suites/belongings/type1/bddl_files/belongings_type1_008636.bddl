(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the akita_black_bowl belonging to user_002 and place it on the plate)
    (:regions
      (plate_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1872 0.0754 0.2372 0.1254)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.1256 0.1876 -0.0756 0.2376)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.2169 -0.1158 -0.1669 -0.0658)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.0766 -0.2397 0.1266 -0.1897)
            )
          )
      )
      (top_region
          (:target plate_1)
      )
    )

  (:fixtures
    kitchen_table - table
    plate_1 - plate
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    milk_1 - milk
    new_salad_dressing_1 - new_salad_dressing
    salad_dressing_1 - salad_dressing
  )

  (:obj_of_interest
    akita_black_bowl_1
  )

  (:init
    (On plate_1 kitchen_table_plate_region)
    (On akita_black_bowl_1 kitchen_table_object_init_region_0)
    (On milk_1 kitchen_table_object_init_region_1)
    (On new_salad_dressing_1 kitchen_table_object_init_region_2)
    (On salad_dressing_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (On akita_black_bowl_1 plate_1))
  )

)
