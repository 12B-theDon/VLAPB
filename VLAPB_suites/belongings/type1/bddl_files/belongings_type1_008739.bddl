(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the akita_black_bowl belonging to user_002 and place it on the flat_stove)
    (:regions
      (flat_stove_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1407 0.1317 0.1907 0.1817)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.1652 0.1232 -0.1152 0.1732)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.1922 -0.1831 -0.1422 -0.1331)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.1363 -0.1956 0.1863 -0.1456)
            )
          )
      )
      (cook_region
          (:target flat_stove_1)
      )
    )

  (:fixtures
    kitchen_table - table
    flat_stove_1 - flat_stove
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    milk_1 - milk
    salad_dressing_1 - salad_dressing
    wine_bottle_1 - wine_bottle
  )

  (:obj_of_interest
    akita_black_bowl_1
  )

  (:init
    (On flat_stove_1 kitchen_table_flat_stove_region)
    (On akita_black_bowl_1 kitchen_table_object_init_region_0)
    (On milk_1 kitchen_table_object_init_region_1)
    (On salad_dressing_1 kitchen_table_object_init_region_2)
    (On wine_bottle_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (On akita_black_bowl_1 flat_stove_1_cook_region))
  )

)
