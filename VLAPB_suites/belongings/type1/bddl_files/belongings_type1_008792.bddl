(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the akita_black_bowl belonging to user_002 and place it on the plate)
    (:regions
      (plate_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1571 0.0948 0.2071 0.1448)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.159 0.1787 -0.109 0.2287)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.2125 -0.1484 -0.1625 -0.0984)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.0965 -0.2097 0.1465 -0.1597)
            )
          )
      )
      (top_region
          (:target plate_1)
      )
    )

  (:fixtures
    living_room_table - table
    plate_1 - plate
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    new_salad_dressing_1 - new_salad_dressing
    orange_juice_1 - orange_juice
    wine_bottle_1 - wine_bottle
  )

  (:obj_of_interest
    akita_black_bowl_1
  )

  (:init
    (On plate_1 living_room_table_plate_region)
    (On akita_black_bowl_1 living_room_table_object_init_region_0)
    (On new_salad_dressing_1 living_room_table_object_init_region_1)
    (On orange_juice_1 living_room_table_object_init_region_2)
    (On wine_bottle_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (On akita_black_bowl_1 plate_1))
  )

)
