(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the chocolate_pudding belonging to user_002 and place it on the plate)
    (:regions
      (plate_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.16 0.1417 0.21 0.1917)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.1852 0.1528 -0.1352 0.2028)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.1966 -0.1796 -0.1466 -0.1296)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.1284 -0.1952 0.1784 -0.1452)
            )
          )
      )
      (top_region
          (:target plate_1)
      )
    )

  (:fixtures
    kitchen_table - table
    plate_1 - plate
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    butter_1 - butter
    chocolate_pudding_1 - chocolate_pudding
    ketchup_1 - ketchup
  )

  (:obj_of_interest
    chocolate_pudding_1
  )

  (:init
    (On plate_1 kitchen_table_plate_region)
    (On chocolate_pudding_1 kitchen_table_object_init_region_0)
    (On alphabet_soup_1 kitchen_table_object_init_region_1)
    (On butter_1 kitchen_table_object_init_region_2)
    (On ketchup_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (On chocolate_pudding_1 plate_1))
  )

)
