(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the chocolate_pudding belonging to user_002 and place it in the wooden_tray)
    (:regions
      (wooden_tray_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1787 0.1091 0.2287 0.1591)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.1639 0.186 -0.1139 0.236)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.2148 -0.15 -0.1648 -0.1)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.0911 -0.2013 0.1411 -0.1513)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    living_room_table - table
    wooden_tray_1 - wooden_tray
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    chocolate_pudding_1 - chocolate_pudding
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    white_yellow_mug_1 - white_yellow_mug
  )

  (:obj_of_interest
    chocolate_pudding_1
  )

  (:init
    (On wooden_tray_1 living_room_table_wooden_tray_region)
    (On chocolate_pudding_1 living_room_table_object_init_region_0)
    (On alphabet_soup_1 living_room_table_object_init_region_1)
    (On glazed_rim_porcelain_ramekin_1 living_room_table_object_init_region_2)
    (On white_yellow_mug_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (In chocolate_pudding_1 wooden_tray_1_contain_region))
  )

)
