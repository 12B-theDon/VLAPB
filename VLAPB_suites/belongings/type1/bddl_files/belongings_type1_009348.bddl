(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the chocolate_pudding belonging to user_002 and place it on the plate)
    (:regions
      (plate_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1676 0.1197 0.2176 0.1697)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.1546 0.1474 -0.1046 0.1974)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.2118 -0.1654 -0.1618 -0.1154)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.0979 -0.1885 0.1479 -0.1385)
            )
          )
      )
      (top_region
          (:target plate_1)
      )
    )

  (:fixtures
    kitchen_table - table
    plate_1 - plate
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    chocolate_pudding_1 - chocolate_pudding
    new_salad_dressing_1 - new_salad_dressing
    white_yellow_mug_1 - white_yellow_mug
  )

  (:obj_of_interest
    chocolate_pudding_1
  )

  (:init
    (On plate_1 kitchen_table_plate_region)
    (On chocolate_pudding_1 kitchen_table_object_init_region_0)
    (On alphabet_soup_1 kitchen_table_object_init_region_1)
    (On new_salad_dressing_1 kitchen_table_object_init_region_2)
    (On white_yellow_mug_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (On chocolate_pudding_1 plate_1))
  )

)
