(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the chocolate_pudding belonging to user_002 and place it in the basket)
    (:regions
      (basket_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1823 0.0717 0.2323 0.1217)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.0251 0.1764 0.0249 0.2264)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.2108 0.0616 -0.1608 0.1116)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (-0.0249 -0.2226 0.0251 -0.1726)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    kitchen_table - table
    basket_1 - basket
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    chocolate_pudding_1 - chocolate_pudding
    porcelain_mug_1 - porcelain_mug
    tomato_sauce_1 - tomato_sauce
  )

  (:obj_of_interest
    chocolate_pudding_1
  )

  (:init
    (On basket_1 kitchen_table_basket_region)
    (On chocolate_pudding_1 kitchen_table_object_init_region_0)
    (On alphabet_soup_1 kitchen_table_object_init_region_1)
    (On porcelain_mug_1 kitchen_table_object_init_region_2)
    (On tomato_sauce_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (In chocolate_pudding_1 basket_1_contain_region))
  )

)
