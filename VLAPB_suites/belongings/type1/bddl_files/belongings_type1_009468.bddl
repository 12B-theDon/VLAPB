(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the chocolate_pudding belonging to user_002 and place it on the plate)
    (:regions
      (plate_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1538 0.1136 0.2038 0.1636)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.1467 0.132 -0.0967 0.182)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.2074 -0.1664 -0.1574 -0.1164)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.1086 -0.1973 0.1586 -0.1473)
            )
          )
      )
      (top_region
          (:target plate_1)
      )
    )

  (:fixtures
    kitchen_table - table
    plate_1 - plate
  )

  (:objects
    bbq_sauce_1 - bbq_sauce
    butter_1 - butter
    chocolate_pudding_1 - chocolate_pudding
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
  )

  (:obj_of_interest
    chocolate_pudding_1
  )

  (:init
    (On plate_1 kitchen_table_plate_region)
    (On chocolate_pudding_1 kitchen_table_object_init_region_0)
    (On bbq_sauce_1 kitchen_table_object_init_region_1)
    (On butter_1 kitchen_table_object_init_region_2)
    (On glazed_rim_porcelain_ramekin_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (On chocolate_pudding_1 plate_1))
  )

)
