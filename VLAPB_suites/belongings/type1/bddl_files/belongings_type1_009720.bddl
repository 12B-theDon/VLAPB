(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the chocolate_pudding belonging to user_002 and place it on the plate)
    (:regions
      (plate_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1968 0.0984 0.2468 0.1484)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.1325 0.1682 -0.0825 0.2182)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.1999 -0.1223 -0.1499 -0.0723)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.0976 -0.2454 0.1476 -0.1954)
            )
          )
      )
      (top_region
          (:target plate_1)
      )
    )

  (:fixtures
    living_room_table - table
    plate_1 - plate
  )

  (:objects
    bbq_sauce_1 - bbq_sauce
    chocolate_pudding_1 - chocolate_pudding
    red_coffee_mug_1 - red_coffee_mug
    salad_dressing_1 - salad_dressing
  )

  (:obj_of_interest
    chocolate_pudding_1
  )

  (:init
    (On plate_1 living_room_table_plate_region)
    (On chocolate_pudding_1 living_room_table_object_init_region_0)
    (On bbq_sauce_1 living_room_table_object_init_region_1)
    (On red_coffee_mug_1 living_room_table_object_init_region_2)
    (On salad_dressing_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (On chocolate_pudding_1 plate_1))
  )

)
