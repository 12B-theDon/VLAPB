(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the chocolate_pudding belonging to user_002 and place it on the flat_stove)
    (:regions
      (flat_stove_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1513 0.1154 0.2013 0.1654)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.1591 0.1434 -0.1091 0.1934)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.2246 -0.184 -0.1746 -0.134)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.1317 -0.2218 0.1817 -0.1718)
            )
          )
      )
      (cook_region
          (:target flat_stove_1)
      )
    )

  (:fixtures
    kitchen_table - table
    flat_stove_1 - flat_stove
  )

  (:objects
    bbq_sauce_1 - bbq_sauce
    chocolate_pudding_1 - chocolate_pudding
    tomato_sauce_1 - tomato_sauce
    wine_bottle_1 - wine_bottle
  )

  (:obj_of_interest
    chocolate_pudding_1
  )

  (:init
    (On flat_stove_1 kitchen_table_flat_stove_region)
    (On chocolate_pudding_1 kitchen_table_object_init_region_0)
    (On bbq_sauce_1 kitchen_table_object_init_region_1)
    (On tomato_sauce_1 kitchen_table_object_init_region_2)
    (On wine_bottle_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (On chocolate_pudding_1 flat_stove_1_cook_region))
  )

)
