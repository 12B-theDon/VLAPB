(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the chocolate_pudding belonging to user_002 and place it in the basket)
    (:regions
      (basket_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.138 0.0887 0.188 0.1387)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.0621 0.1876 -0.0121 0.2376)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.2521 0.0363 -0.2021 0.0863)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.015 -0.2542 0.065 -0.2042)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    kitchen_table - table
    basket_1 - basket
  )

  (:objects
    butter_1 - butter
    chocolate_pudding_1 - chocolate_pudding
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    porcelain_mug_1 - porcelain_mug
  )

  (:obj_of_interest
    chocolate_pudding_1
  )

  (:init
    (On basket_1 kitchen_table_basket_region)
    (On chocolate_pudding_1 kitchen_table_object_init_region_0)
    (On butter_1 kitchen_table_object_init_region_1)
    (On glazed_rim_porcelain_ramekin_1 kitchen_table_object_init_region_2)
    (On porcelain_mug_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (In chocolate_pudding_1 basket_1_contain_region))
  )

)
