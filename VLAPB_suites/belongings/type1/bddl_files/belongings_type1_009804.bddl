(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the chocolate_pudding belonging to user_002 and place it on the plate)
    (:regions
      (plate_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1624 0.0965 0.2124 0.1465)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.1483 0.1651 -0.0983 0.2151)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.2071 -0.1431 -0.1571 -0.0931)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.0896 -0.2017 0.1396 -0.1517)
            )
          )
      )
      (top_region
          (:target plate_1)
      )
    )

  (:fixtures
    kitchen_table - table
    plate_1 - plate
  )

  (:objects
    butter_1 - butter
    chocolate_pudding_1 - chocolate_pudding
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    salad_dressing_1 - salad_dressing
  )

  (:obj_of_interest
    chocolate_pudding_1
  )

  (:init
    (On plate_1 kitchen_table_plate_region)
    (On chocolate_pudding_1 kitchen_table_object_init_region_0)
    (On butter_1 kitchen_table_object_init_region_1)
    (On glazed_rim_porcelain_ramekin_1 kitchen_table_object_init_region_2)
    (On salad_dressing_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (On chocolate_pudding_1 plate_1))
  )

)
