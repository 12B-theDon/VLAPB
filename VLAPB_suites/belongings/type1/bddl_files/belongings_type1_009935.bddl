(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the chocolate_pudding belonging to user_002 and place it on the flat_stove)
    (:regions
      (flat_stove_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.189 0.1081 0.239 0.1581)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.1491 0.1744 -0.0991 0.2244)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.2056 -0.1374 -0.1556 -0.0874)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.0858 -0.2031 0.1358 -0.1531)
            )
          )
      )
      (cook_region
          (:target flat_stove_1)
      )
    )

  (:fixtures
    kitchen_table - table
    flat_stove_1 - flat_stove
  )

  (:objects
    butter_1 - butter
    chocolate_pudding_1 - chocolate_pudding
    orange_juice_1 - orange_juice
    red_coffee_mug_1 - red_coffee_mug
  )

  (:obj_of_interest
    chocolate_pudding_1
  )

  (:init
    (On flat_stove_1 kitchen_table_flat_stove_region)
    (On chocolate_pudding_1 kitchen_table_object_init_region_0)
    (On butter_1 kitchen_table_object_init_region_1)
    (On orange_juice_1 kitchen_table_object_init_region_2)
    (On red_coffee_mug_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (On chocolate_pudding_1 flat_stove_1_cook_region))
  )

)
