(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the chocolate_pudding belonging to user_002 and place it on the plate)
    (:regions
      (plate_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1626 0.1061 0.2126 0.1561)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.1407 0.1406 -0.0907 0.1906)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.2323 -0.1698 -0.1823 -0.1198)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.0928 -0.1937 0.1428 -0.1437)
            )
          )
      )
      (top_region
          (:target plate_1)
      )
    )

  (:fixtures
    living_room_table - table
    plate_1 - plate
  )

  (:objects
    chocolate_pudding_1 - chocolate_pudding
    ketchup_1 - ketchup
    salad_dressing_1 - salad_dressing
    white_yellow_mug_1 - white_yellow_mug
  )

  (:obj_of_interest
    chocolate_pudding_1
  )

  (:init
    (On plate_1 living_room_table_plate_region)
    (On chocolate_pudding_1 living_room_table_object_init_region_0)
    (On ketchup_1 living_room_table_object_init_region_1)
    (On salad_dressing_1 living_room_table_object_init_region_2)
    (On white_yellow_mug_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (On chocolate_pudding_1 plate_1))
  )

)
