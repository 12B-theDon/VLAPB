(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the chocolate_pudding belonging to user_002 and place it on the flat_stove)
    (:regions
      (flat_stove_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1605 0.0768 0.2105 0.1268)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.1424 0.1889 -0.0924 0.2389)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.2398 -0.1429 -0.1898 -0.0929)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.0763 -0.2095 0.1263 -0.1595)
            )
          )
      )
      (cook_region
          (:target flat_stove_1)
      )
    )

  (:fixtures
    kitchen_table - table
    flat_stove_1 - flat_stove
  )

  (:objects
    chocolate_pudding_1 - chocolate_pudding
    ketchup_1 - ketchup
    tomato_sauce_1 - tomato_sauce
    wine_bottle_1 - wine_bottle
  )

  (:obj_of_interest
    chocolate_pudding_1
  )

  (:init
    (On flat_stove_1 kitchen_table_flat_stove_region)
    (On chocolate_pudding_1 kitchen_table_object_init_region_0)
    (On ketchup_1 kitchen_table_object_init_region_1)
    (On tomato_sauce_1 kitchen_table_object_init_region_2)
    (On wine_bottle_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (On chocolate_pudding_1 flat_stove_1_cook_region))
  )

)
