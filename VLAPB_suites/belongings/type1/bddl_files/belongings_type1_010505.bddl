(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the chocolate_pudding belonging to user_002 and place it in the basket)
    (:regions
      (basket_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1965 0.0414 0.2465 0.0914)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (0.0057 0.1854 0.0557 0.2354)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.2273 0.1079 -0.1773 0.1579)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (-0.0598 -0.2634 -0.0098 -0.2134)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    kitchen_table - table
    basket_1 - basket
  )

  (:objects
    chocolate_pudding_1 - chocolate_pudding
    milk_1 - milk
    porcelain_mug_1 - porcelain_mug
    salad_dressing_1 - salad_dressing
  )

  (:obj_of_interest
    chocolate_pudding_1
  )

  (:init
    (On basket_1 kitchen_table_basket_region)
    (On chocolate_pudding_1 kitchen_table_object_init_region_0)
    (On milk_1 kitchen_table_object_init_region_1)
    (On porcelain_mug_1 kitchen_table_object_init_region_2)
    (On salad_dressing_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (In chocolate_pudding_1 basket_1_contain_region))
  )

)
