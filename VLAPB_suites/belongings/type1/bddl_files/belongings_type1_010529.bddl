(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the chocolate_pudding belonging to user_002 and place it in the basket)
    (:regions
      (basket_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1608 0.0642 0.2108 0.1142)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.0279 0.2338 0.0221 0.2838)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.2602 0.0814 -0.2102 0.1314)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (-0.0221 -0.2838 0.0279 -0.2338)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    living_room_table - table
    basket_1 - basket
  )

  (:objects
    chocolate_pudding_1 - chocolate_pudding
    milk_1 - milk
    red_coffee_mug_1 - red_coffee_mug
    tomato_sauce_1 - tomato_sauce
  )

  (:obj_of_interest
    chocolate_pudding_1
  )

  (:init
    (On basket_1 living_room_table_basket_region)
    (On chocolate_pudding_1 living_room_table_object_init_region_0)
    (On milk_1 living_room_table_object_init_region_1)
    (On red_coffee_mug_1 living_room_table_object_init_region_2)
    (On tomato_sauce_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (In chocolate_pudding_1 basket_1_contain_region))
  )

)
