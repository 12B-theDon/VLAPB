(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the chocolate_pudding belonging to user_002 and place it in the basket)
    (:regions
      (basket_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.2133 0.0707 0.2633 0.1207)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.0118 0.2185 0.0382 0.2685)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.2194 0.0789 -0.1694 0.1289)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (-0.0368 -0.2415 0.0132 -0.1915)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    living_room_table - table
    basket_1 - basket
  )

  (:objects
    chocolate_pudding_1 - chocolate_pudding
    orange_juice_1 - orange_juice
    porcelain_mug_1 - porcelain_mug
    white_bowl_1 - white_bowl
  )

  (:obj_of_interest
    chocolate_pudding_1
  )

  (:init
    (On basket_1 living_room_table_basket_region)
    (On chocolate_pudding_1 living_room_table_object_init_region_0)
    (On orange_juice_1 living_room_table_object_init_region_1)
    (On porcelain_mug_1 living_room_table_object_init_region_2)
    (On white_bowl_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (In chocolate_pudding_1 basket_1_contain_region))
  )

)
