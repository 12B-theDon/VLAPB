(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the chocolate_pudding belonging to user_002 and place it in the wooden_tray)
    (:regions
      (wooden_tray_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1534 0.0678 0.2034 0.1178)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.1266 0.1703 -0.0766 0.2203)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.2306 -0.132 -0.1806 -0.082)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.0772 -0.2215 0.1272 -0.1715)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    living_room_table - table
    wooden_tray_1 - wooden_tray
  )

  (:objects
    chocolate_pudding_1 - chocolate_pudding
    orange_juice_1 - orange_juice
    salad_dressing_1 - salad_dressing
    white_bowl_1 - white_bowl
  )

  (:obj_of_interest
    chocolate_pudding_1
  )

  (:init
    (On wooden_tray_1 living_room_table_wooden_tray_region)
    (On chocolate_pudding_1 living_room_table_object_init_region_0)
    (On orange_juice_1 living_room_table_object_init_region_1)
    (On salad_dressing_1 living_room_table_object_init_region_2)
    (On white_bowl_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (In chocolate_pudding_1 wooden_tray_1_contain_region))
  )

)
