(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the chocolate_pudding belonging to user_002 and place it on the flat_stove)
    (:regions
      (flat_stove_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1791 0.1079 0.2291 0.1579)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.1619 0.1852 -0.1119 0.2352)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.203 -0.1409 -0.153 -0.0909)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.0924 -0.2052 0.1424 -0.1552)
            )
          )
      )
      (cook_region
          (:target flat_stove_1)
      )
    )

  (:fixtures
    living_room_table - table
    flat_stove_1 - flat_stove
  )

  (:objects
    chocolate_pudding_1 - chocolate_pudding
    porcelain_mug_1 - porcelain_mug
    tomato_sauce_1 - tomato_sauce
    white_yellow_mug_1 - white_yellow_mug
  )

  (:obj_of_interest
    chocolate_pudding_1
  )

  (:init
    (On flat_stove_1 living_room_table_flat_stove_region)
    (On chocolate_pudding_1 living_room_table_object_init_region_0)
    (On porcelain_mug_1 living_room_table_object_init_region_1)
    (On tomato_sauce_1 living_room_table_object_init_region_2)
    (On white_yellow_mug_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (On chocolate_pudding_1 flat_stove_1_cook_region))
  )

)
