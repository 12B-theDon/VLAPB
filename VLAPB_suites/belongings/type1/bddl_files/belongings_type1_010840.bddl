(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the chocolate_pudding belonging to user_002 and place it on the plate)
    (:regions
      (plate_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1323 0.1152 0.1823 0.1652)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.1655 0.1325 -0.1155 0.1825)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.1923 -0.1741 -0.1423 -0.1241)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.124 -0.1921 0.174 -0.1421)
            )
          )
      )
      (top_region
          (:target plate_1)
      )
    )

  (:fixtures
    living_room_table - table
    plate_1 - plate
  )

  (:objects
    chocolate_pudding_1 - chocolate_pudding
    porcelain_mug_1 - porcelain_mug
    white_yellow_mug_1 - white_yellow_mug
    wine_bottle_1 - wine_bottle
  )

  (:obj_of_interest
    chocolate_pudding_1
  )

  (:init
    (On plate_1 living_room_table_plate_region)
    (On chocolate_pudding_1 living_room_table_object_init_region_0)
    (On porcelain_mug_1 living_room_table_object_init_region_1)
    (On white_yellow_mug_1 living_room_table_object_init_region_2)
    (On wine_bottle_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (On chocolate_pudding_1 plate_1))
  )

)
