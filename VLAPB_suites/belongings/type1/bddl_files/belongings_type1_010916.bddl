(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the chocolate_pudding belonging to user_002 and place it on the plate)
    (:regions
      (plate_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1498 0.1422 0.1998 0.1922)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.1833 0.1405 -0.1333 0.1905)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.2116 -0.2034 -0.1616 -0.1534)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.1173 -0.1738 0.1673 -0.1238)
            )
          )
      )
      (top_region
          (:target plate_1)
      )
    )

  (:fixtures
    kitchen_table - table
    plate_1 - plate
  )

  (:objects
    chocolate_pudding_1 - chocolate_pudding
    tomato_sauce_1 - tomato_sauce
    white_yellow_mug_1 - white_yellow_mug
    wine_bottle_1 - wine_bottle
  )

  (:obj_of_interest
    chocolate_pudding_1
  )

  (:init
    (On plate_1 kitchen_table_plate_region)
    (On chocolate_pudding_1 kitchen_table_object_init_region_0)
    (On tomato_sauce_1 kitchen_table_object_init_region_1)
    (On white_yellow_mug_1 kitchen_table_object_init_region_2)
    (On wine_bottle_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (On chocolate_pudding_1 plate_1))
  )

)
