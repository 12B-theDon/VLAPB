(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the cookies belonging to user_002 and place it on the flat_stove)
    (:regions
      (flat_stove_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.13 0.1277 0.18 0.1777)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.1998 0.1525 -0.1498 0.2025)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.2072 -0.2044 -0.1572 -0.1544)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.1285 -0.1808 0.1785 -0.1308)
            )
          )
      )
      (cook_region
          (:target flat_stove_1)
      )
    )

  (:fixtures
    living_room_table - table
    flat_stove_1 - flat_stove
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    butter_1 - butter
    cookies_1 - cookies
    new_salad_dressing_1 - new_salad_dressing
  )

  (:obj_of_interest
    cookies_1
  )

  (:init
    (On flat_stove_1 living_room_table_flat_stove_region)
    (On cookies_1 living_room_table_object_init_region_0)
    (On alphabet_soup_1 living_room_table_object_init_region_1)
    (On butter_1 living_room_table_object_init_region_2)
    (On new_salad_dressing_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (On cookies_1 flat_stove_1_cook_region))
  )

)
