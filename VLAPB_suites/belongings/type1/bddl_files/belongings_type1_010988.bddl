(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the cookies belonging to user_002 and place it on the plate)
    (:regions
      (plate_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.126 0.1094 0.176 0.1594)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.158 0.1244 -0.108 0.1744)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.1861 -0.1684 -0.1361 -0.1184)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.133 -0.2025 0.183 -0.1525)
            )
          )
      )
      (top_region
          (:target plate_1)
      )
    )

  (:fixtures
    living_room_table - table
    plate_1 - plate
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    butter_1 - butter
    cookies_1 - cookies
    new_salad_dressing_1 - new_salad_dressing
  )

  (:obj_of_interest
    cookies_1
  )

  (:init
    (On plate_1 living_room_table_plate_region)
    (On cookies_1 living_room_table_object_init_region_0)
    (On alphabet_soup_1 living_room_table_object_init_region_1)
    (On butter_1 living_room_table_object_init_region_2)
    (On new_salad_dressing_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (On cookies_1 plate_1))
  )

)
