(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the cookies belonging to user_002 and place it in the wooden_tray)
    (:regions
      (wooden_tray_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1321 0.112 0.1821 0.162)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.1801 0.1528 -0.1301 0.2028)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.1932 -0.1717 -0.1432 -0.1217)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.1238 -0.1956 0.1738 -0.1456)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    kitchen_table - table
    wooden_tray_1 - wooden_tray
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    butter_1 - butter
    cookies_1 - cookies
    wine_bottle_1 - wine_bottle
  )

  (:obj_of_interest
    cookies_1
  )

  (:init
    (On wooden_tray_1 kitchen_table_wooden_tray_region)
    (On cookies_1 kitchen_table_object_init_region_0)
    (On alphabet_soup_1 kitchen_table_object_init_region_1)
    (On butter_1 kitchen_table_object_init_region_2)
    (On wine_bottle_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (In cookies_1 wooden_tray_1_contain_region))
  )

)
