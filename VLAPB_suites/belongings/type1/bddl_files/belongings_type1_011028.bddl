(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the cookies belonging to user_002 and place it on the plate)
    (:regions
      (plate_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1389 0.1371 0.1889 0.1871)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.207 0.159 -0.157 0.209)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.1998 -0.1978 -0.1498 -0.1478)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.147 -0.1989 0.197 -0.1489)
            )
          )
      )
      (top_region
          (:target plate_1)
      )
    )

  (:fixtures
    kitchen_table - table
    plate_1 - plate
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    cookies_1 - cookies
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    milk_1 - milk
  )

  (:obj_of_interest
    cookies_1
  )

  (:init
    (On plate_1 kitchen_table_plate_region)
    (On cookies_1 kitchen_table_object_init_region_0)
    (On alphabet_soup_1 kitchen_table_object_init_region_1)
    (On glazed_rim_porcelain_ramekin_1 kitchen_table_object_init_region_2)
    (On milk_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (On cookies_1 plate_1))
  )

)
