(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the cookies belonging to user_002 and place it in the wooden_tray)
    (:regions
      (wooden_tray_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1598 0.0986 0.2098 0.1486)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.1388 0.1451 -0.0888 0.1951)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.235 -0.1655 -0.185 -0.1155)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.091 -0.1985 0.141 -0.1485)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    kitchen_table - table
    wooden_tray_1 - wooden_tray
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    cookies_1 - cookies
    ketchup_1 - ketchup
    milk_1 - milk
  )

  (:obj_of_interest
    cookies_1
  )

  (:init
    (On wooden_tray_1 kitchen_table_wooden_tray_region)
    (On cookies_1 kitchen_table_object_init_region_0)
    (On alphabet_soup_1 kitchen_table_object_init_region_1)
    (On ketchup_1 kitchen_table_object_init_region_2)
    (On milk_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (In cookies_1 wooden_tray_1_contain_region))
  )

)
