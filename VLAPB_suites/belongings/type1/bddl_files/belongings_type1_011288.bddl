(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the cookies belonging to user_002 and place it on the plate)
    (:regions
      (plate_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1806 0.108 0.2306 0.158)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.1593 0.1826 -0.1093 0.2326)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.2182 -0.15 -0.1682 -0.1)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.0839 -0.1934 0.1339 -0.1434)
            )
          )
      )
      (top_region
          (:target plate_1)
      )
    )

  (:fixtures
    kitchen_table - table
    plate_1 - plate
  )

  (:objects
    bbq_sauce_1 - bbq_sauce
    butter_1 - butter
    cookies_1 - cookies
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
  )

  (:obj_of_interest
    cookies_1
  )

  (:init
    (On plate_1 kitchen_table_plate_region)
    (On cookies_1 kitchen_table_object_init_region_0)
    (On bbq_sauce_1 kitchen_table_object_init_region_1)
    (On butter_1 kitchen_table_object_init_region_2)
    (On glazed_rim_porcelain_ramekin_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (On cookies_1 plate_1))
  )

)
