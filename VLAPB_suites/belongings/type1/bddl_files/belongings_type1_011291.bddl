(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the cookies belonging to user_002 and place it on the flat_stove)
    (:regions
      (flat_stove_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1189 0.1162 0.1689 0.1662)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.1807 0.1337 -0.1307 0.1837)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.2047 -0.2013 -0.1547 -0.1513)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.1549 -0.2084 0.2049 -0.1584)
            )
          )
      )
      (cook_region
          (:target flat_stove_1)
      )
    )

  (:fixtures
    kitchen_table - table
    flat_stove_1 - flat_stove
  )

  (:objects
    bbq_sauce_1 - bbq_sauce
    butter_1 - butter
    cookies_1 - cookies
    ketchup_1 - ketchup
  )

  (:obj_of_interest
    cookies_1
  )

  (:init
    (On flat_stove_1 kitchen_table_flat_stove_region)
    (On cookies_1 kitchen_table_object_init_region_0)
    (On bbq_sauce_1 kitchen_table_object_init_region_1)
    (On butter_1 kitchen_table_object_init_region_2)
    (On ketchup_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (On cookies_1 flat_stove_1_cook_region))
  )

)
