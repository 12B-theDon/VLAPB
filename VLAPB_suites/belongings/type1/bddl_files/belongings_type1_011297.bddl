(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the cookies belonging to user_002 and place it in the basket)
    (:regions
      (basket_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.148 0.0904 0.198 0.1404)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.0582 0.1916 -0.0082 0.2416)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.2577 0.043 -0.2077 0.093)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.0072 -0.2354 0.0572 -0.1854)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    kitchen_table - table
    basket_1 - basket
  )

  (:objects
    bbq_sauce_1 - bbq_sauce
    butter_1 - butter
    cookies_1 - cookies
    new_salad_dressing_1 - new_salad_dressing
  )

  (:obj_of_interest
    cookies_1
  )

  (:init
    (On basket_1 kitchen_table_basket_region)
    (On cookies_1 kitchen_table_object_init_region_0)
    (On bbq_sauce_1 kitchen_table_object_init_region_1)
    (On butter_1 kitchen_table_object_init_region_2)
    (On new_salad_dressing_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (In cookies_1 basket_1_contain_region))
  )

)
