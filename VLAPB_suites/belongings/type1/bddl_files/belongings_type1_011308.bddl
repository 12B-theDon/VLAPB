(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the cookies belonging to user_002 and place it on the plate)
    (:regions
      (plate_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1428 0.1355 0.1928 0.1855)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.1637 0.12 -0.1137 0.17)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.2051 -0.1973 -0.1551 -0.1473)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.1292 -0.1862 0.1792 -0.1362)
            )
          )
      )
      (top_region
          (:target plate_1)
      )
    )

  (:fixtures
    living_room_table - table
    plate_1 - plate
  )

  (:objects
    bbq_sauce_1 - bbq_sauce
    butter_1 - butter
    cookies_1 - cookies
    porcelain_mug_1 - porcelain_mug
  )

  (:obj_of_interest
    cookies_1
  )

  (:init
    (On plate_1 living_room_table_plate_region)
    (On cookies_1 living_room_table_object_init_region_0)
    (On bbq_sauce_1 living_room_table_object_init_region_1)
    (On butter_1 living_room_table_object_init_region_2)
    (On porcelain_mug_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (On cookies_1 plate_1))
  )

)
