(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the cookies belonging to user_002 and place it on the flat_stove)
    (:regions
      (flat_stove_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1473 0.0811 0.1973 0.1311)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.1434 0.1674 -0.0934 0.2174)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.2093 -0.1384 -0.1593 -0.0884)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.0804 -0.1961 0.1304 -0.1461)
            )
          )
      )
      (cook_region
          (:target flat_stove_1)
      )
    )

  (:fixtures
    living_room_table - table
    flat_stove_1 - flat_stove
  )

  (:objects
    bbq_sauce_1 - bbq_sauce
    cookies_1 - cookies
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    milk_1 - milk
  )

  (:obj_of_interest
    cookies_1
  )

  (:init
    (On flat_stove_1 living_room_table_flat_stove_region)
    (On cookies_1 living_room_table_object_init_region_0)
    (On bbq_sauce_1 living_room_table_object_init_region_1)
    (On glazed_rim_porcelain_ramekin_1 living_room_table_object_init_region_2)
    (On milk_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (On cookies_1 flat_stove_1_cook_region))
  )

)
