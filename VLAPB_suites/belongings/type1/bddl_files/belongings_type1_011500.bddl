(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the cookies belonging to user_002 and place it on the plate)
    (:regions
      (plate_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1904 0.1179 0.2404 0.1679)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.1492 0.1621 -0.0992 0.2121)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.1972 -0.1393 -0.1472 -0.0893)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.1133 -0.2333 0.1633 -0.1833)
            )
          )
      )
      (top_region
          (:target plate_1)
      )
    )

  (:fixtures
    kitchen_table - table
    plate_1 - plate
  )

  (:objects
    bbq_sauce_1 - bbq_sauce
    cookies_1 - cookies
    orange_juice_1 - orange_juice
    tomato_sauce_1 - tomato_sauce
  )

  (:obj_of_interest
    cookies_1
  )

  (:init
    (On plate_1 kitchen_table_plate_region)
    (On cookies_1 kitchen_table_object_init_region_0)
    (On bbq_sauce_1 kitchen_table_object_init_region_1)
    (On orange_juice_1 kitchen_table_object_init_region_2)
    (On tomato_sauce_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (On cookies_1 plate_1))
  )

)
