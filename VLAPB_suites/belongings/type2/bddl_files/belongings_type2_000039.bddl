(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the orange_juice belonging to user_004 and place it on the flat_stove)
    (:regions
      (flat_stove_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.138 0.1182 0.188 0.1682)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.1769 0.1478 -0.1269 0.1978)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.216 -0.1928 -0.166 -0.1428)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.1353 -0.2074 0.1853 -0.1574)
            )
          )
      )
      (cook_region
          (:target flat_stove_1)
      )
    )

  (:fixtures
    living_room_table - table
    flat_stove_1 - flat_stove
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    chocolate_pudding_1 - chocolate_pudding
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    orange_juice_1 - orange_juice
  )

  (:obj_of_interest
    orange_juice_1
  )

  (:init
    (On flat_stove_1 living_room_table_flat_stove_region)
    (On orange_juice_1 living_room_table_object_init_region_0)
    (On akita_black_bowl_1 living_room_table_object_init_region_1)
    (On chocolate_pudding_1 living_room_table_object_init_region_2)
    (On glazed_rim_porcelain_ramekin_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (On orange_juice_1 flat_stove_1_cook_region))
  )

)
