(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the new_salad_dressing belonging to user_004 and place it on the plate)
    (:regions
      (plate_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1441 0.0835 0.1941 0.1335)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.1484 0.1672 -0.0984 0.2172)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.2117 -0.1448 -0.1617 -0.0948)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.0897 -0.2038 0.1397 -0.1538)
            )
          )
      )
      (top_region
          (:target plate_1)
      )
    )

  (:fixtures
    kitchen_table - table
    plate_1 - plate
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    chocolate_pudding_1 - chocolate_pudding
    milk_1 - milk
    new_salad_dressing_1 - new_salad_dressing
  )

  (:obj_of_interest
    new_salad_dressing_1
  )

  (:init
    (On plate_1 kitchen_table_plate_region)
    (On new_salad_dressing_1 kitchen_table_object_init_region_0)
    (On akita_black_bowl_1 kitchen_table_object_init_region_1)
    (On chocolate_pudding_1 kitchen_table_object_init_region_2)
    (On milk_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (On new_salad_dressing_1 plate_1))
  )

)
