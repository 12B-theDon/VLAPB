(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the ketchup belonging to user_003 and place it in the basket)
    (:regions
      (basket_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1948 0.108 0.2448 0.158)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.0488 0.1953 0.0012 0.2453)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.2548 0.0534 -0.2048 0.1034)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (-0.0018 -0.2393 0.0482 -0.1893)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    kitchen_table - table
    basket_1 - basket
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    cookies_1 - cookies
    ketchup_1 - ketchup
    new_salad_dressing_1 - new_salad_dressing
  )

  (:obj_of_interest
    ketchup_1
  )

  (:init
    (On basket_1 kitchen_table_basket_region)
    (On ketchup_1 kitchen_table_object_init_region_0)
    (On akita_black_bowl_1 kitchen_table_object_init_region_1)
    (On cookies_1 kitchen_table_object_init_region_2)
    (On new_salad_dressing_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (In ketchup_1 basket_1_contain_region))
  )

)
