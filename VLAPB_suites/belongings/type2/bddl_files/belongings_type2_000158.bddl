(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the ketchup belonging to user_003 and place it in the wooden_tray)
    (:regions
      (wooden_tray_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1422 0.1059 0.1922 0.1559)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.1529 0.1383 -0.1029 0.1883)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.2163 -0.1749 -0.1663 -0.1249)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.1178 -0.2074 0.1678 -0.1574)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    living_room_table - table
    wooden_tray_1 - wooden_tray
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    cookies_1 - cookies
    ketchup_1 - ketchup
    new_salad_dressing_1 - new_salad_dressing
  )

  (:obj_of_interest
    ketchup_1
  )

  (:init
    (On wooden_tray_1 living_room_table_wooden_tray_region)
    (On ketchup_1 living_room_table_object_init_region_0)
    (On akita_black_bowl_1 living_room_table_object_init_region_1)
    (On cookies_1 living_room_table_object_init_region_2)
    (On new_salad_dressing_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (In ketchup_1 wooden_tray_1_contain_region))
  )

)
