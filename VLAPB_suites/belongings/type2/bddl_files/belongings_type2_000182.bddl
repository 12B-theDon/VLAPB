(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the orange_juice belonging to user_004 and place it in the wooden_tray)
    (:regions
      (wooden_tray_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.156 0.1309 0.206 0.1809)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.1751 0.1493 -0.1251 0.1993)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.1954 -0.1718 -0.1454 -0.1218)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.106 -0.1771 0.156 -0.1271)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    living_room_table - table
    wooden_tray_1 - wooden_tray
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    cookies_1 - cookies
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    orange_juice_1 - orange_juice
  )

  (:obj_of_interest
    orange_juice_1
  )

  (:init
    (On wooden_tray_1 living_room_table_wooden_tray_region)
    (On orange_juice_1 living_room_table_object_init_region_0)
    (On akita_black_bowl_1 living_room_table_object_init_region_1)
    (On cookies_1 living_room_table_object_init_region_2)
    (On glazed_rim_porcelain_ramekin_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (In orange_juice_1 wooden_tray_1_contain_region))
  )

)
