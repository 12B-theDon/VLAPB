(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the new_salad_dressing belonging to user_004 and place it in the wooden_tray)
    (:regions
      (wooden_tray_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1412 0.0874 0.1912 0.1374)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.144 0.151 -0.094 0.201)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.2111 -0.1509 -0.1611 -0.1009)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.1072 -0.2205 0.1572 -0.1705)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    kitchen_table - table
    wooden_tray_1 - wooden_tray
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    cookies_1 - cookies
    ketchup_1 - ketchup
    new_salad_dressing_1 - new_salad_dressing
  )

  (:obj_of_interest
    new_salad_dressing_1
  )

  (:init
    (On wooden_tray_1 kitchen_table_wooden_tray_region)
    (On new_salad_dressing_1 kitchen_table_object_init_region_0)
    (On akita_black_bowl_1 kitchen_table_object_init_region_1)
    (On cookies_1 kitchen_table_object_init_region_2)
    (On ketchup_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (In new_salad_dressing_1 wooden_tray_1_contain_region))
  )

)
