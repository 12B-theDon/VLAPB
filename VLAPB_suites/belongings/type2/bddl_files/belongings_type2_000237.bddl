(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the porcelain_mug belonging to user_004 and place it in the basket)
    (:regions
      (basket_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.2096 0.0787 0.2596 0.1287)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.0198 0.2311 0.0302 0.2811)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.2178 0.0697 -0.1678 0.1197)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (-0.0301 -0.2756 0.0199 -0.2256)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    kitchen_table - table
    basket_1 - basket
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    cookies_1 - cookies
    ketchup_1 - ketchup
    porcelain_mug_1 - porcelain_mug
  )

  (:obj_of_interest
    porcelain_mug_1
  )

  (:init
    (On basket_1 kitchen_table_basket_region)
    (On porcelain_mug_1 kitchen_table_object_init_region_0)
    (On akita_black_bowl_1 kitchen_table_object_init_region_1)
    (On cookies_1 kitchen_table_object_init_region_2)
    (On ketchup_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (In porcelain_mug_1 basket_1_contain_region))
  )

)
