(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the orange_juice belonging to user_004 and place it in the basket)
    (:regions
      (basket_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1614 0.0921 0.2114 0.1421)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.0562 0.2239 -0.0062 0.2739)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.2232 0.0389 -0.1732 0.0889)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.0029 -0.2477 0.0529 -0.1977)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    kitchen_table - table
    basket_1 - basket
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    cookies_1 - cookies
    milk_1 - milk
    orange_juice_1 - orange_juice
  )

  (:obj_of_interest
    orange_juice_1
  )

  (:init
    (On basket_1 kitchen_table_basket_region)
    (On orange_juice_1 kitchen_table_object_init_region_0)
    (On akita_black_bowl_1 kitchen_table_object_init_region_1)
    (On cookies_1 kitchen_table_object_init_region_2)
    (On milk_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (In orange_juice_1 basket_1_contain_region))
  )

)
