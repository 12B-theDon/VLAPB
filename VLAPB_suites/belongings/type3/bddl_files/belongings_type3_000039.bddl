(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the orange_juice belonging to user_004 and place it on the flat_stove)
    (:regions
      (flat_stove_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1299 0.1271 0.1799 0.1771)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.1905 0.1436 -0.1405 0.1936)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.19 -0.187 -0.14 -0.137)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.136 -0.189 0.186 -0.139)
            )
          )
      )
      (cook_region
          (:target flat_stove_1)
      )
    )

  (:fixtures
    kitchen_table - table
    flat_stove_1 - flat_stove
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    chocolate_pudding_1 - chocolate_pudding
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    orange_juice_1 - orange_juice
  )

  (:obj_of_interest
    orange_juice_1
  )

  (:init
    (On flat_stove_1 kitchen_table_flat_stove_region)
    (On orange_juice_1 kitchen_table_object_init_region_0)
    (On akita_black_bowl_1 kitchen_table_object_init_region_1)
    (On chocolate_pudding_1 kitchen_table_object_init_region_2)
    (On glazed_rim_porcelain_ramekin_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (On orange_juice_1 flat_stove_1_cook_region))
  )

)
