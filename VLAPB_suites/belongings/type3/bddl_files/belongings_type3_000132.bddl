(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the new_salad_dressing belonging to user_004 and place it on the plate)
    (:regions
      (plate_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1619 0.1099 0.2119 0.1599)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.1412 0.1359 -0.0912 0.1859)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.185 -0.1405 -0.135 -0.0905)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.1123 -0.2152 0.1623 -0.1652)
            )
          )
      )
      (top_region
          (:target plate_1)
      )
    )

  (:fixtures
    living_room_table - table
    plate_1 - plate
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    chocolate_pudding_1 - chocolate_pudding
    milk_1 - milk
    new_salad_dressing_1 - new_salad_dressing
  )

  (:obj_of_interest
    new_salad_dressing_1
  )

  (:init
    (On plate_1 living_room_table_plate_region)
    (On new_salad_dressing_1 living_room_table_object_init_region_0)
    (On akita_black_bowl_1 living_room_table_object_init_region_1)
    (On chocolate_pudding_1 living_room_table_object_init_region_2)
    (On milk_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (On new_salad_dressing_1 plate_1))
  )

)
