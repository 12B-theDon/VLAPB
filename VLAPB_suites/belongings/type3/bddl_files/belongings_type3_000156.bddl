(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the milk belonging to user_003 and place it on the plate)
    (:regions
      (plate_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1628 0.1523 0.2128 0.2023)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.1748 0.1337 -0.1248 0.1837)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.2016 -0.1916 -0.1516 -0.1416)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.1438 -0.2039 0.1938 -0.1539)
            )
          )
      )
      (top_region
          (:target plate_1)
      )
    )

  (:fixtures
    kitchen_table - table
    plate_1 - plate
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    cookies_1 - cookies
    milk_1 - milk
    new_salad_dressing_1 - new_salad_dressing
  )

  (:obj_of_interest
    milk_1
  )

  (:init
    (On plate_1 kitchen_table_plate_region)
    (On milk_1 kitchen_table_object_init_region_0)
    (On akita_black_bowl_1 kitchen_table_object_init_region_1)
    (On cookies_1 kitchen_table_object_init_region_2)
    (On new_salad_dressing_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (On milk_1 plate_1))
  )

)
