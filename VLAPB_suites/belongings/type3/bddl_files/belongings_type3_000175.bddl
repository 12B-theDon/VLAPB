(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the glazed_rim_porcelain_ramekin belonging to user_003 and place it on the flat_stove)
    (:regions
      (flat_stove_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1408 0.138 0.1908 0.188)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.2015 0.1546 -0.1515 0.2046)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.1803 -0.1777 -0.1303 -0.1277)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.1488 -0.2018 0.1988 -0.1518)
            )
          )
      )
      (cook_region
          (:target flat_stove_1)
      )
    )

  (:fixtures
    living_room_table - table
    flat_stove_1 - flat_stove
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    cookies_1 - cookies
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    new_salad_dressing_1 - new_salad_dressing
  )

  (:obj_of_interest
    glazed_rim_porcelain_ramekin_1
  )

  (:init
    (On flat_stove_1 living_room_table_flat_stove_region)
    (On glazed_rim_porcelain_ramekin_1 living_room_table_object_init_region_0)
    (On akita_black_bowl_1 living_room_table_object_init_region_1)
    (On cookies_1 living_room_table_object_init_region_2)
    (On new_salad_dressing_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (On glazed_rim_porcelain_ramekin_1 flat_stove_1_cook_region))
  )

)
