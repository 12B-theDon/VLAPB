(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the porcelain_mug belonging to user_004 and place it on the flat_stove)
    (:regions
      (flat_stove_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1691 0.0741 0.2191 0.1241)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.1328 0.186 -0.0828 0.236)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.202 -0.1154 -0.152 -0.0654)
            )
          )
      )
      (object_init_region_3
          (:target kitchen_table)
          (:ranges (
              (0.0803 -0.2312 0.1303 -0.1812)
            )
          )
      )
      (cook_region
          (:target flat_stove_1)
      )
    )

  (:fixtures
    kitchen_table - table
    flat_stove_1 - flat_stove
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    cookies_1 - cookies
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    porcelain_mug_1 - porcelain_mug
  )

  (:obj_of_interest
    porcelain_mug_1
  )

  (:init
    (On flat_stove_1 kitchen_table_flat_stove_region)
    (On porcelain_mug_1 kitchen_table_object_init_region_0)
    (On akita_black_bowl_1 kitchen_table_object_init_region_1)
    (On cookies_1 kitchen_table_object_init_region_2)
    (On glazed_rim_porcelain_ramekin_1 kitchen_table_object_init_region_3)
  )

  (:goal
    (And (On porcelain_mug_1 flat_stove_1_cook_region))
  )

)
