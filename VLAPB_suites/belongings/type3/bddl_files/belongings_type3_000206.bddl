(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the ketchup belonging to user_003 and place it in the wooden_tray)
    (:regions
      (wooden_tray_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1708 0.0752 0.2208 0.1252)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.1313 0.1828 -0.0813 0.2328)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.2151 -0.1223 -0.1651 -0.0723)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.0779 -0.2262 0.1279 -0.1762)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    living_room_table - table
    wooden_tray_1 - wooden_tray
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    cookies_1 - cookies
    ketchup_1 - ketchup
    orange_juice_1 - orange_juice
  )

  (:obj_of_interest
    ketchup_1
  )

  (:init
    (On wooden_tray_1 living_room_table_wooden_tray_region)
    (On ketchup_1 living_room_table_object_init_region_0)
    (On akita_black_bowl_1 living_room_table_object_init_region_1)
    (On cookies_1 living_room_table_object_init_region_2)
    (On orange_juice_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (In ketchup_1 wooden_tray_1_contain_region))
  )

)
