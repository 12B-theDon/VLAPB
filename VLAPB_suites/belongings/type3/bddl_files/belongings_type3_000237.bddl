(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the porcelain_mug belonging to user_004 and place it in the basket)
    (:regions
      (basket_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1938 0.0667 0.2438 0.1167)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.0168 0.1817 0.0332 0.2317)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.2469 0.0894 -0.1969 0.1394)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (-0.0352 -0.2829 0.0148 -0.2329)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    living_room_table - table
    basket_1 - basket
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    cookies_1 - cookies
    ketchup_1 - ketchup
    porcelain_mug_1 - porcelain_mug
  )

  (:obj_of_interest
    porcelain_mug_1
  )

  (:init
    (On basket_1 living_room_table_basket_region)
    (On porcelain_mug_1 living_room_table_object_init_region_0)
    (On akita_black_bowl_1 living_room_table_object_init_region_1)
    (On cookies_1 living_room_table_object_init_region_2)
    (On ketchup_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (In porcelain_mug_1 basket_1_contain_region))
  )

)
