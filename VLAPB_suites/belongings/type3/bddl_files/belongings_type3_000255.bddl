(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the ketchup belonging to user_003 and place it on the flat_stove)
    (:regions
      (flat_stove_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1488 0.1405 0.1988 0.1905)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.1755 0.1331 -0.1255 0.1831)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.2077 -0.199 -0.1577 -0.149)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.1207 -0.178 0.1707 -0.128)
            )
          )
      )
      (cook_region
          (:target flat_stove_1)
      )
    )

  (:fixtures
    living_room_table - table
    flat_stove_1 - flat_stove
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    cookies_1 - cookies
    ketchup_1 - ketchup
    porcelain_mug_1 - porcelain_mug
  )

  (:obj_of_interest
    ketchup_1
  )

  (:init
    (On flat_stove_1 living_room_table_flat_stove_region)
    (On ketchup_1 living_room_table_object_init_region_0)
    (On akita_black_bowl_1 living_room_table_object_init_region_1)
    (On cookies_1 living_room_table_object_init_region_2)
    (On porcelain_mug_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (On ketchup_1 flat_stove_1_cook_region))
  )

)
