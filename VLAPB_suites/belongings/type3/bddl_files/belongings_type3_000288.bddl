(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the porcelain_mug belonging to user_004 and place it on the plate)
    (:regions
      (plate_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.03 0.03 0.03)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1239 0.105 0.1739 0.155)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.1573 0.1265 -0.1073 0.1765)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (-0.1886 -0.1679 -0.1386 -0.1179)
            )
          )
      )
      (object_init_region_3
          (:target living_room_table)
          (:ranges (
              (0.1343 -0.2074 0.1843 -0.1574)
            )
          )
      )
      (top_region
          (:target plate_1)
      )
    )

  (:fixtures
    living_room_table - table
    plate_1 - plate
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    cookies_1 - cookies
    milk_1 - milk
    porcelain_mug_1 - porcelain_mug
  )

  (:obj_of_interest
    porcelain_mug_1
  )

  (:init
    (On plate_1 living_room_table_plate_region)
    (On porcelain_mug_1 living_room_table_object_init_region_0)
    (On akita_black_bowl_1 living_room_table_object_init_region_1)
    (On cookies_1 living_room_table_object_init_region_2)
    (On milk_1 living_room_table_object_init_region_3)
  )

  (:goal
    (And (On porcelain_mug_1 plate_1))
  )

)
