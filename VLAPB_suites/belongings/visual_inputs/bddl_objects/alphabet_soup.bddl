(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language show alphabet soup)
    (:regions
      (alphabet_soup_init_region
          (:target main_table)
          (:ranges (
              (-0.025000 -0.145000 0.025000 -0.095000)
            )
          )
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
  )

  (:obj_of_interest
    alphabet_soup_1
  )

  (:init
    (On alphabet_soup_1 main_table_alphabet_soup_init_region)
  )

  (:goal
    (And (On alphabet_soup_1 main_table_alphabet_soup_init_region))
  )

)
