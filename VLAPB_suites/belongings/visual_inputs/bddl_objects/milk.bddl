(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language show milk)
    (:regions
      (milk_init_region
          (:target main_table)
          (:ranges (
              (-0.025000 -0.145000 0.025000 -0.095000)
            )
          )
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    milk_1 - milk
  )

  (:obj_of_interest
    milk_1
  )

  (:init
    (On milk_1 main_table_milk_init_region)
  )

  (:goal
    (And (On milk_1 main_table_milk_init_region))
  )

)
