(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language show salad dressing)
    (:regions
      (salad_dressing_init_region
          (:target main_table)
          (:ranges (
              (-0.025000 -0.145000 0.025000 -0.095000)
            )
          )
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    salad_dressing_1 - salad_dressing
  )

  (:obj_of_interest
    salad_dressing_1
  )

  (:init
    (On salad_dressing_1 main_table_salad_dressing_init_region)
  )

  (:goal
    (And (On salad_dressing_1 main_table_salad_dressing_init_region))
  )

)
