(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the ketchup belonging to user_010 and place it at the right of the basket)
    (:regions
      (basket_left_left_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 -0.2400 0.0200 -0.2000)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (wooden_cabinet_right_right_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 0.2800 0.0200 0.3200)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (target_object_init_region
          (:target living_room_table)
          (:ranges (
              (0.1550 -0.0250 0.2050 0.0250)
            )
          )
      )
      (distractor_object_init_region
          (:target living_room_table)
          (:ranges (
              (-0.2050 -0.0250 -0.1550 0.0250)
            )
          )
      )
      (right_side
          (:target basket_left)
      )
    )

  (:fixtures
    living_room_table - living_room_table
    wooden_cabinet_right - wooden_cabinet
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    ketchup_1 - ketchup
    basket_left - basket
  )

  (:obj_of_interest
    ketchup_1
    basket_left
  )

  (:init
    (On basket_left living_room_table_basket_left_left_region)
    (On wooden_cabinet_right living_room_table_wooden_cabinet_right_right_region)
    (On ketchup_1 living_room_table_target_object_init_region)
    (On akita_black_bowl_1 living_room_table_distractor_object_init_region)
  )

  (:goal
    (And (On akita_black_bowl_1 basket_left))
  )

)
