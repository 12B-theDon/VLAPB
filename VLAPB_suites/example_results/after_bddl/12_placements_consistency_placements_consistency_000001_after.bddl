(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the butter belonging to user_001 and place it at the front of the basket)
    (:regions
      (basket_left_left_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 -0.2400 0.0200 -0.2000)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (target_object_init_region
          (:target living_room_table)
          (:ranges (
              (0.1550 -0.0250 0.2050 0.0250)
            )
          )
      )
      (front_side
          (:target basket_left)
      )
    )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    butter_1 - butter
    basket_left - basket
  )

  (:obj_of_interest
    butter_1
    basket_left
  )

  (:init
    (On basket_left living_room_table_basket_left_left_region)
    (On butter_1 living_room_table_target_object_init_region)
  )

  (:goal
    (And (On butter_1 basket_left))
  )

)
