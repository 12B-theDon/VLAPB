(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the orange_juice belonging to user_013 and place it at the on of the wooden_cabinet)
    (:regions
      (wooden_cabinet_right_right_region
          (:target kitchen_table)
          (:ranges (
              (-0.0200 0.2800 0.0200 0.3200)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (target_object_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (top_side
          (:target wooden_cabinet_right)
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    wooden_cabinet_right - wooden_cabinet
  )

  (:objects
    orange_juice_1 - orange_juice
  )

  (:obj_of_interest
    orange_juice_1
    wooden_cabinet_right
  )

  (:init
    (On wooden_cabinet_right kitchen_table_wooden_cabinet_right_right_region)
    (On orange_juice_1 kitchen_table_target_object_init_region)
  )

  (:goal
    (And (On orange_juice_1 wooden_cabinet_right_top_side))
  )

)
