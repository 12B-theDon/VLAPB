(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the chocolate_pudding belonging to user_014 and place it at the right of the basket)
    (:regions
      (basket_left_left_region
          (:target floor)
          (:ranges (
              (-0.0200 -0.2400 0.0200 -0.2000)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (target_object_init_region
          (:target floor)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (placement_goal_region
          (:target floor)
          (:ranges (
              (-0.1400 -0.1900 0.1400 0.1700)
            )
          )
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    chocolate_pudding_1 - chocolate_pudding
    basket_left - basket
  )

  (:obj_of_interest
    chocolate_pudding_1
    basket_left
  )

  (:init
    (On basket_left floor_basket_left_left_region)
    (On chocolate_pudding_1 floor_target_object_init_region)
  )

  (:goal
    (And (AtXY chocolate_pudding_1 floor_placement_goal_region))
  )

)
