(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the new_salad_dressing belonging to user_007 and place it at the in of the basket)
    (:regions
      (basket_left_left_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 -0.2400 0.0200 -0.2000)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (target_object_init_region
          (:target living_room_table)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (contain_region
          (:target basket_left)
      )
    )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    new_salad_dressing_1 - new_salad_dressing
    basket_left - basket
  )

  (:obj_of_interest
    new_salad_dressing_1
    basket_left
  )

  (:init
    (On basket_left living_room_table_basket_left_left_region)
    (On new_salad_dressing_1 living_room_table_target_object_init_region)
  )

  (:goal
    (And (In new_salad_dressing_1 basket_left_contain_region))
  )

)
