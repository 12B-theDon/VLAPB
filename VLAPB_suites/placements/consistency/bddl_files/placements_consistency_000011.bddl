(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the wine_bottle belonging to user_006 and place it at the back of the wooden_two_layer_shelf)
    (:regions
      (wooden_two_layer_shelf_left_left_region
          (:target study_table)
          (:ranges (
              (-0.0200 -0.3200 0.0200 -0.2800)
            )
          )
          (:yaw_rotation (
              (-3.1416 -3.1416)
            )
          )
      )
      (target_object_init_region
          (:target study_table)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (placement_goal_region
          (:target study_table)
          (:ranges (
              (-0.2600 -0.5000 0.0200 -0.1000)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table
    wooden_two_layer_shelf_left - wooden_two_layer_shelf
  )

  (:objects
    wine_bottle_1 - wine_bottle
  )

  (:obj_of_interest
    wine_bottle_1
    wooden_two_layer_shelf_left
  )

  (:init
    (On wooden_two_layer_shelf_left study_table_wooden_two_layer_shelf_left_left_region)
    (On wine_bottle_1 study_table_target_object_init_region)
  )

  (:goal
    (And (AtXY wine_bottle_1 study_table_placement_goal_region))
  )

)
