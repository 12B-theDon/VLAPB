(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language For user_001, pick the alphabet_soup and place it at the front of the basket, for user_010, pick the bbq_sauce and place it at the bottom_left of the wooden_cabinet.)
    (:regions
      (basket_left_left_region
          (:target floor)
          (:ranges (
              (-0.0200 -0.2400 0.0200 -0.2000)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (wooden_cabinet_right_right_region
          (:target floor)
          (:ranges (
              (-0.0200 0.2800 0.0200 0.3200)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (target_object_init_region
          (:target floor)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (secondary_object_init_region
          (:target floor)
          (:ranges (
              (0.1300 -0.0200 0.1800 0.0300)
            )
          )
      )
      (placement_goal_region
          (:target floor)
          (:ranges (
              (-0.0200 -0.4200 0.2600 -0.0200)
            )
          )
      )
      (bottom_region
          (:target wooden_cabinet_right)
      )
    )

  (:fixtures
    floor - floor
    wooden_cabinet_right - wooden_cabinet
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    bbq_sauce_1 - bbq_sauce
    basket_left - basket
  )

  (:obj_of_interest
    alphabet_soup_1 bbq_sauce_1
    basket_left wooden_cabinet_right
  )

  (:init
    (On basket_left floor_basket_left_left_region)
    (On wooden_cabinet_right floor_wooden_cabinet_right_right_region)
    (On alphabet_soup_1 floor_target_object_init_region)
    (On bbq_sauce_1 floor_secondary_object_init_region)
  )

  (:goal
    (And (AtXY alphabet_soup_1 floor_placement_goal_region) (In bbq_sauce_1 wooden_cabinet_right_bottom_region))
  )

)
