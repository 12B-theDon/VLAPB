(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language For user_001, pick the alphabet_soup and place it at the front of the wooden_tray, for user_008, pick the alphabet_soup and place it at the bottom_back of the white_cabinet.)
    (:regions
      (wooden_tray_left_left_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 -0.2400 0.0200 -0.2000)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (white_cabinet_right_right_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 0.2800 0.0200 0.3200)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (target_object_init_region
          (:target living_room_table)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (secondary_object_init_region
          (:target living_room_table)
          (:ranges (
              (0.1300 -0.0200 0.1800 0.0300)
            )
          )
      )
      (placement_goal_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 -0.4200 0.2600 -0.0200)
            )
          )
      )
      (bottom_region
          (:target white_cabinet_right)
      )
    )

  (:fixtures
    living_room_table - living_room_table
    white_cabinet_right - white_cabinet
  )

  (:objects
    alphabet_soup_1 alphabet_soup_2 - alphabet_soup
    wooden_tray_left - wooden_tray
  )

  (:obj_of_interest
    alphabet_soup_1 alphabet_soup_2
    wooden_tray_left white_cabinet_right
  )

  (:init
    (On wooden_tray_left living_room_table_wooden_tray_left_left_region)
    (On white_cabinet_right living_room_table_white_cabinet_right_right_region)
    (On alphabet_soup_1 living_room_table_target_object_init_region)
    (On alphabet_soup_2 living_room_table_secondary_object_init_region)
  )

  (:goal
    (And (AtXY alphabet_soup_1 living_room_table_placement_goal_region) (In alphabet_soup_2 white_cabinet_right_bottom_region))
  )

)
