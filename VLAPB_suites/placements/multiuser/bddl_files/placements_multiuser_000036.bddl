(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language For user_001, pick the alphabet_soup and place it at the front of the basket, for user_018, pick the chocolate_pudding and place it at the in of the wooden_tray.)
    (:regions
      (basket_left_left_region
          (:target floor)
          (:ranges (
              (-0.0200 -0.2400 0.0200 -0.2000)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (wooden_tray_right_right_region
          (:target floor)
          (:ranges (
              (-0.0200 0.2000 0.0200 0.2400)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (target_object_init_region
          (:target floor)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (secondary_object_init_region
          (:target floor)
          (:ranges (
              (0.1300 -0.0200 0.1800 0.0300)
            )
          )
      )
      (placement_goal_region
          (:target floor)
          (:ranges (
              (-0.0200 -0.4200 0.2600 -0.0200)
            )
          )
      )
      (contain_region
          (:target wooden_tray_right)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    chocolate_pudding_1 - chocolate_pudding
    basket_left - basket
    wooden_tray_right - wooden_tray
  )

  (:obj_of_interest
    alphabet_soup_1 chocolate_pudding_1
    basket_left wooden_tray_right
  )

  (:init
    (On basket_left floor_basket_left_left_region)
    (On wooden_tray_right floor_wooden_tray_right_right_region)
    (On alphabet_soup_1 floor_target_object_init_region)
    (On chocolate_pudding_1 floor_secondary_object_init_region)
  )

  (:goal
    (And (AtXY alphabet_soup_1 floor_placement_goal_region) (In chocolate_pudding_1 wooden_tray_right_contain_region))
  )

)
