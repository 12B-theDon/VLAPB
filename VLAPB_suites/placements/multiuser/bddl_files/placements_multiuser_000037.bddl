(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language For user_002, pick the akita_black_bowl and place it at the bottom of the wooden_cabinet, for user_016, pick the glazed_rim_porcelain_ramekin and place it at the back of the wooden_tray.)
    (:regions
      (wooden_cabinet_left_left_region
          (:target kitchen_table)
          (:ranges (
              (-0.0200 -0.3200 0.0200 -0.2800)
            )
          )
          (:yaw_rotation (
              (-3.1416 -3.1416)
            )
          )
      )
      (wooden_tray_right_right_region
          (:target kitchen_table)
          (:ranges (
              (-0.0200 0.2000 0.0200 0.2400)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (target_object_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (secondary_object_init_region
          (:target kitchen_table)
          (:ranges (
              (0.1300 -0.0200 0.1800 0.0300)
            )
          )
      )
      (bottom_region
          (:target wooden_cabinet_left)
      )
      (secondary_placement_goal_region
          (:target kitchen_table)
          (:ranges (
              (-0.2800 0.0000 0.0400 0.4400)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    wooden_cabinet_left - wooden_cabinet
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    wooden_tray_right - wooden_tray
  )

  (:obj_of_interest
    akita_black_bowl_1 glazed_rim_porcelain_ramekin_1
    wooden_cabinet_left wooden_tray_right
  )

  (:init
    (On wooden_cabinet_left kitchen_table_wooden_cabinet_left_left_region)
    (On wooden_tray_right kitchen_table_wooden_tray_right_right_region)
    (On akita_black_bowl_1 kitchen_table_target_object_init_region)
    (On glazed_rim_porcelain_ramekin_1 kitchen_table_secondary_object_init_region)
  )

  (:goal
    (And (In akita_black_bowl_1 wooden_cabinet_left_bottom_region) (AtXY glazed_rim_porcelain_ramekin_1 kitchen_table_secondary_placement_goal_region))
  )

)
