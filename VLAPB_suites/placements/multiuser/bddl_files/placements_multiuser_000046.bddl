(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language For user_010, pick the chocolate_pudding and place it at the right of the wooden_cabinet, for user_007, pick the glazed_rim_porcelain_ramekin and place it at the front of the basket.)
    (:regions
      (wooden_cabinet_left_left_region
          (:target kitchen_table)
          (:ranges (
              (-0.0200 -0.3200 0.0200 -0.2800)
            )
          )
          (:yaw_rotation (
              (-3.1416 -3.1416)
            )
          )
      )
      (basket_right_right_region
          (:target kitchen_table)
          (:ranges (
              (-0.0200 0.2000 0.0200 0.2400)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (target_object_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (secondary_object_init_region
          (:target kitchen_table)
          (:ranges (
              (0.1300 -0.0200 0.1800 0.0300)
            )
          )
      )
      (placement_goal_region
          (:target kitchen_table)
          (:ranges (
              (-0.0700 -0.1700 0.0700 -0.0100)
            )
          )
      )
      (secondary_placement_goal_region
          (:target kitchen_table)
          (:ranges (
              (0.0500 0.1400 0.1900 0.3000)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    wooden_cabinet_left - wooden_cabinet
  )

  (:objects
    chocolate_pudding_1 - chocolate_pudding
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    basket_right - basket
  )

  (:obj_of_interest
    chocolate_pudding_1 glazed_rim_porcelain_ramekin_1
    wooden_cabinet_left basket_right
  )

  (:init
    (On wooden_cabinet_left kitchen_table_wooden_cabinet_left_left_region)
    (On basket_right kitchen_table_basket_right_right_region)
    (On chocolate_pudding_1 kitchen_table_target_object_init_region)
    (On glazed_rim_porcelain_ramekin_1 kitchen_table_secondary_object_init_region)
  )

  (:goal
    (And (AtXY chocolate_pudding_1 kitchen_table_placement_goal_region) (AtXY glazed_rim_porcelain_ramekin_1 kitchen_table_secondary_placement_goal_region))
  )

)
