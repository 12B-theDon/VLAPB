(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language For user_002, pick the akita_black_bowl and place it at the front of the basket, for user_012, pick the cream_cheese and place it at the back of the wooden_tray.)
    (:regions
      (basket_left_left_region
          (:target floor)
          (:ranges (
              (-0.0200 -0.2400 0.0200 -0.2000)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (wooden_tray_right_right_region
          (:target floor)
          (:ranges (
              (-0.0200 0.2000 0.0200 0.2400)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (target_object_init_region
          (:target floor)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (secondary_object_init_region
          (:target floor)
          (:ranges (
              (0.1300 -0.0200 0.1800 0.0300)
            )
          )
      )
      (placement_goal_region
          (:target floor)
          (:ranges (
              (-0.0200 -0.4200 0.2600 -0.0200)
            )
          )
      )
      (secondary_placement_goal_region
          (:target floor)
          (:ranges (
              (-0.2800 0.0000 0.0400 0.4400)
            )
          )
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    cream_cheese_1 - cream_cheese
    basket_left - basket
    wooden_tray_right - wooden_tray
  )

  (:obj_of_interest
    akita_black_bowl_1 cream_cheese_1
    basket_left wooden_tray_right
  )

  (:init
    (On basket_left floor_basket_left_left_region)
    (On wooden_tray_right floor_wooden_tray_right_right_region)
    (On akita_black_bowl_1 floor_target_object_init_region)
    (On cream_cheese_1 floor_secondary_object_init_region)
  )

  (:goal
    (And (AtXY akita_black_bowl_1 floor_placement_goal_region) (AtXY cream_cheese_1 floor_secondary_placement_goal_region))
  )

)
