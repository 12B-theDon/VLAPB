(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language For user_005, pick the red_coffee_mug and place it at the back of the wooden_cabinet, for user_006, pick the white_bowl and place it at the front of the basket.)
    (:regions
      (wooden_cabinet_left_left_region
          (:target kitchen_table)
          (:ranges (
              (-0.0200 -0.3200 0.0200 -0.2800)
            )
          )
          (:yaw_rotation (
              (-3.1416 -3.1416)
            )
          )
      )
      (basket_right_right_region
          (:target kitchen_table)
          (:ranges (
              (-0.0200 0.2000 0.0200 0.2400)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (target_object_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (secondary_object_init_region
          (:target kitchen_table)
          (:ranges (
              (0.1300 -0.0200 0.1800 0.0300)
            )
          )
      )
      (placement_goal_region
          (:target kitchen_table)
          (:ranges (
              (-0.2600 -0.5000 0.0200 -0.1000)
            )
          )
      )
      (secondary_placement_goal_region
          (:target kitchen_table)
          (:ranges (
              (-0.0400 0.0000 0.2800 0.4400)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    wooden_cabinet_left - wooden_cabinet
  )

  (:objects
    red_coffee_mug_1 - red_coffee_mug
    white_bowl_1 - white_bowl
    basket_right - basket
  )

  (:obj_of_interest
    red_coffee_mug_1 white_bowl_1
    wooden_cabinet_left basket_right
  )

  (:init
    (On wooden_cabinet_left kitchen_table_wooden_cabinet_left_left_region)
    (On basket_right kitchen_table_basket_right_right_region)
    (On red_coffee_mug_1 kitchen_table_target_object_init_region)
    (On white_bowl_1 kitchen_table_secondary_object_init_region)
  )

  (:goal
    (And (AtXY red_coffee_mug_1 kitchen_table_placement_goal_region) (AtXY white_bowl_1 kitchen_table_secondary_placement_goal_region))
  )

)
