(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language For user_004, pick the new_salad_dressing and place it at the back of the wooden_tray, for user_006, pick the white_bowl and place it at the middle_back of the wooden_cabinet.)
    (:regions
      (wooden_tray_left_left_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 -0.2400 0.0200 -0.2000)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (wooden_cabinet_right_right_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 0.2800 0.0200 0.3200)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (target_object_init_region
          (:target living_room_table)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (secondary_object_init_region
          (:target living_room_table)
          (:ranges (
              (0.1300 -0.0200 0.1800 0.0300)
            )
          )
      )
      (placement_goal_region
          (:target living_room_table)
          (:ranges (
              (-0.2600 -0.4200 0.0200 -0.0200)
            )
          )
      )
      (middle_region
          (:target wooden_cabinet_right)
      )
    )

  (:fixtures
    living_room_table - living_room_table
    wooden_cabinet_right - wooden_cabinet
  )

  (:objects
    new_salad_dressing_1 - new_salad_dressing
    white_bowl_1 - white_bowl
    wooden_tray_left - wooden_tray
  )

  (:obj_of_interest
    new_salad_dressing_1 white_bowl_1
    wooden_tray_left wooden_cabinet_right
  )

  (:init
    (On wooden_tray_left living_room_table_wooden_tray_left_left_region)
    (On wooden_cabinet_right living_room_table_wooden_cabinet_right_right_region)
    (On new_salad_dressing_1 living_room_table_target_object_init_region)
    (On white_bowl_1 living_room_table_secondary_object_init_region)
  )

  (:goal
    (And (AtXY new_salad_dressing_1 living_room_table_placement_goal_region) (In white_bowl_1 wooden_cabinet_right_middle_region))
  )

)
