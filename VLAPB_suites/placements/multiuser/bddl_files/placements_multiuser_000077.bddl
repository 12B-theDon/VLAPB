(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language For user_002, pick the chocolate_pudding and place it at the in of the basket, for user_016, pick the glazed_rim_porcelain_ramekin and place it at the in of the wooden_tray.)
    (:regions
      (basket_left_left_region
          (:target floor)
          (:ranges (
              (-0.0200 -0.2400 0.0200 -0.2000)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (wooden_tray_right_right_region
          (:target floor)
          (:ranges (
              (-0.0200 0.2000 0.0200 0.2400)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (target_object_init_region
          (:target floor)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (secondary_object_init_region
          (:target floor)
          (:ranges (
              (0.1300 -0.0200 0.1800 0.0300)
            )
          )
      )
      (contain_region
          (:target basket_left)
      )
      (contain_region
          (:target wooden_tray_right)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    chocolate_pudding_1 - chocolate_pudding
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    basket_left - basket
    wooden_tray_right - wooden_tray
  )

  (:obj_of_interest
    chocolate_pudding_1 glazed_rim_porcelain_ramekin_1
    basket_left wooden_tray_right
  )

  (:init
    (On basket_left floor_basket_left_left_region)
    (On wooden_tray_right floor_wooden_tray_right_right_region)
    (On chocolate_pudding_1 floor_target_object_init_region)
    (On glazed_rim_porcelain_ramekin_1 floor_secondary_object_init_region)
  )

  (:goal
    (And (In chocolate_pudding_1 basket_left_contain_region) (In glazed_rim_porcelain_ramekin_1 wooden_tray_right_contain_region))
  )

)
