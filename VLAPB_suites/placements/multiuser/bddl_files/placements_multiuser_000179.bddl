(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language For user_006, pick the white_bowl and place it at the front of the basket, for user_010, pick the chocolate_pudding and place it at the middle_left of the wooden_cabinet.)
    (:regions
      (basket_left_left_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 -0.2400 0.0200 -0.2000)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (wooden_cabinet_right_right_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 0.2800 0.0200 0.3200)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (target_object_init_region
          (:target living_room_table)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (secondary_object_init_region
          (:target living_room_table)
          (:ranges (
              (0.1300 -0.0200 0.1800 0.0300)
            )
          )
      )
      (placement_goal_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 -0.4200 0.2600 -0.0200)
            )
          )
      )
      (middle_region
          (:target wooden_cabinet_right)
      )
    )

  (:fixtures
    living_room_table - living_room_table
    wooden_cabinet_right - wooden_cabinet
  )

  (:objects
    chocolate_pudding_1 - chocolate_pudding
    white_bowl_1 - white_bowl
    basket_left - basket
  )

  (:obj_of_interest
    white_bowl_1 chocolate_pudding_1
    basket_left wooden_cabinet_right
  )

  (:init
    (On basket_left living_room_table_basket_left_left_region)
    (On wooden_cabinet_right living_room_table_wooden_cabinet_right_right_region)
    (On white_bowl_1 living_room_table_target_object_init_region)
    (On chocolate_pudding_1 living_room_table_secondary_object_init_region)
  )

  (:goal
    (And (AtXY white_bowl_1 living_room_table_placement_goal_region) (In chocolate_pudding_1 wooden_cabinet_right_middle_region))
  )

)
