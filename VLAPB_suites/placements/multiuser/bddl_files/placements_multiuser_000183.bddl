(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language For user_006, pick the white_bowl and place it at the front of the basket, for user_012, pick the cream_cheese and place it at the back of the wooden_tray.)
    (:regions
      (basket_left_left_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 -0.2400 0.0200 -0.2000)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (wooden_tray_right_right_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 0.2000 0.0200 0.2400)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (target_object_init_region
          (:target living_room_table)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (secondary_object_init_region
          (:target living_room_table)
          (:ranges (
              (0.1300 -0.0200 0.1800 0.0300)
            )
          )
      )
      (placement_goal_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 -0.4200 0.2600 -0.0200)
            )
          )
      )
      (secondary_placement_goal_region
          (:target living_room_table)
          (:ranges (
              (-0.2800 0.0000 0.0400 0.4400)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    cream_cheese_1 - cream_cheese
    white_bowl_1 - white_bowl
    basket_left - basket
    wooden_tray_right - wooden_tray
  )

  (:obj_of_interest
    white_bowl_1 cream_cheese_1
    basket_left wooden_tray_right
  )

  (:init
    (On basket_left living_room_table_basket_left_left_region)
    (On wooden_tray_right living_room_table_wooden_tray_right_right_region)
    (On white_bowl_1 living_room_table_target_object_init_region)
    (On cream_cheese_1 living_room_table_secondary_object_init_region)
  )

  (:goal
    (And (AtXY white_bowl_1 living_room_table_placement_goal_region) (AtXY cream_cheese_1 living_room_table_secondary_placement_goal_region))
  )

)
