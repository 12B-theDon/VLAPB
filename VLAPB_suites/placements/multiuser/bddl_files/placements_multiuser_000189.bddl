(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language For user_008, pick the alphabet_soup and place it at the front of the wooden_cabinet, for user_012, pick the bbq_sauce and place it at the front of the wooden_tray.)
    (:regions
      (wooden_cabinet_left_left_region
          (:target kitchen_table)
          (:ranges (
              (-0.0200 -0.3200 0.0200 -0.2800)
            )
          )
          (:yaw_rotation (
              (-3.1416 -3.1416)
            )
          )
      )
      (wooden_tray_right_right_region
          (:target kitchen_table)
          (:ranges (
              (-0.0200 0.2000 0.0200 0.2400)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (target_object_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (secondary_object_init_region
          (:target kitchen_table)
          (:ranges (
              (0.1300 -0.0200 0.1800 0.0300)
            )
          )
      )
      (placement_goal_region
          (:target kitchen_table)
          (:ranges (
              (-0.0200 -0.5000 0.2600 -0.1000)
            )
          )
      )
      (secondary_placement_goal_region
          (:target kitchen_table)
          (:ranges (
              (-0.0400 0.0000 0.2800 0.4400)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    wooden_cabinet_left - wooden_cabinet
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    bbq_sauce_1 - bbq_sauce
    wooden_tray_right - wooden_tray
  )

  (:obj_of_interest
    alphabet_soup_1 bbq_sauce_1
    wooden_cabinet_left wooden_tray_right
  )

  (:init
    (On wooden_cabinet_left kitchen_table_wooden_cabinet_left_left_region)
    (On wooden_tray_right kitchen_table_wooden_tray_right_right_region)
    (On alphabet_soup_1 kitchen_table_target_object_init_region)
    (On bbq_sauce_1 kitchen_table_secondary_object_init_region)
  )

  (:goal
    (And (AtXY alphabet_soup_1 kitchen_table_placement_goal_region) (AtXY bbq_sauce_1 kitchen_table_secondary_placement_goal_region))
  )

)
