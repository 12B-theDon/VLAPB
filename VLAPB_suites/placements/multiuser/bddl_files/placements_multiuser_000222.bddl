(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language For user_010, pick the bbq_sauce and place it at the back of the wooden_two_layer_shelf, for user_004, pick the new_salad_dressing and place it at the back of the wooden_tray.)
    (:regions
      (wooden_two_layer_shelf_left_left_region
          (:target kitchen_table)
          (:ranges (
              (-0.0200 -0.3200 0.0200 -0.2800)
            )
          )
          (:yaw_rotation (
              (-3.1416 -3.1416)
            )
          )
      )
      (wooden_tray_right_right_region
          (:target kitchen_table)
          (:ranges (
              (-0.0200 0.2000 0.0200 0.2400)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (target_object_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (secondary_object_init_region
          (:target kitchen_table)
          (:ranges (
              (0.1300 -0.0200 0.1800 0.0300)
            )
          )
      )
      (placement_goal_region
          (:target kitchen_table)
          (:ranges (
              (-0.2600 -0.5000 0.0200 -0.1000)
            )
          )
      )
      (secondary_placement_goal_region
          (:target kitchen_table)
          (:ranges (
              (-0.2800 0.0000 0.0400 0.4400)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    wooden_two_layer_shelf_left - wooden_two_layer_shelf
  )

  (:objects
    bbq_sauce_1 - bbq_sauce
    new_salad_dressing_1 - new_salad_dressing
    wooden_tray_right - wooden_tray
  )

  (:obj_of_interest
    bbq_sauce_1 new_salad_dressing_1
    wooden_two_layer_shelf_left wooden_tray_right
  )

  (:init
    (On wooden_two_layer_shelf_left kitchen_table_wooden_two_layer_shelf_left_left_region)
    (On wooden_tray_right kitchen_table_wooden_tray_right_right_region)
    (On bbq_sauce_1 kitchen_table_target_object_init_region)
    (On new_salad_dressing_1 kitchen_table_secondary_object_init_region)
  )

  (:goal
    (And (AtXY bbq_sauce_1 kitchen_table_placement_goal_region) (AtXY new_salad_dressing_1 kitchen_table_secondary_placement_goal_region))
  )

)
