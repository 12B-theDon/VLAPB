(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language For user_010, pick the chocolate_pudding and place it at the front of the wooden_tray, for user_004, pick the orange_juice and place it at the back of the wooden_two_layer_shelf.)
    (:regions
      (wooden_tray_left_left_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 -0.2400 0.0200 -0.2000)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (wooden_two_layer_shelf_right_right_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 0.2800 0.0200 0.3200)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (target_object_init_region
          (:target living_room_table)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (secondary_object_init_region
          (:target living_room_table)
          (:ranges (
              (0.1300 -0.0200 0.1800 0.0300)
            )
          )
      )
      (placement_goal_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 -0.4200 0.2600 -0.0200)
            )
          )
      )
      (secondary_placement_goal_region
          (:target living_room_table)
          (:ranges (
              (-0.2800 0.0800 0.0400 0.5200)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
    wooden_two_layer_shelf_right - wooden_two_layer_shelf
  )

  (:objects
    chocolate_pudding_1 - chocolate_pudding
    orange_juice_1 - orange_juice
    wooden_tray_left - wooden_tray
  )

  (:obj_of_interest
    chocolate_pudding_1 orange_juice_1
    wooden_tray_left wooden_two_layer_shelf_right
  )

  (:init
    (On wooden_tray_left living_room_table_wooden_tray_left_left_region)
    (On wooden_two_layer_shelf_right living_room_table_wooden_two_layer_shelf_right_right_region)
    (On chocolate_pudding_1 living_room_table_target_object_init_region)
    (On orange_juice_1 living_room_table_secondary_object_init_region)
  )

  (:goal
    (And (AtXY chocolate_pudding_1 living_room_table_placement_goal_region) (AtXY orange_juice_1 living_room_table_secondary_placement_goal_region))
  )

)
