(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language For user_009, pick the cream_cheese and place it at the right of the basket, for user_013, pick the milk and place it at the bottom of the wooden_cabinet.)
    (:regions
      (basket_left_left_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 -0.2400 0.0200 -0.2000)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (wooden_cabinet_right_right_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 0.2800 0.0200 0.3200)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (target_object_init_region
          (:target living_room_table)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (secondary_object_init_region
          (:target living_room_table)
          (:ranges (
              (0.1300 -0.0200 0.1800 0.0300)
            )
          )
      )
      (placement_goal_region
          (:target living_room_table)
          (:ranges (
              (-0.1400 -0.1900 0.1400 0.1700)
            )
          )
      )
      (bottom_region
          (:target wooden_cabinet_right)
      )
    )

  (:fixtures
    living_room_table - living_room_table
    wooden_cabinet_right - wooden_cabinet
  )

  (:objects
    cream_cheese_1 - cream_cheese
    milk_1 - milk
    basket_left - basket
  )

  (:obj_of_interest
    cream_cheese_1 milk_1
    basket_left wooden_cabinet_right
  )

  (:init
    (On basket_left living_room_table_basket_left_left_region)
    (On wooden_cabinet_right living_room_table_wooden_cabinet_right_right_region)
    (On cream_cheese_1 living_room_table_target_object_init_region)
    (On milk_1 living_room_table_secondary_object_init_region)
  )

  (:goal
    (And (AtXY cream_cheese_1 living_room_table_placement_goal_region) (In milk_1 wooden_cabinet_right_bottom_region))
  )

)
