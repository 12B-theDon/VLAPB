(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language For user_010, pick the ketchup and place it at the right of the basket, for user_012, pick the cream_cheese and place it at the in of the wooden_tray.)
    (:regions
      (basket_left_left_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 -0.2400 0.0200 -0.2000)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (wooden_tray_right_right_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 0.2000 0.0200 0.2400)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (target_object_init_region
          (:target living_room_table)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (secondary_object_init_region
          (:target living_room_table)
          (:ranges (
              (0.1300 -0.0200 0.1800 0.0300)
            )
          )
      )
      (placement_goal_region
          (:target living_room_table)
          (:ranges (
              (-0.0700 -0.0900 0.0700 0.0700)
            )
          )
      )
      (contain_region
          (:target wooden_tray_right)
      )
    )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    cream_cheese_1 - cream_cheese
    ketchup_1 - ketchup
    basket_left - basket
    wooden_tray_right - wooden_tray
  )

  (:obj_of_interest
    ketchup_1 cream_cheese_1
    basket_left wooden_tray_right
  )

  (:init
    (On basket_left living_room_table_basket_left_left_region)
    (On wooden_tray_right living_room_table_wooden_tray_right_right_region)
    (On ketchup_1 living_room_table_target_object_init_region)
    (On cream_cheese_1 living_room_table_secondary_object_init_region)
  )

  (:goal
    (And (AtXY ketchup_1 living_room_table_placement_goal_region) (In cream_cheese_1 wooden_tray_right_contain_region))
  )

)
