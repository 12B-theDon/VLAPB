(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language For user_012, pick the cream_cheese and place it at the in of the wooden_tray, for user_001, pick the bbq_sauce and place it at the back of the basket.)
    (:regions
      (wooden_tray_left_left_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 -0.2400 0.0200 -0.2000)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (basket_right_right_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 0.2000 0.0200 0.2400)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (target_object_init_region
          (:target living_room_table)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (secondary_object_init_region
          (:target living_room_table)
          (:ranges (
              (0.1300 -0.0200 0.1800 0.0300)
            )
          )
      )
      (contain_region
          (:target wooden_tray_left)
      )
      (secondary_placement_goal_region
          (:target living_room_table)
          (:ranges (
              (-0.1900 0.1400 -0.0500 0.3000)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    bbq_sauce_1 - bbq_sauce
    cream_cheese_1 - cream_cheese
    wooden_tray_left - wooden_tray
    basket_right - basket
  )

  (:obj_of_interest
    cream_cheese_1 bbq_sauce_1
    wooden_tray_left basket_right
  )

  (:init
    (On wooden_tray_left living_room_table_wooden_tray_left_left_region)
    (On basket_right living_room_table_basket_right_right_region)
    (On cream_cheese_1 living_room_table_target_object_init_region)
    (On bbq_sauce_1 living_room_table_secondary_object_init_region)
  )

  (:goal
    (And (In cream_cheese_1 wooden_tray_left_contain_region) (AtXY bbq_sauce_1 living_room_table_secondary_placement_goal_region))
  )

)
