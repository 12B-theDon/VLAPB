(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language For user_013, pick the milk and place it at the bottom of the wooden_cabinet, for user_003, pick the glazed_rim_porcelain_ramekin and place it at the left of the basket.)
    (:regions
      (wooden_cabinet_left_left_region
          (:target kitchen_table)
          (:ranges (
              (-0.0200 -0.3200 0.0200 -0.2800)
            )
          )
          (:yaw_rotation (
              (-3.1416 -3.1416)
            )
          )
      )
      (basket_right_right_region
          (:target kitchen_table)
          (:ranges (
              (-0.0200 0.2000 0.0200 0.2400)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (target_object_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (secondary_object_init_region
          (:target kitchen_table)
          (:ranges (
              (0.1300 -0.0200 0.1800 0.0300)
            )
          )
      )
      (bottom_region
          (:target wooden_cabinet_left)
      )
      (secondary_placement_goal_region
          (:target kitchen_table)
          (:ranges (
              (-0.0700 -0.0700 0.0700 0.0900)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    wooden_cabinet_left - wooden_cabinet
  )

  (:objects
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    milk_1 - milk
    basket_right - basket
  )

  (:obj_of_interest
    milk_1 glazed_rim_porcelain_ramekin_1
    wooden_cabinet_left basket_right
  )

  (:init
    (On wooden_cabinet_left kitchen_table_wooden_cabinet_left_left_region)
    (On basket_right kitchen_table_basket_right_right_region)
    (On milk_1 kitchen_table_target_object_init_region)
    (On glazed_rim_porcelain_ramekin_1 kitchen_table_secondary_object_init_region)
  )

  (:goal
    (And (In milk_1 wooden_cabinet_left_bottom_region) (AtXY glazed_rim_porcelain_ramekin_1 kitchen_table_secondary_placement_goal_region))
  )

)
