(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language For user_014, pick the milk and place it at the in of the wooden_tray, for user_004, pick the akita_black_bowl and place it at the bottom_left of the wooden_cabinet.)
    (:regions
      (wooden_tray_left_left_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 -0.2400 0.0200 -0.2000)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (wooden_cabinet_right_right_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 0.2800 0.0200 0.3200)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (target_object_init_region
          (:target living_room_table)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (secondary_object_init_region
          (:target living_room_table)
          (:ranges (
              (0.1300 -0.0200 0.1800 0.0300)
            )
          )
      )
      (contain_region
          (:target wooden_tray_left)
      )
      (bottom_region
          (:target wooden_cabinet_right)
      )
    )

  (:fixtures
    living_room_table - living_room_table
    wooden_cabinet_right - wooden_cabinet
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    milk_1 - milk
    wooden_tray_left - wooden_tray
  )

  (:obj_of_interest
    milk_1 akita_black_bowl_1
    wooden_tray_left wooden_cabinet_right
  )

  (:init
    (On wooden_tray_left living_room_table_wooden_tray_left_left_region)
    (On wooden_cabinet_right living_room_table_wooden_cabinet_right_right_region)
    (On milk_1 living_room_table_target_object_init_region)
    (On akita_black_bowl_1 living_room_table_secondary_object_init_region)
  )

  (:goal
    (And (In milk_1 wooden_tray_left_contain_region) (In akita_black_bowl_1 wooden_cabinet_right_bottom_region))
  )

)
