(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language For user_015, pick the cookies and place it at the back of the wooden_tray, for user_008, pick the alphabet_soup and place it at the front of the wooden_cabinet.)
    (:regions
      (wooden_tray_left_left_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 -0.2400 0.0200 -0.2000)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (wooden_cabinet_right_right_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 0.2800 0.0200 0.3200)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (target_object_init_region
          (:target living_room_table)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (secondary_object_init_region
          (:target living_room_table)
          (:ranges (
              (0.1300 -0.0200 0.1800 0.0300)
            )
          )
      )
      (placement_goal_region
          (:target living_room_table)
          (:ranges (
              (-0.1900 -0.3000 -0.0500 -0.1400)
            )
          )
      )
      (secondary_placement_goal_region
          (:target living_room_table)
          (:ranges (
              (0.0500 0.2200 0.1900 0.3800)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
    wooden_cabinet_right - wooden_cabinet
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    cookies_1 - cookies
    wooden_tray_left - wooden_tray
  )

  (:obj_of_interest
    cookies_1 alphabet_soup_1
    wooden_tray_left wooden_cabinet_right
  )

  (:init
    (On wooden_tray_left living_room_table_wooden_tray_left_left_region)
    (On wooden_cabinet_right living_room_table_wooden_cabinet_right_right_region)
    (On cookies_1 living_room_table_target_object_init_region)
    (On alphabet_soup_1 living_room_table_secondary_object_init_region)
  )

  (:goal
    (And (AtXY cookies_1 living_room_table_placement_goal_region) (AtXY alphabet_soup_1 living_room_table_secondary_placement_goal_region))
  )

)
