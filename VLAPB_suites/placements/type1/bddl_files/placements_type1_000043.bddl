(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the alphabet_soup belonging to user_008 and place it at the bottom_back of the white_cabinet)
    (:regions
      (white_cabinet_right_right_region
          (:target kitchen_table)
          (:ranges (
              (-0.0200 0.2800 0.0200 0.3200)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (target_object_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (bottom_region
          (:target white_cabinet_right)
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    white_cabinet_right - white_cabinet
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
  )

  (:obj_of_interest
    alphabet_soup_1
    white_cabinet_right
  )

  (:init
    (On white_cabinet_right kitchen_table_white_cabinet_right_right_region)
    (On alphabet_soup_1 kitchen_table_target_object_init_region)
  )

  (:goal
    (And (In alphabet_soup_1 white_cabinet_right_bottom_region))
  )

)
