(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the akita_black_bowl belonging to user_006 and place it at the back of the basket)
    (:regions
      (basket_left_left_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 -0.2400 0.0200 -0.2000)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (microwave_right_right_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 0.2800 0.0200 0.3200)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (target_object_init_region
          (:target living_room_table)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (placement_goal_region
          (:target living_room_table)
          (:ranges (
              (-0.1900 -0.3000 -0.0500 -0.1400)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
    microwave_right - microwave
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    basket_left - basket
  )

  (:obj_of_interest
    akita_black_bowl_1
    basket_left
  )

  (:init
    (On basket_left living_room_table_basket_left_left_region)
    (On microwave_right living_room_table_microwave_right_right_region)
    (On akita_black_bowl_1 living_room_table_target_object_init_region)
  )

  (:goal
    (And (AtXY akita_black_bowl_1 living_room_table_placement_goal_region))
  )

)
