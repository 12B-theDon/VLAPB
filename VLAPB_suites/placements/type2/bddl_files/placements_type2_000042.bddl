(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the chocolate_pudding belonging to user_002 and place it at the in of the basket)
    (:regions
      (basket_right_right_region
          (:target floor)
          (:ranges (
              (-0.0200 0.2000 0.0200 0.2400)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (wooden_two_layer_shelf_left_left_region
          (:target floor)
          (:ranges (
              (-0.0200 -0.3200 0.0200 -0.2800)
            )
          )
          (:yaw_rotation (
              (-3.1416 -3.1416)
            )
          )
      )
      (target_object_init_region
          (:target floor)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (contain_region
          (:target basket_right)
      )
    )

  (:fixtures
    floor - floor
    wooden_two_layer_shelf_left - wooden_two_layer_shelf
  )

  (:objects
    chocolate_pudding_1 - chocolate_pudding
    basket_right - basket
  )

  (:obj_of_interest
    chocolate_pudding_1
    basket_right
  )

  (:init
    (On basket_right floor_basket_right_right_region)
    (On wooden_two_layer_shelf_left floor_wooden_two_layer_shelf_left_left_region)
    (On chocolate_pudding_1 floor_target_object_init_region)
  )

  (:goal
    (And (In chocolate_pudding_1 basket_right_contain_region))
  )

)
