(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the new_salad_dressing belonging to user_004 and place it at the back of the wooden_tray)
    (:regions
      (wooden_tray_right_right_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 0.2000 0.0200 0.2400)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (wooden_two_layer_shelf_left_left_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 -0.3200 0.0200 -0.2800)
            )
          )
          (:yaw_rotation (
              (-3.1416 -3.1416)
            )
          )
      )
      (target_object_init_region
          (:target living_room_table)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (placement_goal_region
          (:target living_room_table)
          (:ranges (
              (-0.2600 0.0200 0.0200 0.4200)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
    wooden_two_layer_shelf_left - wooden_two_layer_shelf
  )

  (:objects
    new_salad_dressing_1 - new_salad_dressing
    wooden_tray_right - wooden_tray
  )

  (:obj_of_interest
    new_salad_dressing_1
    wooden_tray_right
  )

  (:init
    (On wooden_tray_right living_room_table_wooden_tray_right_right_region)
    (On wooden_two_layer_shelf_left living_room_table_wooden_two_layer_shelf_left_left_region)
    (On new_salad_dressing_1 living_room_table_target_object_init_region)
  )

  (:goal
    (And (AtXY new_salad_dressing_1 living_room_table_placement_goal_region))
  )

)
