(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the chocolate_pudding belonging to user_007 and place it at the front of the wooden_cabinet)
    (:regions
      (wooden_cabinet_right_right_region
          (:target kitchen_table)
          (:ranges (
              (-0.0200 0.2800 0.0200 0.3200)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (wooden_tray_left_left_region
          (:target kitchen_table)
          (:ranges (
              (-0.0200 -0.2400 0.0200 -0.2000)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (target_object_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (placement_goal_region
          (:target kitchen_table)
          (:ranges (
              (0.0500 0.2200 0.1900 0.3800)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    wooden_cabinet_right - wooden_cabinet
  )

  (:objects
    chocolate_pudding_1 - chocolate_pudding
    wooden_tray_left - wooden_tray
  )

  (:obj_of_interest
    chocolate_pudding_1
    wooden_cabinet_right
  )

  (:init
    (On wooden_cabinet_right kitchen_table_wooden_cabinet_right_right_region)
    (On wooden_tray_left kitchen_table_wooden_tray_left_left_region)
    (On chocolate_pudding_1 kitchen_table_target_object_init_region)
  )

  (:goal
    (And (AtXY chocolate_pudding_1 kitchen_table_placement_goal_region))
  )

)
