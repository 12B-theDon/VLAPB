(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the glazed_rim_porcelain_ramekin belonging to user_007 and place it at the front of the basket)
    (:regions
      (basket_right_right_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 0.2000 0.0200 0.2400)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (wooden_cabinet_left_left_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 -0.3200 0.0200 -0.2800)
            )
          )
          (:yaw_rotation (
              (-3.1416 -3.1416)
            )
          )
      )
      (target_object_init_region
          (:target living_room_table)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (placement_goal_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 0.0200 0.2600 0.4200)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
    wooden_cabinet_left - wooden_cabinet
  )

  (:objects
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    basket_right - basket
  )

  (:obj_of_interest
    glazed_rim_porcelain_ramekin_1
    basket_right
  )

  (:init
    (On basket_right living_room_table_basket_right_right_region)
    (On wooden_cabinet_left living_room_table_wooden_cabinet_left_left_region)
    (On glazed_rim_porcelain_ramekin_1 living_room_table_target_object_init_region)
  )

  (:goal
    (And (AtXY glazed_rim_porcelain_ramekin_1 living_room_table_placement_goal_region))
  )

)
