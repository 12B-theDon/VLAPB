(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the butter belonging to user_015 and place it at the in of the basket)
    (:regions
      (basket_left_left_region
          (:target floor)
          (:ranges (
              (-0.0200 -0.2400 0.0200 -0.2000)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (microwave_right_right_region
          (:target floor)
          (:ranges (
              (-0.0200 0.2800 0.0200 0.3200)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (target_object_init_region
          (:target floor)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (contain_region
          (:target basket_left)
      )
    )

  (:fixtures
    floor - floor
    microwave_right - microwave
  )

  (:objects
    butter_1 - butter
    basket_left - basket
  )

  (:obj_of_interest
    butter_1
    basket_left
  )

  (:init
    (On basket_left floor_basket_left_left_region)
    (On microwave_right floor_microwave_right_right_region)
    (On butter_1 floor_target_object_init_region)
  )

  (:goal
    (And (In butter_1 basket_left_contain_region))
  )

)
