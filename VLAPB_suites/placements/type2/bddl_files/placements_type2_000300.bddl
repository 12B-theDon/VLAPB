(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the salad_dressing belonging to user_019 and place it at the left of the wooden_tray)
    (:regions
      (wooden_tray_right_right_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 0.2000 0.0200 0.2400)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (basket_left_left_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 -0.2400 0.0200 -0.2000)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (target_object_init_region
          (:target living_room_table)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (placement_goal_region
          (:target living_room_table)
          (:ranges (
              (-0.1400 -0.1700 0.1400 0.1900)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    salad_dressing_1 - salad_dressing
    wooden_tray_right - wooden_tray
    basket_left - basket
  )

  (:obj_of_interest
    salad_dressing_1
    wooden_tray_right
  )

  (:init
    (On wooden_tray_right living_room_table_wooden_tray_right_right_region)
    (On basket_left living_room_table_basket_left_left_region)
    (On salad_dressing_1 living_room_table_target_object_init_region)
  )

  (:goal
    (And (AtXY salad_dressing_1 living_room_table_placement_goal_region))
  )

)
