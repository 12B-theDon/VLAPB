(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the akita_black_bowl belonging to user_001 and place it at the in of the basket)
    (:regions
      (basket_left_left_region
          (:target floor)
          (:ranges (
              (-0.0200 -0.2400 0.0200 -0.2000)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (white_cabinet_right_right_region
          (:target floor)
          (:ranges (
              (-0.0200 0.2800 0.0200 0.3200)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (target_object_init_region
          (:target floor)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (distractor_object_init_region
          (:target floor)
          (:ranges (
              (-0.2050 -0.0250 -0.1550 0.0250)
            )
          )
      )
      (contain_region
          (:target basket_left)
      )
    )

  (:fixtures
    floor - floor
    white_cabinet_right - white_cabinet
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    chocolate_pudding_1 - chocolate_pudding
    basket_left - basket
  )

  (:obj_of_interest
    akita_black_bowl_1
    basket_left
  )

  (:init
    (On basket_left floor_basket_left_left_region)
    (On white_cabinet_right floor_white_cabinet_right_right_region)
    (On akita_black_bowl_1 floor_target_object_init_region)
    (On chocolate_pudding_1 floor_distractor_object_init_region)
  )

  (:goal
    (And (In akita_black_bowl_1 basket_left_contain_region))
  )

)
