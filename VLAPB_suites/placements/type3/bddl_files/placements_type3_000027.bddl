(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the akita_black_bowl belonging to user_001 and place it at the in of the basket)
    (:regions
      (basket_right_right_region
          (:target floor)
          (:ranges (
              (-0.0200 0.2000 0.0200 0.2400)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (flat_stove_left_left_region
          (:target floor)
          (:ranges (
              (-0.1400 -0.2400 -0.1000 -0.2000)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (target_object_init_region
          (:target floor)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (distractor_object_init_region
          (:target floor)
          (:ranges (
              (0.0950 -0.1450 0.1450 -0.0950)
            )
          )
      )
      (contain_region
          (:target basket_right)
      )
    )

  (:fixtures
    floor - floor
    flat_stove_left - flat_stove
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    cream_cheese_1 - cream_cheese
    basket_right - basket
  )

  (:obj_of_interest
    akita_black_bowl_1
    basket_right
  )

  (:init
    (On basket_right floor_basket_right_right_region)
    (On flat_stove_left floor_flat_stove_left_left_region)
    (On akita_black_bowl_1 floor_target_object_init_region)
    (On cream_cheese_1 floor_distractor_object_init_region)
  )

  (:goal
    (And (In akita_black_bowl_1 basket_right_contain_region))
  )

)
