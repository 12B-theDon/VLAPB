(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the bbq_sauce belonging to user_001 and place it at the back of the wooden_two_layer_shelf)
    (:regions
      (wooden_two_layer_shelf_right_right_region
          (:target kitchen_table)
          (:ranges (
              (-0.0200 0.2800 0.0200 0.3200)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (wooden_tray_left_left_region
          (:target kitchen_table)
          (:ranges (
              (-0.0200 -0.2400 0.0200 -0.2000)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (target_object_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (distractor_object_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.0250 -0.0250 0.0250 0.0250)
            )
          )
      )
      (placement_goal_region
          (:target kitchen_table)
          (:ranges (
              (-0.2600 0.1000 0.0200 0.5000)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    wooden_two_layer_shelf_right - wooden_two_layer_shelf
  )

  (:objects
    bbq_sauce_1 - bbq_sauce
    cookies_1 - cookies
    wooden_tray_left - wooden_tray
  )

  (:obj_of_interest
    bbq_sauce_1
    wooden_two_layer_shelf_right
  )

  (:init
    (On wooden_two_layer_shelf_right kitchen_table_wooden_two_layer_shelf_right_right_region)
    (On wooden_tray_left kitchen_table_wooden_tray_left_left_region)
    (On bbq_sauce_1 kitchen_table_target_object_init_region)
    (On cookies_1 kitchen_table_distractor_object_init_region)
  )

  (:goal
    (And (AtXY bbq_sauce_1 kitchen_table_placement_goal_region))
  )

)
