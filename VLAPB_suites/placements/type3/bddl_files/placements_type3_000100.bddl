(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the chocolate_pudding belonging to user_002 and place it at the in of the basket)
    (:regions
      (basket_left_left_region
          (:target floor)
          (:ranges (
              (-0.0200 -0.2400 0.0200 -0.2000)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (wooden_tray_right_right_region
          (:target floor)
          (:ranges (
              (-0.0200 0.2000 0.0200 0.2400)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (target_object_init_region
          (:target floor)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (distractor_object_init_region
          (:target floor)
          (:ranges (
              (-0.2050 -0.0250 -0.1550 0.0250)
            )
          )
      )
      (contain_region
          (:target basket_left)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    chocolate_pudding_1 - chocolate_pudding
    basket_left - basket
    wooden_tray_right - wooden_tray
  )

  (:obj_of_interest
    chocolate_pudding_1
    basket_left
  )

  (:init
    (On basket_left floor_basket_left_left_region)
    (On wooden_tray_right floor_wooden_tray_right_right_region)
    (On chocolate_pudding_1 floor_target_object_init_region)
    (On alphabet_soup_1 floor_distractor_object_init_region)
  )

  (:goal
    (And (In chocolate_pudding_1 basket_left_contain_region))
  )

)
