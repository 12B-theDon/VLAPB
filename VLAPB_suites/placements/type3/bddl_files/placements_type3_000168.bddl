(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the akita_black_bowl belonging to user_002 and place it at the front of the basket)
    (:regions
      (basket_right_right_region
          (:target floor)
          (:ranges (
              (-0.0200 0.2000 0.0200 0.2400)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (wooden_two_layer_shelf_left_left_region
          (:target floor)
          (:ranges (
              (-0.0200 -0.3200 0.0200 -0.2800)
            )
          )
          (:yaw_rotation (
              (-3.1416 -3.1416)
            )
          )
      )
      (target_object_init_region
          (:target floor)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (distractor_object_init_region
          (:target floor)
          (:ranges (
              (0.0950 -0.1450 0.1450 -0.0950)
            )
          )
      )
      (placement_goal_region
          (:target floor)
          (:ranges (
              (-0.0200 0.0200 0.2600 0.4200)
            )
          )
      )
    )

  (:fixtures
    floor - floor
    wooden_two_layer_shelf_left - wooden_two_layer_shelf
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    butter_1 - butter
    basket_right - basket
  )

  (:obj_of_interest
    akita_black_bowl_1
    basket_right
  )

  (:init
    (On basket_right floor_basket_right_right_region)
    (On wooden_two_layer_shelf_left floor_wooden_two_layer_shelf_left_left_region)
    (On akita_black_bowl_1 floor_target_object_init_region)
    (On butter_1 floor_distractor_object_init_region)
  )

  (:goal
    (And (AtXY akita_black_bowl_1 floor_placement_goal_region))
  )

)
