(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the glazed_rim_porcelain_ramekin belonging to user_007 and place it at the front of the basket)
    (:regions
      (basket_left_left_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 -0.2400 0.0200 -0.2000)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (wooden_tray_right_right_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 0.2000 0.0200 0.2400)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (target_object_init_region
          (:target living_room_table)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (distractor_object_init_region
          (:target living_room_table)
          (:ranges (
              (0.0950 -0.1450 0.1450 -0.0950)
            )
          )
      )
      (placement_goal_region
          (:target living_room_table)
          (:ranges (
              (0.0500 -0.3000 0.1900 -0.1400)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    butter_1 - butter
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    basket_left - basket
    wooden_tray_right - wooden_tray
  )

  (:obj_of_interest
    glazed_rim_porcelain_ramekin_1
    basket_left
  )

  (:init
    (On basket_left living_room_table_basket_left_left_region)
    (On wooden_tray_right living_room_table_wooden_tray_right_right_region)
    (On glazed_rim_porcelain_ramekin_1 living_room_table_target_object_init_region)
    (On butter_1 living_room_table_distractor_object_init_region)
  )

  (:goal
    (And (AtXY glazed_rim_porcelain_ramekin_1 living_room_table_placement_goal_region))
  )

)
