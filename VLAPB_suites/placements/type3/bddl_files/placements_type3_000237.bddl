(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the orange_juice belonging to user_004 and place it at the back of the wooden_two_layer_shelf)
    (:regions
      (wooden_two_layer_shelf_left_left_region
          (:target kitchen_table)
          (:ranges (
              (-0.0200 -0.3200 0.0200 -0.2800)
            )
          )
          (:yaw_rotation (
              (-3.1416 -3.1416)
            )
          )
      )
      (wooden_tray_right_right_region
          (:target kitchen_table)
          (:ranges (
              (-0.0200 0.2000 0.0200 0.2400)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (target_object_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (distractor_object_init_region
          (:target kitchen_table)
          (:ranges (
              (0.0950 -0.1450 0.1450 -0.0950)
            )
          )
      )
      (placement_goal_region
          (:target kitchen_table)
          (:ranges (
              (-0.2600 -0.5000 0.0200 -0.1000)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    wooden_two_layer_shelf_left - wooden_two_layer_shelf
  )

  (:objects
    butter_1 - butter
    orange_juice_1 - orange_juice
    wooden_tray_right - wooden_tray
  )

  (:obj_of_interest
    orange_juice_1
    wooden_two_layer_shelf_left
  )

  (:init
    (On wooden_two_layer_shelf_left kitchen_table_wooden_two_layer_shelf_left_left_region)
    (On wooden_tray_right kitchen_table_wooden_tray_right_right_region)
    (On orange_juice_1 kitchen_table_target_object_init_region)
    (On butter_1 kitchen_table_distractor_object_init_region)
  )

  (:goal
    (And (AtXY orange_juice_1 kitchen_table_placement_goal_region))
  )

)
