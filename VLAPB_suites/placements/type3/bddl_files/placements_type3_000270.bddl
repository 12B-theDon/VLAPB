(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the alphabet_soup belonging to user_009 and place it at the left of the basket)
    (:regions
      (basket_right_right_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 0.2000 0.0200 0.2400)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (flat_stove_left_left_region
          (:target living_room_table)
          (:ranges (
              (-0.1400 -0.2400 -0.1000 -0.2000)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (target_object_init_region
          (:target living_room_table)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (distractor_object_init_region
          (:target living_room_table)
          (:ranges (
              (0.0950 -0.1450 0.1450 -0.0950)
            )
          )
      )
      (placement_goal_region
          (:target living_room_table)
          (:ranges (
              (-0.0700 -0.0700 0.0700 0.0900)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
    flat_stove_left - flat_stove
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    butter_1 - butter
    basket_right - basket
  )

  (:obj_of_interest
    alphabet_soup_1
    basket_right
  )

  (:init
    (On basket_right living_room_table_basket_right_right_region)
    (On flat_stove_left living_room_table_flat_stove_left_left_region)
    (On alphabet_soup_1 living_room_table_target_object_init_region)
    (On butter_1 living_room_table_distractor_object_init_region)
  )

  (:goal
    (And (AtXY alphabet_soup_1 living_room_table_placement_goal_region))
  )

)
