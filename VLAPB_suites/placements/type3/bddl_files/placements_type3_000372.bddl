(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the alphabet_soup belonging to user_009 and place it at the in of the basket)
    (:regions
      (basket_right_right_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 0.2000 0.0200 0.2400)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (wooden_cabinet_left_left_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 -0.3200 0.0200 -0.2800)
            )
          )
          (:yaw_rotation (
              (-3.1416 -3.1416)
            )
          )
      )
      (target_object_init_region
          (:target living_room_table)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (distractor_object_init_region
          (:target living_room_table)
          (:ranges (
              (0.0950 -0.1450 0.1450 -0.0950)
            )
          )
      )
      (contain_region
          (:target basket_right)
      )
    )

  (:fixtures
    living_room_table - living_room_table
    wooden_cabinet_left - wooden_cabinet
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    butter_1 - butter
    basket_right - basket
  )

  (:obj_of_interest
    alphabet_soup_1
    basket_right
  )

  (:init
    (On basket_right living_room_table_basket_right_right_region)
    (On wooden_cabinet_left living_room_table_wooden_cabinet_left_left_region)
    (On alphabet_soup_1 living_room_table_target_object_init_region)
    (On butter_1 living_room_table_distractor_object_init_region)
  )

  (:goal
    (And (In alphabet_soup_1 basket_right_contain_region))
  )

)
