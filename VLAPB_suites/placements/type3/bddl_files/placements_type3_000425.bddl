(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the ketchup belonging to user_008 and place it at the left of the basket)
    (:regions
      (basket_right_right_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 0.2000 0.0200 0.2400)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (wooden_tray_left_left_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 -0.2400 0.0200 -0.2000)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (target_object_init_region
          (:target living_room_table)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (distractor_object_init_region
          (:target living_room_table)
          (:ranges (
              (-0.0250 -0.0250 0.0250 0.0250)
            )
          )
      )
      (placement_goal_region
          (:target living_room_table)
          (:ranges (
              (-0.1400 -0.1700 0.1400 0.1900)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    bbq_sauce_1 - bbq_sauce
    ketchup_1 - ketchup
    basket_right - basket
    wooden_tray_left - wooden_tray
  )

  (:obj_of_interest
    ketchup_1
    basket_right
  )

  (:init
    (On basket_right living_room_table_basket_right_right_region)
    (On wooden_tray_left living_room_table_wooden_tray_left_left_region)
    (On ketchup_1 living_room_table_target_object_init_region)
    (On bbq_sauce_1 living_room_table_distractor_object_init_region)
  )

  (:goal
    (And (AtXY ketchup_1 living_room_table_placement_goal_region))
  )

)
