(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the cookies belonging to user_008 and place it at the front of the microwave)
    (:regions
      (microwave_right_right_region
          (:target kitchen_table)
          (:ranges (
              (-0.0200 0.2800 0.0200 0.3200)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (basket_left_left_region
          (:target kitchen_table)
          (:ranges (
              (-0.0200 -0.2400 0.0200 -0.2000)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (target_object_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (distractor_object_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.2050 -0.0250 -0.1550 0.0250)
            )
          )
      )
      (placement_goal_region
          (:target kitchen_table)
          (:ranges (
              (-0.0200 0.1000 0.2600 0.5000)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    microwave_right - microwave
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    cookies_1 - cookies
    basket_left - basket
  )

  (:obj_of_interest
    cookies_1
    microwave_right
  )

  (:init
    (On microwave_right kitchen_table_microwave_right_right_region)
    (On basket_left kitchen_table_basket_left_left_region)
    (On cookies_1 kitchen_table_target_object_init_region)
    (On akita_black_bowl_1 kitchen_table_distractor_object_init_region)
  )

  (:goal
    (And (AtXY cookies_1 kitchen_table_placement_goal_region))
  )

)
