(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the cream_cheese belonging to user_012 and place it at the in of the wooden_tray)
    (:regions
      (wooden_tray_left_left_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 -0.2400 0.0200 -0.2000)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (flat_stove_right_right_region
          (:target living_room_table)
          (:ranges (
              (-0.1400 0.2000 -0.1000 0.2400)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (target_object_init_region
          (:target living_room_table)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (distractor_object_init_region
          (:target living_room_table)
          (:ranges (
              (-0.2050 -0.0250 -0.1550 0.0250)
            )
          )
      )
      (contain_region
          (:target wooden_tray_left)
      )
    )

  (:fixtures
    living_room_table - living_room_table
    flat_stove_right - flat_stove
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    cream_cheese_1 - cream_cheese
    wooden_tray_left - wooden_tray
  )

  (:obj_of_interest
    cream_cheese_1
    wooden_tray_left
  )

  (:init
    (On wooden_tray_left living_room_table_wooden_tray_left_left_region)
    (On flat_stove_right living_room_table_flat_stove_right_right_region)
    (On cream_cheese_1 living_room_table_target_object_init_region)
    (On akita_black_bowl_1 living_room_table_distractor_object_init_region)
  )

  (:goal
    (And (In cream_cheese_1 wooden_tray_left_contain_region))
  )

)
