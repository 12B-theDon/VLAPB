(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the cream_cheese belonging to user_012 and place it at the in of the wooden_tray)
    (:regions
      (wooden_tray_right_right_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 0.2000 0.0200 0.2400)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (wooden_cabinet_left_left_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 -0.3200 0.0200 -0.2800)
            )
          )
          (:yaw_rotation (
              (-3.1416 -3.1416)
            )
          )
      )
      (target_object_init_region
          (:target living_room_table)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (distractor_object_init_region
          (:target living_room_table)
          (:ranges (
              (-0.2050 -0.0250 -0.1550 0.0250)
            )
          )
      )
      (contain_region
          (:target wooden_tray_right)
      )
    )

  (:fixtures
    living_room_table - living_room_table
    wooden_cabinet_left - wooden_cabinet
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    cream_cheese_1 - cream_cheese
    wooden_tray_right - wooden_tray
  )

  (:obj_of_interest
    cream_cheese_1
    wooden_tray_right
  )

  (:init
    (On wooden_tray_right living_room_table_wooden_tray_right_right_region)
    (On wooden_cabinet_left living_room_table_wooden_cabinet_left_left_region)
    (On cream_cheese_1 living_room_table_target_object_init_region)
    (On akita_black_bowl_1 living_room_table_distractor_object_init_region)
  )

  (:goal
    (And (In cream_cheese_1 wooden_tray_right_contain_region))
  )

)
