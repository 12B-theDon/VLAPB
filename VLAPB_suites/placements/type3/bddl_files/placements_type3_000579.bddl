(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the cream_cheese belonging to user_012 and place it at the back of the wooden_tray)
    (:regions
      (wooden_tray_right_right_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 0.2000 0.0200 0.2400)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (white_cabinet_left_left_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 -0.3200 0.0200 -0.2800)
            )
          )
          (:yaw_rotation (
              (-3.1416 -3.1416)
            )
          )
      )
      (target_object_init_region
          (:target living_room_table)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (distractor_object_init_region
          (:target living_room_table)
          (:ranges (
              (0.0950 -0.1450 0.1450 -0.0950)
            )
          )
      )
      (placement_goal_region
          (:target living_room_table)
          (:ranges (
              (-0.2600 0.0200 0.0200 0.4200)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
    white_cabinet_left - white_cabinet
  )

  (:objects
    butter_1 - butter
    cream_cheese_1 - cream_cheese
    wooden_tray_right - wooden_tray
  )

  (:obj_of_interest
    cream_cheese_1
    wooden_tray_right
  )

  (:init
    (On wooden_tray_right living_room_table_wooden_tray_right_right_region)
    (On white_cabinet_left living_room_table_white_cabinet_left_left_region)
    (On cream_cheese_1 living_room_table_target_object_init_region)
    (On butter_1 living_room_table_distractor_object_init_region)
  )

  (:goal
    (And (AtXY cream_cheese_1 living_room_table_placement_goal_region))
  )

)
