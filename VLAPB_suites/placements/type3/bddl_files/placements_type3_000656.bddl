(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the butter belonging to user_015 and place it at the in of the basket)
    (:regions
      (basket_left_left_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 -0.2400 0.0200 -0.2000)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (wooden_cabinet_right_right_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 0.2800 0.0200 0.3200)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (target_object_init_region
          (:target living_room_table)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (distractor_object_init_region
          (:target living_room_table)
          (:ranges (
              (-0.0250 -0.0250 0.0250 0.0250)
            )
          )
      )
      (contain_region
          (:target basket_left)
      )
    )

  (:fixtures
    living_room_table - living_room_table
    wooden_cabinet_right - wooden_cabinet
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    butter_1 - butter
    basket_left - basket
  )

  (:obj_of_interest
    butter_1
    basket_left
  )

  (:init
    (On basket_left living_room_table_basket_left_left_region)
    (On wooden_cabinet_right living_room_table_wooden_cabinet_right_right_region)
    (On butter_1 living_room_table_target_object_init_region)
    (On alphabet_soup_1 living_room_table_distractor_object_init_region)
  )

  (:goal
    (And (In butter_1 basket_left_contain_region))
  )

)
