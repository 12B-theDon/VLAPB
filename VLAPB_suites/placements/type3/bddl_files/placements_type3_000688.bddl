(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the milk belonging to user_014 and place it at the in of the wooden_tray)
    (:regions
      (wooden_tray_left_left_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 -0.2400 0.0200 -0.2000)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (basket_right_right_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 0.2000 0.0200 0.2400)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (target_object_init_region
          (:target living_room_table)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (distractor_object_init_region
          (:target living_room_table)
          (:ranges (
              (-0.2050 -0.0250 -0.1550 0.0250)
            )
          )
      )
      (contain_region
          (:target wooden_tray_left)
      )
    )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    milk_1 - milk
    wooden_tray_left - wooden_tray
    basket_right - basket
  )

  (:obj_of_interest
    milk_1
    wooden_tray_left
  )

  (:init
    (On wooden_tray_left living_room_table_wooden_tray_left_left_region)
    (On basket_right living_room_table_basket_right_right_region)
    (On milk_1 living_room_table_target_object_init_region)
    (On akita_black_bowl_1 living_room_table_distractor_object_init_region)
  )

  (:goal
    (And (In milk_1 wooden_tray_left_contain_region))
  )

)
