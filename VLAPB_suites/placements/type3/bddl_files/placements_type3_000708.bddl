(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the cookies belonging to user_015 and place it at the back of the wooden_tray)
    (:regions
      (wooden_tray_left_left_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 -0.2400 0.0200 -0.2000)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (microwave_right_right_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 0.2800 0.0200 0.3200)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (target_object_init_region
          (:target living_room_table)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (distractor_object_init_region
          (:target living_room_table)
          (:ranges (
              (0.0950 -0.1450 0.1450 -0.0950)
            )
          )
      )
      (placement_goal_region
          (:target living_room_table)
          (:ranges (
              (-0.1900 -0.3000 -0.0500 -0.1400)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
    microwave_right - microwave
  )

  (:objects
    bbq_sauce_1 - bbq_sauce
    cookies_1 - cookies
    wooden_tray_left - wooden_tray
  )

  (:obj_of_interest
    cookies_1
    wooden_tray_left
  )

  (:init
    (On wooden_tray_left living_room_table_wooden_tray_left_left_region)
    (On microwave_right living_room_table_microwave_right_right_region)
    (On cookies_1 living_room_table_target_object_init_region)
    (On bbq_sauce_1 living_room_table_distractor_object_init_region)
  )

  (:goal
    (And (AtXY cookies_1 living_room_table_placement_goal_region))
  )

)
