(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the butter belonging to user_016 and place it at the in of the wooden_cabinet)
    (:regions
      (wooden_cabinet_right_right_region
          (:target kitchen_table)
          (:ranges (
              (-0.0200 0.2800 0.0200 0.3200)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (basket_left_left_region
          (:target kitchen_table)
          (:ranges (
              (-0.0200 -0.2400 0.0200 -0.2000)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (target_object_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (distractor_object_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.2050 -0.0250 -0.1550 0.0250)
            )
          )
      )
      (contain_region
          (:target wooden_cabinet_right)
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    wooden_cabinet_right - wooden_cabinet
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    butter_1 - butter
    basket_left - basket
  )

  (:obj_of_interest
    butter_1
    wooden_cabinet_right
  )

  (:init
    (On wooden_cabinet_right kitchen_table_wooden_cabinet_right_right_region)
    (On basket_left kitchen_table_basket_left_left_region)
    (On butter_1 kitchen_table_target_object_init_region)
    (On akita_black_bowl_1 kitchen_table_distractor_object_init_region)
  )

  (:goal
    (And (In butter_1 wooden_cabinet_right_contain_region))
  )

)
