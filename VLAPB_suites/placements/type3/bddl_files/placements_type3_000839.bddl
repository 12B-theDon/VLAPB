(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the glazed_rim_porcelain_ramekin belonging to user_016 and place it at the in of the wooden_tray)
    (:regions
      (wooden_tray_left_left_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 -0.2400 0.0200 -0.2000)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (microwave_right_right_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 0.2800 0.0200 0.3200)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (target_object_init_region
          (:target living_room_table)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (distractor_object_init_region
          (:target living_room_table)
          (:ranges (
              (-0.0250 -0.0250 0.0250 0.0250)
            )
          )
      )
      (contain_region
          (:target wooden_tray_left)
      )
    )

  (:fixtures
    living_room_table - living_room_table
    microwave_right - microwave
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    wooden_tray_left - wooden_tray
  )

  (:obj_of_interest
    glazed_rim_porcelain_ramekin_1
    wooden_tray_left
  )

  (:init
    (On wooden_tray_left living_room_table_wooden_tray_left_left_region)
    (On microwave_right living_room_table_microwave_right_right_region)
    (On glazed_rim_porcelain_ramekin_1 living_room_table_target_object_init_region)
    (On alphabet_soup_1 living_room_table_distractor_object_init_region)
  )

  (:goal
    (And (In glazed_rim_porcelain_ramekin_1 wooden_tray_left_contain_region))
  )

)
