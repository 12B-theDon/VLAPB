(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the chocolate_pudding belonging to user_018 and place it at the in of the wooden_tray)
    (:regions
      (wooden_tray_right_right_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 0.2000 0.0200 0.2400)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (microwave_left_left_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 -0.3200 0.0200 -0.2800)
            )
          )
          (:yaw_rotation (
              (-3.1416 -3.1416)
            )
          )
      )
      (target_object_init_region
          (:target living_room_table)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (distractor_object_init_region
          (:target living_room_table)
          (:ranges (
              (0.0950 -0.1450 0.1450 -0.0950)
            )
          )
      )
      (contain_region
          (:target wooden_tray_right)
      )
    )

  (:fixtures
    living_room_table - living_room_table
    microwave_left - microwave
  )

  (:objects
    bbq_sauce_1 - bbq_sauce
    chocolate_pudding_1 - chocolate_pudding
    wooden_tray_right - wooden_tray
  )

  (:obj_of_interest
    chocolate_pudding_1
    wooden_tray_right
  )

  (:init
    (On wooden_tray_right living_room_table_wooden_tray_right_right_region)
    (On microwave_left living_room_table_microwave_left_left_region)
    (On chocolate_pudding_1 living_room_table_target_object_init_region)
    (On bbq_sauce_1 living_room_table_distractor_object_init_region)
  )

  (:goal
    (And (In chocolate_pudding_1 wooden_tray_right_contain_region))
  )

)
