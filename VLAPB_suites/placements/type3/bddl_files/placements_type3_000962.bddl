(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the salad_dressing belonging to user_019 and place it at the bottom of the wooden_cabinet)
    (:regions
      (wooden_cabinet_right_right_region
          (:target kitchen_table)
          (:ranges (
              (-0.0200 0.2800 0.0200 0.3200)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (flat_stove_left_left_region
          (:target kitchen_table)
          (:ranges (
              (-0.1400 -0.2400 -0.1000 -0.2000)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (target_object_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (distractor_object_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.0250 -0.0250 0.0250 0.0250)
            )
          )
      )
      (bottom_region
          (:target wooden_cabinet_right)
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    wooden_cabinet_right - wooden_cabinet
    flat_stove_left - flat_stove
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    salad_dressing_1 - salad_dressing
  )

  (:obj_of_interest
    salad_dressing_1
    wooden_cabinet_right
  )

  (:init
    (On wooden_cabinet_right kitchen_table_wooden_cabinet_right_right_region)
    (On flat_stove_left kitchen_table_flat_stove_left_left_region)
    (On salad_dressing_1 kitchen_table_target_object_init_region)
    (On alphabet_soup_1 kitchen_table_distractor_object_init_region)
  )

  (:goal
    (And (In salad_dressing_1 wooden_cabinet_right_bottom_region))
  )

)
