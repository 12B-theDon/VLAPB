(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the ketchup belonging to user_020 and place it at the back of the basket)
    (:regions
      (basket_left_left_region
          (:target floor)
          (:ranges (
              (-0.0200 -0.2400 0.0200 -0.2000)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (flat_stove_right_right_region
          (:target floor)
          (:ranges (
              (-0.1400 0.2000 -0.1000 0.2400)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (target_object_init_region
          (:target floor)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (distractor_object_init_region
          (:target floor)
          (:ranges (
              (0.0950 -0.1450 0.1450 -0.0950)
            )
          )
      )
      (placement_goal_region
          (:target floor)
          (:ranges (
              (-0.2600 -0.4200 0.0200 -0.0200)
            )
          )
      )
    )

  (:fixtures
    floor - floor
    flat_stove_right - flat_stove
  )

  (:objects
    bbq_sauce_1 - bbq_sauce
    ketchup_1 - ketchup
    basket_left - basket
  )

  (:obj_of_interest
    ketchup_1
    basket_left
  )

  (:init
    (On basket_left floor_basket_left_left_region)
    (On flat_stove_right floor_flat_stove_right_right_region)
    (On ketchup_1 floor_target_object_init_region)
    (On bbq_sauce_1 floor_distractor_object_init_region)
  )

  (:goal
    (And (AtXY ketchup_1 floor_placement_goal_region))
  )

)
