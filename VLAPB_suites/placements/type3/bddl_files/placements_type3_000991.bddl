(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the ketchup belonging to user_020 and place it at the back of the basket)
    (:regions
      (basket_right_right_region
          (:target floor)
          (:ranges (
              (-0.0200 0.2000 0.0200 0.2400)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (flat_stove_left_left_region
          (:target floor)
          (:ranges (
              (-0.1400 -0.2400 -0.1000 -0.2000)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (target_object_init_region
          (:target floor)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (distractor_object_init_region
          (:target floor)
          (:ranges (
              (-0.2050 -0.0250 -0.1550 0.0250)
            )
          )
      )
      (placement_goal_region
          (:target floor)
          (:ranges (
              (-0.2600 0.0200 0.0200 0.4200)
            )
          )
      )
    )

  (:fixtures
    floor - floor
    flat_stove_left - flat_stove
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    ketchup_1 - ketchup
    basket_right - basket
  )

  (:obj_of_interest
    ketchup_1
    basket_right
  )

  (:init
    (On basket_right floor_basket_right_right_region)
    (On flat_stove_left floor_flat_stove_left_left_region)
    (On ketchup_1 floor_target_object_init_region)
    (On akita_black_bowl_1 floor_distractor_object_init_region)
  )

  (:goal
    (And (AtXY ketchup_1 floor_placement_goal_region))
  )

)
