(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the alphabet_soup belonging to user_001 and place it at the front of the basket)
    (:regions
      (basket_left_left_region
          (:target floor)
          (:ranges (
              (-0.0200 -0.2400 0.0200 -0.2000)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (microwave_right_right_region
          (:target floor)
          (:ranges (
              (-0.0200 0.2800 0.0200 0.3200)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (target_object_init_region
          (:target floor)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (placement_goal_region
          (:target floor)
          (:ranges (
              (-0.0200 -0.4200 0.2600 -0.0200)
            )
          )
      )
    )

  (:fixtures
    floor - floor
    microwave_right - microwave
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    basket_left - basket
  )

  (:obj_of_interest
    alphabet_soup_1
    basket_left
  )

  (:init
    (On basket_left floor_basket_left_left_region)
    (On microwave_right floor_microwave_right_right_region)
    (On alphabet_soup_1 floor_target_object_init_region)
  )

  (:goal
    (And (AtXY alphabet_soup_1 floor_placement_goal_region))
  )

)
