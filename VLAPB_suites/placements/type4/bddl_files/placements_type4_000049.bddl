(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the akita_black_bowl belonging to user_003 and place it at the bottom_left of the wooden_cabinet)
    (:regions
      (wooden_cabinet_right_right_region
          (:target kitchen_table)
          (:ranges (
              (-0.0200 0.2800 0.0200 0.3200)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (flat_stove_left_left_region
          (:target kitchen_table)
          (:ranges (
              (-0.1400 -0.2400 -0.1000 -0.2000)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (target_object_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (bottom_region
          (:target wooden_cabinet_right)
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    wooden_cabinet_right - wooden_cabinet
    flat_stove_left - flat_stove
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
  )

  (:obj_of_interest
    akita_black_bowl_1
    wooden_cabinet_right
  )

  (:init
    (On wooden_cabinet_right kitchen_table_wooden_cabinet_right_right_region)
    (On flat_stove_left kitchen_table_flat_stove_left_left_region)
    (On akita_black_bowl_1 kitchen_table_target_object_init_region)
  )

  (:goal
    (And (In akita_black_bowl_1 wooden_cabinet_right_bottom_region))
  )

)
