(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the akita_black_bowl belonging to user_003 and place it at the in of the basket)
    (:regions
      (basket_right_right_region
          (:target floor)
          (:ranges (
              (-0.0200 0.2000 0.0200 0.2400)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (wooden_tray_left_left_region
          (:target floor)
          (:ranges (
              (-0.0200 -0.2400 0.0200 -0.2000)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (target_object_init_region
          (:target floor)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (contain_region
          (:target basket_right)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    basket_right - basket
    wooden_tray_left - wooden_tray
  )

  (:obj_of_interest
    akita_black_bowl_1
    basket_right
  )

  (:init
    (On basket_right floor_basket_right_right_region)
    (On wooden_tray_left floor_wooden_tray_left_left_region)
    (On akita_black_bowl_1 floor_target_object_init_region)
  )

  (:goal
    (And (In akita_black_bowl_1 basket_right_contain_region))
  )

)
