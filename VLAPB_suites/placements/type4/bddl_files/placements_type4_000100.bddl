(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the salad_dressing belonging to user_005 and place it at the back of the microwave)
    (:regions
      (microwave_right_right_region
          (:target kitchen_table)
          (:ranges (
              (-0.0200 0.2800 0.0200 0.3200)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (wooden_tray_left_left_region
          (:target kitchen_table)
          (:ranges (
              (-0.0200 -0.2400 0.0200 -0.2000)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (target_object_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (placement_goal_region
          (:target kitchen_table)
          (:ranges (
              (-0.2600 0.1000 0.0200 0.5000)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    microwave_right - microwave
  )

  (:objects
    salad_dressing_1 - salad_dressing
    wooden_tray_left - wooden_tray
  )

  (:obj_of_interest
    salad_dressing_1
    microwave_right
  )

  (:init
    (On microwave_right kitchen_table_microwave_right_right_region)
    (On wooden_tray_left kitchen_table_wooden_tray_left_left_region)
    (On salad_dressing_1 kitchen_table_target_object_init_region)
  )

  (:goal
    (And (AtXY salad_dressing_1 kitchen_table_placement_goal_region))
  )

)
