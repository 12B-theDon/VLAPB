(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the alphabet_soup belonging to user_009 and place it at the in of the basket)
    (:regions
      (basket_left_left_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 -0.2400 0.0200 -0.2000)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (wooden_two_layer_shelf_right_right_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 0.2800 0.0200 0.3200)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (target_object_init_region
          (:target living_room_table)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (contain_region
          (:target basket_left)
      )
    )

  (:fixtures
    living_room_table - living_room_table
    wooden_two_layer_shelf_right - wooden_two_layer_shelf
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    basket_left - basket
  )

  (:obj_of_interest
    alphabet_soup_1
    basket_left
  )

  (:init
    (On basket_left living_room_table_basket_left_left_region)
    (On wooden_two_layer_shelf_right living_room_table_wooden_two_layer_shelf_right_right_region)
    (On alphabet_soup_1 living_room_table_target_object_init_region)
  )

  (:goal
    (And (In alphabet_soup_1 basket_left_contain_region))
  )

)
