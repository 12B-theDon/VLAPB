(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the butter belonging to user_015 and place it at the in of the basket)
    (:regions
      (basket_left_left_region
          (:target living_room_table)
          (:ranges (
              (-0.0200 -0.2400 0.0200 -0.2000)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (flat_stove_right_right_region
          (:target living_room_table)
          (:ranges (
              (-0.1400 0.2000 -0.1000 0.2400)
            )
          )
          (:yaw_rotation (
              (0.0000 0.0000)
            )
          )
      )
      (target_object_init_region
          (:target living_room_table)
          (:ranges (
              (-0.1800 -0.0200 -0.1300 0.0300)
            )
          )
      )
      (contain_region
          (:target basket_left)
      )
    )

  (:fixtures
    living_room_table - living_room_table
    flat_stove_right - flat_stove
  )

  (:objects
    butter_1 - butter
    basket_left - basket
  )

  (:obj_of_interest
    butter_1
    basket_left
  )

  (:init
    (On basket_left living_room_table_basket_left_left_region)
    (On flat_stove_right living_room_table_flat_stove_right_right_region)
    (On butter_1 living_room_table_target_object_init_region)
  )

  (:goal
    (And (In butter_1 basket_left_contain_region))
  )

)
