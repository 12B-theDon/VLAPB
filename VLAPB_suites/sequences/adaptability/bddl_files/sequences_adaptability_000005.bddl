(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language After user_005's sequence preference changes from salad_dressing, red_coffee_mug, akita_black_bowl to akita_black_bowl, red_coffee_mug, salad_dressing, put the same objects into the wooden_tray in the new order: akita_black_bowl, red_coffee_mug, salad_dressing)
    (:regions
      (wooden_tray_region
          (:target study_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target study_table)
          (:ranges (
              (0.0940 0.1862 0.1440 0.2362)
            )
          )
      )
      (object_init_region_1
          (:target study_table)
          (:ranges (
              (-0.2762 0.0166 -0.2262 0.0666)
            )
          )
      )
      (object_init_region_2
          (:target study_table)
          (:ranges (
              (0.0410 -0.2007 0.0910 -0.1507)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    study_table - table
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    red_coffee_mug_1 - red_coffee_mug
    salad_dressing_1 - salad_dressing
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    akita_black_bowl_1 red_coffee_mug_1 salad_dressing_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 study_table_wooden_tray_region)
    (On akita_black_bowl_1 study_table_object_init_region_0)
    (On red_coffee_mug_1 study_table_object_init_region_1)
    (On salad_dressing_1 study_table_object_init_region_2)
  )

  (:goal
    (And (In akita_black_bowl_1 wooden_tray_1_contain_region) (In red_coffee_mug_1 wooden_tray_1_contain_region) (In salad_dressing_1 wooden_tray_1_contain_region))
  )

)
