(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language After user_007's sequence preference changes from alphabet_soup, glazed_rim_porcelain_ramekin, chocolate_pudding to chocolate_pudding, alphabet_soup, glazed_rim_porcelain_ramekin, put the same objects into the wooden_tray in the new order: chocolate_pudding, alphabet_soup, glazed_rim_porcelain_ramekin)
    (:regions
      (wooden_tray_region
          (:target kitchen_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.0212 0.1600 0.0712 0.2100)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.2304 -0.0466 -0.1804 0.0034)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (0.1211 -0.2261 0.1711 -0.1761)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    kitchen_table - table
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    chocolate_pudding_1 - chocolate_pudding
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    chocolate_pudding_1 alphabet_soup_1 glazed_rim_porcelain_ramekin_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 kitchen_table_wooden_tray_region)
    (On alphabet_soup_1 kitchen_table_object_init_region_0)
    (On chocolate_pudding_1 kitchen_table_object_init_region_1)
    (On glazed_rim_porcelain_ramekin_1 kitchen_table_object_init_region_2)
  )

  (:goal
    (And (In chocolate_pudding_1 wooden_tray_1_contain_region) (In alphabet_soup_1 wooden_tray_1_contain_region) (In glazed_rim_porcelain_ramekin_1 wooden_tray_1_contain_region))
  )

)
