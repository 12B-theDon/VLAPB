(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language After user_008's sequence preference changes from cookies, alphabet_soup, ketchup to alphabet_soup, ketchup, cookies, put the same objects into the wooden_tray in the new order: alphabet_soup, ketchup, cookies)
    (:regions
      (wooden_tray_region
          (:target kitchen_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.0433 0.1549 0.0933 0.2049)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.2529 -0.0219 -0.2029 0.0281)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (0.0920 -0.2342 0.1420 -0.1842)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    kitchen_table - table
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    cookies_1 - cookies
    ketchup_1 - ketchup
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    alphabet_soup_1 ketchup_1 cookies_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 kitchen_table_wooden_tray_region)
    (On alphabet_soup_1 kitchen_table_object_init_region_0)
    (On cookies_1 kitchen_table_object_init_region_1)
    (On ketchup_1 kitchen_table_object_init_region_2)
  )

  (:goal
    (And (In alphabet_soup_1 wooden_tray_1_contain_region) (In ketchup_1 wooden_tray_1_contain_region) (In cookies_1 wooden_tray_1_contain_region))
  )

)
