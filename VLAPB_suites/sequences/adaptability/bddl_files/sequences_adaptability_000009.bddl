(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language After user_009's sequence preference changes from alphabet_soup, cream_cheese, milk to milk, cream_cheese, alphabet_soup, put the same objects into the wooden_tray in the new order: milk, cream_cheese, alphabet_soup)
    (:regions
      (wooden_tray_region
          (:target living_room_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.0501 0.2060 0.1001 0.2560)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.2506 -0.0328 -0.2006 0.0172)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (0.1128 -0.2457 0.1628 -0.1957)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    living_room_table - table
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    cream_cheese_1 - cream_cheese
    milk_1 - milk
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    milk_1 cream_cheese_1 alphabet_soup_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 living_room_table_wooden_tray_region)
    (On alphabet_soup_1 living_room_table_object_init_region_0)
    (On cream_cheese_1 living_room_table_object_init_region_1)
    (On milk_1 living_room_table_object_init_region_2)
  )

  (:goal
    (And (In milk_1 wooden_tray_1_contain_region) (In cream_cheese_1 wooden_tray_1_contain_region) (In alphabet_soup_1 wooden_tray_1_contain_region))
  )

)
