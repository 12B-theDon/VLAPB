(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language After user_011's sequence preference changes from bbq_sauce, cookies, glazed_rim_porcelain_ramekin to glazed_rim_porcelain_ramekin, cookies, bbq_sauce, put the same objects into the wooden_tray in the new order: glazed_rim_porcelain_ramekin, cookies, bbq_sauce)
    (:regions
      (wooden_tray_region
          (:target study_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target study_table)
          (:ranges (
              (0.0316 0.1926 0.0816 0.2426)
            )
          )
      )
      (object_init_region_1
          (:target study_table)
          (:ranges (
              (-0.2620 -0.0474 -0.2120 0.0026)
            )
          )
      )
      (object_init_region_2
          (:target study_table)
          (:ranges (
              (0.1162 -0.2236 0.1662 -0.1736)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    study_table - table
  )

  (:objects
    bbq_sauce_1 - bbq_sauce
    cookies_1 - cookies
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    glazed_rim_porcelain_ramekin_1 cookies_1 bbq_sauce_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 study_table_wooden_tray_region)
    (On bbq_sauce_1 study_table_object_init_region_0)
    (On cookies_1 study_table_object_init_region_1)
    (On glazed_rim_porcelain_ramekin_1 study_table_object_init_region_2)
  )

  (:goal
    (And (In glazed_rim_porcelain_ramekin_1 wooden_tray_1_contain_region) (In cookies_1 wooden_tray_1_contain_region) (In bbq_sauce_1 wooden_tray_1_contain_region))
  )

)
