(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language After user_014's sequence preference changes from butter, chocolate_pudding, milk to milk, chocolate_pudding, butter, put the same objects into the wooden_tray in the new order: milk, chocolate_pudding, butter)
    (:regions
      (wooden_tray_region
          (:target kitchen_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.0499 0.1943 0.0999 0.2443)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.2658 -0.0298 -0.2158 0.0202)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (0.0781 -0.1957 0.1281 -0.1457)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    kitchen_table - table
  )

  (:objects
    butter_1 - butter
    chocolate_pudding_1 - chocolate_pudding
    milk_1 - milk
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    milk_1 chocolate_pudding_1 butter_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 kitchen_table_wooden_tray_region)
    (On butter_1 kitchen_table_object_init_region_0)
    (On chocolate_pudding_1 kitchen_table_object_init_region_1)
    (On milk_1 kitchen_table_object_init_region_2)
  )

  (:goal
    (And (In milk_1 wooden_tray_1_contain_region) (In chocolate_pudding_1 wooden_tray_1_contain_region) (In butter_1 wooden_tray_1_contain_region))
  )

)
