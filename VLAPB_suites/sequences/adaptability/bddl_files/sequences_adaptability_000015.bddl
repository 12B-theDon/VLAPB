(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language After user_015's sequence preference changes from butter, new_salad_dressing, cookies to cookies, butter, new_salad_dressing, put the same objects into the wooden_tray in the new order: cookies, butter, new_salad_dressing)
    (:regions
      (wooden_tray_region
          (:target living_room_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.0948 0.1752 0.1448 0.2252)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.2601 0.0202 -0.2101 0.0702)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (0.0563 -0.2599 0.1063 -0.2099)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    living_room_table - table
  )

  (:objects
    butter_1 - butter
    cookies_1 - cookies
    new_salad_dressing_1 - new_salad_dressing
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    cookies_1 butter_1 new_salad_dressing_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 living_room_table_wooden_tray_region)
    (On butter_1 living_room_table_object_init_region_0)
    (On cookies_1 living_room_table_object_init_region_1)
    (On new_salad_dressing_1 living_room_table_object_init_region_2)
  )

  (:goal
    (And (In cookies_1 wooden_tray_1_contain_region) (In butter_1 wooden_tray_1_contain_region) (In new_salad_dressing_1 wooden_tray_1_contain_region))
  )

)
