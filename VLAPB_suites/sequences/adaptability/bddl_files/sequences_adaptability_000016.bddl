(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language After user_016's sequence preference changes from cream_cheese, butter, glazed_rim_porcelain_ramekin to butter, glazed_rim_porcelain_ramekin, cream_cheese, put the same objects into the wooden_tray in the new order: butter, glazed_rim_porcelain_ramekin, cream_cheese)
    (:regions
      (wooden_tray_region
          (:target living_room_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.0493 0.1794 0.0993 0.2294)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.2265 -0.0251 -0.1765 0.0249)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (0.0962 -0.2346 0.1462 -0.1846)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    living_room_table - table
  )

  (:objects
    butter_1 - butter
    cream_cheese_1 - cream_cheese
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    butter_1 glazed_rim_porcelain_ramekin_1 cream_cheese_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 living_room_table_wooden_tray_region)
    (On butter_1 living_room_table_object_init_region_0)
    (On cream_cheese_1 living_room_table_object_init_region_1)
    (On glazed_rim_porcelain_ramekin_1 living_room_table_object_init_region_2)
  )

  (:goal
    (And (In butter_1 wooden_tray_1_contain_region) (In glazed_rim_porcelain_ramekin_1 wooden_tray_1_contain_region) (In cream_cheese_1 wooden_tray_1_contain_region))
  )

)
