(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language After user_019's sequence preference changes from milk, salad_dressing, cookies to cookies, salad_dressing, milk, put the same objects into the wooden_tray in the new order: cookies, salad_dressing, milk)
    (:regions
      (wooden_tray_region
          (:target kitchen_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.0598 0.2189 0.1098 0.2689)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.2616 -0.0284 -0.2116 0.0216)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (0.0987 -0.2324 0.1487 -0.1824)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    kitchen_table - table
  )

  (:objects
    cookies_1 - cookies
    milk_1 - milk
    salad_dressing_1 - salad_dressing
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    cookies_1 salad_dressing_1 milk_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 kitchen_table_wooden_tray_region)
    (On cookies_1 kitchen_table_object_init_region_0)
    (On milk_1 kitchen_table_object_init_region_1)
    (On salad_dressing_1 kitchen_table_object_init_region_2)
  )

  (:goal
    (And (In cookies_1 wooden_tray_1_contain_region) (In salad_dressing_1 wooden_tray_1_contain_region) (In milk_1 wooden_tray_1_contain_region))
  )

)
