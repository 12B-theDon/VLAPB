(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Put the objects belonging to user_002 into the wooden_tray in this order: cream_cheese, cookies, akita_black_bowl)
    (:regions
      (wooden_tray_region
          (:target study_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target study_table)
          (:ranges (
              (0.0625 0.1863 0.1125 0.2363)
            )
          )
      )
      (object_init_region_1
          (:target study_table)
          (:ranges (
              (-0.2123 -0.0168 -0.1623 0.0332)
            )
          )
      )
      (object_init_region_2
          (:target study_table)
          (:ranges (
              (0.0920 -0.2497 0.1420 -0.1997)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    study_table - table
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    cookies_1 - cookies
    cream_cheese_1 - cream_cheese
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    cream_cheese_1 cookies_1 akita_black_bowl_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 study_table_wooden_tray_region)
    (On akita_black_bowl_1 study_table_object_init_region_0)
    (On cookies_1 study_table_object_init_region_1)
    (On cream_cheese_1 study_table_object_init_region_2)
  )

  (:goal
    (And (In cream_cheese_1 wooden_tray_1_contain_region) (In cookies_1 wooden_tray_1_contain_region) (In akita_black_bowl_1 wooden_tray_1_contain_region))
  )

)
