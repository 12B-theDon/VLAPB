(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Put the objects belonging to user_002 into the wooden_tray in this order: cream_cheese, cookies, chocolate_pudding)
    (:regions
      (wooden_tray_region
          (:target study_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target study_table)
          (:ranges (
              (0.0426 0.1861 0.0926 0.2361)
            )
          )
      )
      (object_init_region_1
          (:target study_table)
          (:ranges (
              (-0.2198 -0.0327 -0.1698 0.0173)
            )
          )
      )
      (object_init_region_2
          (:target study_table)
          (:ranges (
              (0.0952 -0.2156 0.1452 -0.1656)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    study_table - table
  )

  (:objects
    chocolate_pudding_1 - chocolate_pudding
    cookies_1 - cookies
    cream_cheese_1 - cream_cheese
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    cream_cheese_1 cookies_1 chocolate_pudding_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 study_table_wooden_tray_region)
    (On chocolate_pudding_1 study_table_object_init_region_0)
    (On cookies_1 study_table_object_init_region_1)
    (On cream_cheese_1 study_table_object_init_region_2)
  )

  (:goal
    (And (In cream_cheese_1 wooden_tray_1_contain_region) (In cookies_1 wooden_tray_1_contain_region) (In chocolate_pudding_1 wooden_tray_1_contain_region))
  )

)
