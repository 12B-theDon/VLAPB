(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Put the objects belonging to user_003 into the wooden_tray in this order: akita_black_bowl, milk, ketchup)
    (:regions
      (wooden_tray_region
          (:target kitchen_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.0684 0.1377 0.1184 0.1877)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.2650 0.0168 -0.2150 0.0668)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (0.0401 -0.2027 0.0901 -0.1527)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    kitchen_table - table
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    ketchup_1 - ketchup
    milk_1 - milk
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    akita_black_bowl_1 milk_1 ketchup_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 kitchen_table_wooden_tray_region)
    (On akita_black_bowl_1 kitchen_table_object_init_region_0)
    (On ketchup_1 kitchen_table_object_init_region_1)
    (On milk_1 kitchen_table_object_init_region_2)
  )

  (:goal
    (And (In akita_black_bowl_1 wooden_tray_1_contain_region) (In milk_1 wooden_tray_1_contain_region) (In ketchup_1 wooden_tray_1_contain_region))
  )

)
