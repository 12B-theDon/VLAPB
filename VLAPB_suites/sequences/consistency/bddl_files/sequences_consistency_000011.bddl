(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Put the objects belonging to user_004 into the wooden_tray in this order: orange_juice, porcelain_mug, akita_black_bowl)
    (:regions
      (wooden_tray_region
          (:target study_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target study_table)
          (:ranges (
              (0.0544 0.1620 0.1044 0.2120)
            )
          )
      )
      (object_init_region_1
          (:target study_table)
          (:ranges (
              (-0.2869 -0.0112 -0.2369 0.0388)
            )
          )
      )
      (object_init_region_2
          (:target study_table)
          (:ranges (
              (0.0876 -0.2461 0.1376 -0.1961)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    study_table - table
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    orange_juice_1 - orange_juice
    porcelain_mug_1 - porcelain_mug
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    orange_juice_1 porcelain_mug_1 akita_black_bowl_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 study_table_wooden_tray_region)
    (On akita_black_bowl_1 study_table_object_init_region_0)
    (On orange_juice_1 study_table_object_init_region_1)
    (On porcelain_mug_1 study_table_object_init_region_2)
  )

  (:goal
    (And (In orange_juice_1 wooden_tray_1_contain_region) (In porcelain_mug_1 wooden_tray_1_contain_region) (In akita_black_bowl_1 wooden_tray_1_contain_region))
  )

)
