(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Put the objects belonging to user_005 into the wooden_tray in this order: tomato_sauce, salad_dressing, red_coffee_mug)
    (:regions
      (wooden_tray_region
          (:target living_room_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.0850 0.2069 0.1350 0.2569)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.2608 -0.0028 -0.2108 0.0472)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (0.0813 -0.2571 0.1313 -0.2071)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    living_room_table - table
  )

  (:objects
    red_coffee_mug_1 - red_coffee_mug
    salad_dressing_1 - salad_dressing
    tomato_sauce_1 - tomato_sauce
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    tomato_sauce_1 salad_dressing_1 red_coffee_mug_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 living_room_table_wooden_tray_region)
    (On red_coffee_mug_1 living_room_table_object_init_region_0)
    (On salad_dressing_1 living_room_table_object_init_region_1)
    (On tomato_sauce_1 living_room_table_object_init_region_2)
  )

  (:goal
    (And (In tomato_sauce_1 wooden_tray_1_contain_region) (In salad_dressing_1 wooden_tray_1_contain_region) (In red_coffee_mug_1 wooden_tray_1_contain_region))
  )

)
