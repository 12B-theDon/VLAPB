(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Put the objects belonging to user_008 into the wooden_tray in this order: ketchup, alphabet_soup, orange_juice)
    (:regions
      (wooden_tray_region
          (:target study_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target study_table)
          (:ranges (
              (0.0488 0.1994 0.0988 0.2494)
            )
          )
      )
      (object_init_region_1
          (:target study_table)
          (:ranges (
              (-0.2533 -0.0321 -0.2033 0.0179)
            )
          )
      )
      (object_init_region_2
          (:target study_table)
          (:ranges (
              (0.1030 -0.2316 0.1530 -0.1816)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    study_table - table
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    ketchup_1 - ketchup
    orange_juice_1 - orange_juice
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    ketchup_1 alphabet_soup_1 orange_juice_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 study_table_wooden_tray_region)
    (On alphabet_soup_1 study_table_object_init_region_0)
    (On ketchup_1 study_table_object_init_region_1)
    (On orange_juice_1 study_table_object_init_region_2)
  )

  (:goal
    (And (In ketchup_1 wooden_tray_1_contain_region) (In alphabet_soup_1 wooden_tray_1_contain_region) (In orange_juice_1 wooden_tray_1_contain_region))
  )

)
