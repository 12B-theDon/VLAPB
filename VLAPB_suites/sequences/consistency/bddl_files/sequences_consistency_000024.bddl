(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Put the objects belonging to user_008 into the wooden_tray in this order: ketchup, cookies, orange_juice)
    (:regions
      (wooden_tray_region
          (:target study_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target study_table)
          (:ranges (
              (0.0336 0.1582 0.0836 0.2082)
            )
          )
      )
      (object_init_region_1
          (:target study_table)
          (:ranges (
              (-0.2782 -0.0350 -0.2282 0.0150)
            )
          )
      )
      (object_init_region_2
          (:target study_table)
          (:ranges (
              (0.1063 -0.2330 0.1563 -0.1830)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    study_table - table
  )

  (:objects
    cookies_1 - cookies
    ketchup_1 - ketchup
    orange_juice_1 - orange_juice
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    ketchup_1 cookies_1 orange_juice_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 study_table_wooden_tray_region)
    (On cookies_1 study_table_object_init_region_0)
    (On ketchup_1 study_table_object_init_region_1)
    (On orange_juice_1 study_table_object_init_region_2)
  )

  (:goal
    (And (In ketchup_1 wooden_tray_1_contain_region) (In cookies_1 wooden_tray_1_contain_region) (In orange_juice_1 wooden_tray_1_contain_region))
  )

)
