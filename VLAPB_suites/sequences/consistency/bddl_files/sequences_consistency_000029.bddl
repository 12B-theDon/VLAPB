(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Put the objects belonging to user_010 into the wooden_tray in this order: porcelain_mug, ketchup, bbq_sauce)
    (:regions
      (wooden_tray_region
          (:target study_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target study_table)
          (:ranges (
              (0.0671 0.1948 0.1171 0.2448)
            )
          )
      )
      (object_init_region_1
          (:target study_table)
          (:ranges (
              (-0.2573 -0.0139 -0.2073 0.0361)
            )
          )
      )
      (object_init_region_2
          (:target study_table)
          (:ranges (
              (0.0647 -0.1991 0.1147 -0.1491)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    study_table - table
  )

  (:objects
    bbq_sauce_1 - bbq_sauce
    ketchup_1 - ketchup
    porcelain_mug_1 - porcelain_mug
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    porcelain_mug_1 ketchup_1 bbq_sauce_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 study_table_wooden_tray_region)
    (On bbq_sauce_1 study_table_object_init_region_0)
    (On ketchup_1 study_table_object_init_region_1)
    (On porcelain_mug_1 study_table_object_init_region_2)
  )

  (:goal
    (And (In porcelain_mug_1 wooden_tray_1_contain_region) (In ketchup_1 wooden_tray_1_contain_region) (In bbq_sauce_1 wooden_tray_1_contain_region))
  )

)
