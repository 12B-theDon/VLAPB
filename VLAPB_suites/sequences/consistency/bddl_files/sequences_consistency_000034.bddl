(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Put the objects belonging to user_012 into the wooden_tray in this order: salad_dressing, cream_cheese, bbq_sauce)
    (:regions
      (wooden_tray_region
          (:target living_room_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.0525 0.1690 0.1025 0.2190)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.2424 -0.0182 -0.1924 0.0318)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (0.0909 -0.2410 0.1409 -0.1910)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    living_room_table - table
  )

  (:objects
    bbq_sauce_1 - bbq_sauce
    cream_cheese_1 - cream_cheese
    salad_dressing_1 - salad_dressing
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    salad_dressing_1 cream_cheese_1 bbq_sauce_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 living_room_table_wooden_tray_region)
    (On bbq_sauce_1 living_room_table_object_init_region_0)
    (On cream_cheese_1 living_room_table_object_init_region_1)
    (On salad_dressing_1 living_room_table_object_init_region_2)
  )

  (:goal
    (And (In salad_dressing_1 wooden_tray_1_contain_region) (In cream_cheese_1 wooden_tray_1_contain_region) (In bbq_sauce_1 wooden_tray_1_contain_region))
  )

)
