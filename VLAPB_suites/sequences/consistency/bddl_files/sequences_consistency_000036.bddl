(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Put the objects belonging to user_012 into the wooden_tray in this order: new_salad_dressing, cream_cheese, salad_dressing)
    (:regions
      (wooden_tray_region
          (:target study_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target study_table)
          (:ranges (
              (0.0429 0.1744 0.0929 0.2244)
            )
          )
      )
      (object_init_region_1
          (:target study_table)
          (:ranges (
              (-0.2773 -0.0303 -0.2273 0.0197)
            )
          )
      )
      (object_init_region_2
          (:target study_table)
          (:ranges (
              (0.0798 -0.1980 0.1298 -0.1480)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    study_table - table
  )

  (:objects
    cream_cheese_1 - cream_cheese
    new_salad_dressing_1 - new_salad_dressing
    salad_dressing_1 - salad_dressing
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    new_salad_dressing_1 cream_cheese_1 salad_dressing_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 study_table_wooden_tray_region)
    (On cream_cheese_1 study_table_object_init_region_0)
    (On new_salad_dressing_1 study_table_object_init_region_1)
    (On salad_dressing_1 study_table_object_init_region_2)
  )

  (:goal
    (And (In new_salad_dressing_1 wooden_tray_1_contain_region) (In cream_cheese_1 wooden_tray_1_contain_region) (In salad_dressing_1 wooden_tray_1_contain_region))
  )

)
