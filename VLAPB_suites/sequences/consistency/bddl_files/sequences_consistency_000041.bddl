(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Put the objects belonging to user_014 into the wooden_tray in this order: butter, milk, red_coffee_mug)
    (:regions
      (wooden_tray_region
          (:target study_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target study_table)
          (:ranges (
              (0.0652 0.1713 0.1152 0.2213)
            )
          )
      )
      (object_init_region_1
          (:target study_table)
          (:ranges (
              (-0.2854 -0.0037 -0.2354 0.0463)
            )
          )
      )
      (object_init_region_2
          (:target study_table)
          (:ranges (
              (0.0710 -0.2279 0.1210 -0.1779)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    study_table - table
  )

  (:objects
    butter_1 - butter
    milk_1 - milk
    red_coffee_mug_1 - red_coffee_mug
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    butter_1 milk_1 red_coffee_mug_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 study_table_wooden_tray_region)
    (On butter_1 study_table_object_init_region_0)
    (On milk_1 study_table_object_init_region_1)
    (On red_coffee_mug_1 study_table_object_init_region_2)
  )

  (:goal
    (And (In butter_1 wooden_tray_1_contain_region) (In milk_1 wooden_tray_1_contain_region) (In red_coffee_mug_1 wooden_tray_1_contain_region))
  )

)
