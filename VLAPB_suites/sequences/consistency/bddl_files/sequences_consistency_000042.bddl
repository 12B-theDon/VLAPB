(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Put the objects belonging to user_014 into the wooden_tray in this order: chocolate_pudding, milk, red_coffee_mug)
    (:regions
      (wooden_tray_region
          (:target study_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target study_table)
          (:ranges (
              (0.0163 0.2127 0.0663 0.2627)
            )
          )
      )
      (object_init_region_1
          (:target study_table)
          (:ranges (
              (-0.2135 -0.0587 -0.1635 -0.0087)
            )
          )
      )
      (object_init_region_2
          (:target study_table)
          (:ranges (
              (0.1319 -0.2110 0.1819 -0.1610)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    study_table - table
  )

  (:objects
    chocolate_pudding_1 - chocolate_pudding
    milk_1 - milk
    red_coffee_mug_1 - red_coffee_mug
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    chocolate_pudding_1 milk_1 red_coffee_mug_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 study_table_wooden_tray_region)
    (On chocolate_pudding_1 study_table_object_init_region_0)
    (On milk_1 study_table_object_init_region_1)
    (On red_coffee_mug_1 study_table_object_init_region_2)
  )

  (:goal
    (And (In chocolate_pudding_1 wooden_tray_1_contain_region) (In milk_1 wooden_tray_1_contain_region) (In red_coffee_mug_1 wooden_tray_1_contain_region))
  )

)
