(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Put the objects belonging to user_015 into the wooden_tray in this order: cookies, tomato_sauce, new_salad_dressing)
    (:regions
      (wooden_tray_region
          (:target living_room_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.0225 0.1794 0.0725 0.2294)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.2623 -0.0538 -0.2123 -0.0038)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (0.1149 -0.2113 0.1649 -0.1613)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    living_room_table - table
  )

  (:objects
    cookies_1 - cookies
    new_salad_dressing_1 - new_salad_dressing
    tomato_sauce_1 - tomato_sauce
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    cookies_1 tomato_sauce_1 new_salad_dressing_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 living_room_table_wooden_tray_region)
    (On cookies_1 living_room_table_object_init_region_0)
    (On new_salad_dressing_1 living_room_table_object_init_region_1)
    (On tomato_sauce_1 living_room_table_object_init_region_2)
  )

  (:goal
    (And (In cookies_1 wooden_tray_1_contain_region) (In tomato_sauce_1 wooden_tray_1_contain_region) (In new_salad_dressing_1 wooden_tray_1_contain_region))
  )

)
