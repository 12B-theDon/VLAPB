(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Put the objects belonging to user_016 into the wooden_tray in this order: glazed_rim_porcelain_ramekin, butter, orange_juice)
    (:regions
      (wooden_tray_region
          (:target study_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target study_table)
          (:ranges (
              (0.0565 0.2026 0.1065 0.2526)
            )
          )
      )
      (object_init_region_1
          (:target study_table)
          (:ranges (
              (-0.2261 -0.0261 -0.1761 0.0239)
            )
          )
      )
      (object_init_region_2
          (:target study_table)
          (:ranges (
              (0.0695 -0.1866 0.1195 -0.1366)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    study_table - table
  )

  (:objects
    butter_1 - butter
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    orange_juice_1 - orange_juice
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    glazed_rim_porcelain_ramekin_1 butter_1 orange_juice_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 study_table_wooden_tray_region)
    (On butter_1 study_table_object_init_region_0)
    (On glazed_rim_porcelain_ramekin_1 study_table_object_init_region_1)
    (On orange_juice_1 study_table_object_init_region_2)
  )

  (:goal
    (And (In glazed_rim_porcelain_ramekin_1 wooden_tray_1_contain_region) (In butter_1 wooden_tray_1_contain_region) (In orange_juice_1 wooden_tray_1_contain_region))
  )

)
