(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Put the objects belonging to user_017 into the wooden_tray in this order: butter, ketchup, white_bowl)
    (:regions
      (wooden_tray_region
          (:target kitchen_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.0340 0.1941 0.0840 0.2441)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.2325 -0.0429 -0.1825 0.0071)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (0.1052 -0.2114 0.1552 -0.1614)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    kitchen_table - table
  )

  (:objects
    butter_1 - butter
    ketchup_1 - ketchup
    white_bowl_1 - white_bowl
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    butter_1 ketchup_1 white_bowl_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 kitchen_table_wooden_tray_region)
    (On butter_1 kitchen_table_object_init_region_0)
    (On ketchup_1 kitchen_table_object_init_region_1)
    (On white_bowl_1 kitchen_table_object_init_region_2)
  )

  (:goal
    (And (In butter_1 wooden_tray_1_contain_region) (In ketchup_1 wooden_tray_1_contain_region) (In white_bowl_1 wooden_tray_1_contain_region))
  )

)
