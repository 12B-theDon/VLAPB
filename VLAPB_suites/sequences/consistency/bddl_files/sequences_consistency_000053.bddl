(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Put the objects belonging to user_018 into the wooden_tray in this order: white_yellow_mug, salad_dressing, chocolate_pudding)
    (:regions
      (wooden_tray_region
          (:target study_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target study_table)
          (:ranges (
              (0.0696 0.1875 0.1196 0.2375)
            )
          )
      )
      (object_init_region_1
          (:target study_table)
          (:ranges (
              (-0.2198 -0.0114 -0.1698 0.0386)
            )
          )
      )
      (object_init_region_2
          (:target study_table)
          (:ranges (
              (0.0760 -0.2321 0.1260 -0.1821)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    study_table - table
  )

  (:objects
    chocolate_pudding_1 - chocolate_pudding
    salad_dressing_1 - salad_dressing
    white_yellow_mug_1 - white_yellow_mug
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    white_yellow_mug_1 salad_dressing_1 chocolate_pudding_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 study_table_wooden_tray_region)
    (On chocolate_pudding_1 study_table_object_init_region_0)
    (On salad_dressing_1 study_table_object_init_region_1)
    (On white_yellow_mug_1 study_table_object_init_region_2)
  )

  (:goal
    (And (In white_yellow_mug_1 wooden_tray_1_contain_region) (In salad_dressing_1 wooden_tray_1_contain_region) (In chocolate_pudding_1 wooden_tray_1_contain_region))
  )

)
