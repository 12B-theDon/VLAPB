(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Put the objects belonging to user_020 into the wooden_tray in this order: red_coffee_mug, white_yellow_mug, cream_cheese)
    (:regions
      (wooden_tray_region
          (:target study_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target study_table)
          (:ranges (
              (0.0650 0.1615 0.1150 0.2115)
            )
          )
      )
      (object_init_region_1
          (:target study_table)
          (:ranges (
              (-0.2819 0.0010 -0.2319 0.0510)
            )
          )
      )
      (object_init_region_2
          (:target study_table)
          (:ranges (
              (0.0754 -0.2482 0.1254 -0.1982)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    study_table - table
  )

  (:objects
    cream_cheese_1 - cream_cheese
    red_coffee_mug_1 - red_coffee_mug
    white_yellow_mug_1 - white_yellow_mug
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    red_coffee_mug_1 white_yellow_mug_1 cream_cheese_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 study_table_wooden_tray_region)
    (On cream_cheese_1 study_table_object_init_region_0)
    (On red_coffee_mug_1 study_table_object_init_region_1)
    (On white_yellow_mug_1 study_table_object_init_region_2)
  )

  (:goal
    (And (In red_coffee_mug_1 wooden_tray_1_contain_region) (In white_yellow_mug_1 wooden_tray_1_contain_region) (In cream_cheese_1 wooden_tray_1_contain_region))
  )

)
