(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Put the objects belonging to user_020 into the wooden_tray in this order: white_yellow_mug, ketchup, red_coffee_mug)
    (:regions
      (wooden_tray_region
          (:target study_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target study_table)
          (:ranges (
              (0.0378 0.1772 0.0878 0.2272)
            )
          )
      )
      (object_init_region_1
          (:target study_table)
          (:ranges (
              (-0.2334 -0.0350 -0.1834 0.0150)
            )
          )
      )
      (object_init_region_2
          (:target study_table)
          (:ranges (
              (0.1140 -0.2411 0.1640 -0.1911)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    study_table - table
  )

  (:objects
    ketchup_1 - ketchup
    red_coffee_mug_1 - red_coffee_mug
    white_yellow_mug_1 - white_yellow_mug
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    white_yellow_mug_1 ketchup_1 red_coffee_mug_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 study_table_wooden_tray_region)
    (On ketchup_1 study_table_object_init_region_0)
    (On red_coffee_mug_1 study_table_object_init_region_1)
    (On white_yellow_mug_1 study_table_object_init_region_2)
  )

  (:goal
    (And (In white_yellow_mug_1 wooden_tray_1_contain_region) (In ketchup_1 wooden_tray_1_contain_region) (In red_coffee_mug_1 wooden_tray_1_contain_region))
  )

)
