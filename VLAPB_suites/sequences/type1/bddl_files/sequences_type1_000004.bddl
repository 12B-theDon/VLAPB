(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Use user_001's sequence preference and put the objects into the wooden_tray in this order: chefmate_8_frypan, moka_pot, yellow_book)
    (:regions
      (wooden_tray_region
          (:target living_room_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1619 0.3060 0.2119 0.3560)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.2330 0.0096 -0.1830 0.0596)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (0.0670 -0.2705 0.1170 -0.2205)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    living_room_table - table
  )

  (:objects
    chefmate_8_frypan_1 - chefmate_8_frypan
    moka_pot_1 - moka_pot
    yellow_book_1 - yellow_book
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    chefmate_8_frypan_1 moka_pot_1 yellow_book_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 living_room_table_wooden_tray_region)
    (On chefmate_8_frypan_1 living_room_table_object_init_region_0)
    (On moka_pot_1 living_room_table_object_init_region_1)
    (On yellow_book_1 living_room_table_object_init_region_2)
  )

  (:goal
    (And (In chefmate_8_frypan_1 wooden_tray_1_contain_region) (In moka_pot_1 wooden_tray_1_contain_region) (In yellow_book_1 wooden_tray_1_contain_region))
  )

)
