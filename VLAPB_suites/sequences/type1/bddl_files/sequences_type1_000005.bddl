(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Use user_002's sequence preference and put the objects into the wooden_tray in this order: moka_pot, chefmate_8_frypan, black_book)
    (:regions
      (wooden_tray_region
          (:target study_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target study_table)
          (:ranges (
              (0.0981 0.1834 0.1481 0.2334)
            )
          )
      )
      (object_init_region_1
          (:target study_table)
          (:ranges (
              (-0.3189 0.0299 -0.2689 0.0799)
            )
          )
      )
      (object_init_region_2
          (:target study_table)
          (:ranges (
              (0.0519 -0.2430 0.1019 -0.1930)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    study_table - table
  )

  (:objects
    black_book_1 - black_book
    chefmate_8_frypan_1 - chefmate_8_frypan
    moka_pot_1 - moka_pot
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    moka_pot_1 chefmate_8_frypan_1 black_book_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 study_table_wooden_tray_region)
    (On black_book_1 study_table_object_init_region_0)
    (On chefmate_8_frypan_1 study_table_object_init_region_1)
    (On moka_pot_1 study_table_object_init_region_2)
  )

  (:goal
    (And (In moka_pot_1 wooden_tray_1_contain_region) (In chefmate_8_frypan_1 wooden_tray_1_contain_region) (In black_book_1 wooden_tray_1_contain_region))
  )

)
