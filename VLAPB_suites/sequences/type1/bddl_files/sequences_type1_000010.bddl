(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Use user_003's sequence preference and put the objects into the wooden_tray in this order: yellow_book, black_book, chefmate_8_frypan)
    (:regions
      (wooden_tray_region
          (:target living_room_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.0506 0.1914 0.1006 0.2414)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.3856 -0.0297 -0.3356 0.0203)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (0.0773 -0.1970 0.1273 -0.1470)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    living_room_table - table
  )

  (:objects
    black_book_1 - black_book
    chefmate_8_frypan_1 - chefmate_8_frypan
    yellow_book_1 - yellow_book
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    yellow_book_1 black_book_1 chefmate_8_frypan_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 living_room_table_wooden_tray_region)
    (On black_book_1 living_room_table_object_init_region_0)
    (On chefmate_8_frypan_1 living_room_table_object_init_region_1)
    (On yellow_book_1 living_room_table_object_init_region_2)
  )

  (:goal
    (And (In yellow_book_1 wooden_tray_1_contain_region) (In black_book_1 wooden_tray_1_contain_region) (In chefmate_8_frypan_1 wooden_tray_1_contain_region))
  )

)
