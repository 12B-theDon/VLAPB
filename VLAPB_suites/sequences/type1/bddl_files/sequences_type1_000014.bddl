(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Use user_004's sequence preference and put the objects into the wooden_tray in this order: chefmate_8_frypan, black_book, yellow_book)
    (:regions
      (wooden_tray_region
          (:target kitchen_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.0116 0.2072 0.0616 0.2572)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.3931 -0.0969 -0.3431 -0.0469)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (0.1245 -0.1967 0.1745 -0.1467)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    kitchen_table - table
  )

  (:objects
    black_book_1 - black_book
    chefmate_8_frypan_1 - chefmate_8_frypan
    yellow_book_1 - yellow_book
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    chefmate_8_frypan_1 black_book_1 yellow_book_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 kitchen_table_wooden_tray_region)
    (On black_book_1 kitchen_table_object_init_region_0)
    (On chefmate_8_frypan_1 kitchen_table_object_init_region_1)
    (On yellow_book_1 kitchen_table_object_init_region_2)
  )

  (:goal
    (And (In chefmate_8_frypan_1 wooden_tray_1_contain_region) (In black_book_1 wooden_tray_1_contain_region) (In yellow_book_1 wooden_tray_1_contain_region))
  )

)
