(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Use user_006's sequence preference and put the objects into the wooden_tray in this order: black_book, moka_pot, yellow_book)
    (:regions
      (wooden_tray_region
          (:target study_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target study_table)
          (:ranges (
              (0.0139 0.1587 0.0639 0.2087)
            )
          )
      )
      (object_init_region_1
          (:target study_table)
          (:ranges (
              (-0.2449 -0.0560 -0.1949 -0.0060)
            )
          )
      )
      (object_init_region_2
          (:target study_table)
          (:ranges (
              (0.1059 -0.1923 0.1559 -0.1423)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    study_table - table
  )

  (:objects
    black_book_1 - black_book
    moka_pot_1 - moka_pot
    yellow_book_1 - yellow_book
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    black_book_1 moka_pot_1 yellow_book_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 study_table_wooden_tray_region)
    (On black_book_1 study_table_object_init_region_0)
    (On moka_pot_1 study_table_object_init_region_1)
    (On yellow_book_1 study_table_object_init_region_2)
  )

  (:goal
    (And (In black_book_1 wooden_tray_1_contain_region) (In moka_pot_1 wooden_tray_1_contain_region) (In yellow_book_1 wooden_tray_1_contain_region))
  )

)
