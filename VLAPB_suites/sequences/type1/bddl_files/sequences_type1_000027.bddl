(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Use user_007's sequence preference and put the objects into the wooden_tray in this order: black_book, yellow_book, moka_pot)
    (:regions
      (wooden_tray_region
          (:target living_room_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.0448 0.1561 0.0948 0.2061)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.2582 -0.0207 -0.2082 0.0293)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (0.0884 -0.2301 0.1384 -0.1801)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    living_room_table - table
  )

  (:objects
    black_book_1 - black_book
    moka_pot_1 - moka_pot
    yellow_book_1 - yellow_book
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    black_book_1 yellow_book_1 moka_pot_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 living_room_table_wooden_tray_region)
    (On black_book_1 living_room_table_object_init_region_0)
    (On moka_pot_1 living_room_table_object_init_region_1)
    (On yellow_book_1 living_room_table_object_init_region_2)
  )

  (:goal
    (And (In black_book_1 wooden_tray_1_contain_region) (In yellow_book_1 wooden_tray_1_contain_region) (In moka_pot_1 wooden_tray_1_contain_region))
  )

)
