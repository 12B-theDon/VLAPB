(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Use user_008's sequence preference and put the objects into the wooden_tray in this order: chefmate_8_frypan, black_book, moka_pot)
    (:regions
      (wooden_tray_region
          (:target study_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target study_table)
          (:ranges (
              (0.0745 0.1413 0.1245 0.1913)
            )
          )
      )
      (object_init_region_1
          (:target study_table)
          (:ranges (
              (-0.4154 0.0501 -0.3654 0.1001)
            )
          )
      )
      (object_init_region_2
          (:target study_table)
          (:ranges (
              (0.0434 -0.2225 0.0934 -0.1725)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    study_table - table
  )

  (:objects
    black_book_1 - black_book
    chefmate_8_frypan_1 - chefmate_8_frypan
    moka_pot_1 - moka_pot
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    chefmate_8_frypan_1 black_book_1 moka_pot_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 study_table_wooden_tray_region)
    (On black_book_1 study_table_object_init_region_0)
    (On chefmate_8_frypan_1 study_table_object_init_region_1)
    (On moka_pot_1 study_table_object_init_region_2)
  )

  (:goal
    (And (In chefmate_8_frypan_1 wooden_tray_1_contain_region) (In black_book_1 wooden_tray_1_contain_region) (In moka_pot_1 wooden_tray_1_contain_region))
  )

)
