(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Use user_008's sequence preference and put the objects into the wooden_tray in this order: chefmate_8_frypan, black_book, yellow_book)
    (:regions
      (wooden_tray_region
          (:target study_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target study_table)
          (:ranges (
              (0.0750 0.2116 0.1250 0.2616)
            )
          )
      )
      (object_init_region_1
          (:target study_table)
          (:ranges (
              (-0.4053 -0.0057 -0.3553 0.0443)
            )
          )
      )
      (object_init_region_2
          (:target study_table)
          (:ranges (
              (0.0677 -0.2062 0.1177 -0.1562)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    study_table - table
  )

  (:objects
    black_book_1 - black_book
    chefmate_8_frypan_1 - chefmate_8_frypan
    yellow_book_1 - yellow_book
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    chefmate_8_frypan_1 black_book_1 yellow_book_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 study_table_wooden_tray_region)
    (On black_book_1 study_table_object_init_region_0)
    (On chefmate_8_frypan_1 study_table_object_init_region_1)
    (On yellow_book_1 study_table_object_init_region_2)
  )

  (:goal
    (And (In chefmate_8_frypan_1 wooden_tray_1_contain_region) (In black_book_1 wooden_tray_1_contain_region) (In yellow_book_1 wooden_tray_1_contain_region))
  )

)
