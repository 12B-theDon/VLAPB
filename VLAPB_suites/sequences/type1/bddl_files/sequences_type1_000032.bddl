(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Use user_008's sequence preference and put the objects into the wooden_tray in this order: moka_pot, chefmate_8_frypan, yellow_book)
    (:regions
      (wooden_tray_region
          (:target kitchen_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.1129 0.3218 0.1629 0.3718)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.2560 -0.0182 -0.2060 0.0318)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (0.0739 -0.2085 0.1239 -0.1585)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    kitchen_table - table
  )

  (:objects
    chefmate_8_frypan_1 - chefmate_8_frypan
    moka_pot_1 - moka_pot
    yellow_book_1 - yellow_book
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    moka_pot_1 chefmate_8_frypan_1 yellow_book_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 kitchen_table_wooden_tray_region)
    (On chefmate_8_frypan_1 kitchen_table_object_init_region_0)
    (On moka_pot_1 kitchen_table_object_init_region_1)
    (On yellow_book_1 kitchen_table_object_init_region_2)
  )

  (:goal
    (And (In moka_pot_1 wooden_tray_1_contain_region) (In chefmate_8_frypan_1 wooden_tray_1_contain_region) (In yellow_book_1 wooden_tray_1_contain_region))
  )

)
