(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Use user_009's sequence preference and put the objects into the wooden_tray in this order: black_book, moka_pot, yellow_book)
    (:regions
      (wooden_tray_region
          (:target study_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target study_table)
          (:ranges (
              (0.0691 0.1763 0.1191 0.2263)
            )
          )
      )
      (object_init_region_1
          (:target study_table)
          (:ranges (
              (-0.2374 -0.0062 -0.1874 0.0438)
            )
          )
      )
      (object_init_region_2
          (:target study_table)
          (:ranges (
              (0.0650 -0.2183 0.1150 -0.1683)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    study_table - table
  )

  (:objects
    black_book_1 - black_book
    moka_pot_1 - moka_pot
    yellow_book_1 - yellow_book
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    black_book_1 moka_pot_1 yellow_book_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 study_table_wooden_tray_region)
    (On black_book_1 study_table_object_init_region_0)
    (On moka_pot_1 study_table_object_init_region_1)
    (On yellow_book_1 study_table_object_init_region_2)
  )

  (:goal
    (And (In black_book_1 wooden_tray_1_contain_region) (In moka_pot_1 wooden_tray_1_contain_region) (In yellow_book_1 wooden_tray_1_contain_region))
  )

)
