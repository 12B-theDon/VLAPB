(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Use user_010's sequence preference and put the objects into the wooden_tray in this order: moka_pot, chefmate_8_frypan, black_book)
    (:regions
      (wooden_tray_region
          (:target kitchen_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.0170 0.1632 0.0670 0.2132)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.3458 -0.0668 -0.2958 -0.0168)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (0.0971 -0.1846 0.1471 -0.1346)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    kitchen_table - table
  )

  (:objects
    black_book_1 - black_book
    chefmate_8_frypan_1 - chefmate_8_frypan
    moka_pot_1 - moka_pot
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    moka_pot_1 chefmate_8_frypan_1 black_book_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 kitchen_table_wooden_tray_region)
    (On black_book_1 kitchen_table_object_init_region_0)
    (On chefmate_8_frypan_1 kitchen_table_object_init_region_1)
    (On moka_pot_1 kitchen_table_object_init_region_2)
  )

  (:goal
    (And (In moka_pot_1 wooden_tray_1_contain_region) (In chefmate_8_frypan_1 wooden_tray_1_contain_region) (In black_book_1 wooden_tray_1_contain_region))
  )

)
