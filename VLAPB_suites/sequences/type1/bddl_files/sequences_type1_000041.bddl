(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Use user_011's sequence preference and put the objects into the wooden_tray in this order: black_book, moka_pot, chefmate_8_frypan)
    (:regions
      (wooden_tray_region
          (:target study_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target study_table)
          (:ranges (
              (0.0176 0.1712 0.0676 0.2212)
            )
          )
      )
      (object_init_region_1
          (:target study_table)
          (:ranges (
              (-0.3419 -0.0682 -0.2919 -0.0182)
            )
          )
      )
      (object_init_region_2
          (:target study_table)
          (:ranges (
              (0.1242 -0.2176 0.1742 -0.1676)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    study_table - table
  )

  (:objects
    black_book_1 - black_book
    chefmate_8_frypan_1 - chefmate_8_frypan
    moka_pot_1 - moka_pot
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    black_book_1 moka_pot_1 chefmate_8_frypan_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 study_table_wooden_tray_region)
    (On black_book_1 study_table_object_init_region_0)
    (On chefmate_8_frypan_1 study_table_object_init_region_1)
    (On moka_pot_1 study_table_object_init_region_2)
  )

  (:goal
    (And (In black_book_1 wooden_tray_1_contain_region) (In moka_pot_1 wooden_tray_1_contain_region) (In chefmate_8_frypan_1 wooden_tray_1_contain_region))
  )

)
