(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Use user_011's sequence preference and put the objects into the wooden_tray in this order: yellow_book, black_book, chefmate_8_frypan)
    (:regions
      (wooden_tray_region
          (:target study_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target study_table)
          (:ranges (
              (0.0401 0.1644 0.0901 0.2144)
            )
          )
      )
      (object_init_region_1
          (:target study_table)
          (:ranges (
              (-0.4032 -0.0318 -0.3532 0.0182)
            )
          )
      )
      (object_init_region_2
          (:target study_table)
          (:ranges (
              (0.0781 -0.1964 0.1281 -0.1464)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    study_table - table
  )

  (:objects
    black_book_1 - black_book
    chefmate_8_frypan_1 - chefmate_8_frypan
    yellow_book_1 - yellow_book
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    yellow_book_1 black_book_1 chefmate_8_frypan_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 study_table_wooden_tray_region)
    (On black_book_1 study_table_object_init_region_0)
    (On chefmate_8_frypan_1 study_table_object_init_region_1)
    (On yellow_book_1 study_table_object_init_region_2)
  )

  (:goal
    (And (In yellow_book_1 wooden_tray_1_contain_region) (In black_book_1 wooden_tray_1_contain_region) (In chefmate_8_frypan_1 wooden_tray_1_contain_region))
  )

)
