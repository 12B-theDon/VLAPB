(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Use user_012's sequence preference and put the objects into the wooden_tray in this order: chefmate_8_frypan, black_book, yellow_book)
    (:regions
      (wooden_tray_region
          (:target living_room_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.1086 0.1940 0.1586 0.2440)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.3886 0.0483 -0.3386 0.0983)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (0.0354 -0.2044 0.0854 -0.1544)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    living_room_table - table
  )

  (:objects
    black_book_1 - black_book
    chefmate_8_frypan_1 - chefmate_8_frypan
    yellow_book_1 - yellow_book
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    chefmate_8_frypan_1 black_book_1 yellow_book_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 living_room_table_wooden_tray_region)
    (On black_book_1 living_room_table_object_init_region_0)
    (On chefmate_8_frypan_1 living_room_table_object_init_region_1)
    (On yellow_book_1 living_room_table_object_init_region_2)
  )

  (:goal
    (And (In chefmate_8_frypan_1 wooden_tray_1_contain_region) (In black_book_1 wooden_tray_1_contain_region) (In yellow_book_1 wooden_tray_1_contain_region))
  )

)
