(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Use user_012's sequence preference and put the objects into the wooden_tray in this order: yellow_book, moka_pot, black_book)
    (:regions
      (wooden_tray_region
          (:target study_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target study_table)
          (:ranges (
              (0.0078 0.1813 0.0578 0.2313)
            )
          )
      )
      (object_init_region_1
          (:target study_table)
          (:ranges (
              (-0.2352 -0.0658 -0.1852 -0.0158)
            )
          )
      )
      (object_init_region_2
          (:target study_table)
          (:ranges (
              (0.1257 -0.1985 0.1757 -0.1485)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    study_table - table
  )

  (:objects
    black_book_1 - black_book
    moka_pot_1 - moka_pot
    yellow_book_1 - yellow_book
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    yellow_book_1 moka_pot_1 black_book_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 study_table_wooden_tray_region)
    (On black_book_1 study_table_object_init_region_0)
    (On moka_pot_1 study_table_object_init_region_1)
    (On yellow_book_1 study_table_object_init_region_2)
  )

  (:goal
    (And (In yellow_book_1 wooden_tray_1_contain_region) (In moka_pot_1 wooden_tray_1_contain_region) (In black_book_1 wooden_tray_1_contain_region))
  )

)
