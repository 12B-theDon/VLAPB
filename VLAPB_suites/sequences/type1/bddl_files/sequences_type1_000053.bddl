(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Use user_014's sequence preference and put the objects into the wooden_tray in this order: black_book, chefmate_8_frypan, moka_pot)
    (:regions
      (wooden_tray_region
          (:target study_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target study_table)
          (:ranges (
              (0.0463 0.1868 0.0963 0.2368)
            )
          )
      )
      (object_init_region_1
          (:target study_table)
          (:ranges (
              (-0.3881 -0.0339 -0.3381 0.0161)
            )
          )
      )
      (object_init_region_2
          (:target study_table)
          (:ranges (
              (0.0914 -0.2157 0.1414 -0.1657)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    study_table - table
  )

  (:objects
    black_book_1 - black_book
    chefmate_8_frypan_1 - chefmate_8_frypan
    moka_pot_1 - moka_pot
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    black_book_1 chefmate_8_frypan_1 moka_pot_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 study_table_wooden_tray_region)
    (On black_book_1 study_table_object_init_region_0)
    (On chefmate_8_frypan_1 study_table_object_init_region_1)
    (On moka_pot_1 study_table_object_init_region_2)
  )

  (:goal
    (And (In black_book_1 wooden_tray_1_contain_region) (In chefmate_8_frypan_1 wooden_tray_1_contain_region) (In moka_pot_1 wooden_tray_1_contain_region))
  )

)
