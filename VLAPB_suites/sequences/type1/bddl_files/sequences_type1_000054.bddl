(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Use user_014's sequence preference and put the objects into the wooden_tray in this order: black_book, chefmate_8_frypan, yellow_book)
    (:regions
      (wooden_tray_region
          (:target study_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target study_table)
          (:ranges (
              (0.0630 0.1865 0.1130 0.2365)
            )
          )
      )
      (object_init_region_1
          (:target study_table)
          (:ranges (
              (-0.3466 -0.0104 -0.2966 0.0396)
            )
          )
      )
      (object_init_region_2
          (:target study_table)
          (:ranges (
              (0.0873 -0.2416 0.1373 -0.1916)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    study_table - table
  )

  (:objects
    black_book_1 - black_book
    chefmate_8_frypan_1 - chefmate_8_frypan
    yellow_book_1 - yellow_book
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    black_book_1 chefmate_8_frypan_1 yellow_book_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 study_table_wooden_tray_region)
    (On black_book_1 study_table_object_init_region_0)
    (On chefmate_8_frypan_1 study_table_object_init_region_1)
    (On yellow_book_1 study_table_object_init_region_2)
  )

  (:goal
    (And (In black_book_1 wooden_tray_1_contain_region) (In chefmate_8_frypan_1 wooden_tray_1_contain_region) (In yellow_book_1 wooden_tray_1_contain_region))
  )

)
