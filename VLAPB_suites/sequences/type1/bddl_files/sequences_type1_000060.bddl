(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Use user_015's sequence preference and put the objects into the wooden_tray in this order: chefmate_8_frypan, yellow_book, moka_pot)
    (:regions
      (wooden_tray_region
          (:target study_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target study_table)
          (:ranges (
              (0.0750 0.3320 0.1250 0.3820)
            )
          )
      )
      (object_init_region_1
          (:target study_table)
          (:ranges (
              (-0.2741 -0.0440 -0.2241 0.0060)
            )
          )
      )
      (object_init_region_2
          (:target study_table)
          (:ranges (
              (0.0810 -0.1800 0.1310 -0.1300)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    study_table - table
  )

  (:objects
    chefmate_8_frypan_1 - chefmate_8_frypan
    moka_pot_1 - moka_pot
    yellow_book_1 - yellow_book
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    chefmate_8_frypan_1 yellow_book_1 moka_pot_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 study_table_wooden_tray_region)
    (On chefmate_8_frypan_1 study_table_object_init_region_0)
    (On moka_pot_1 study_table_object_init_region_1)
    (On yellow_book_1 study_table_object_init_region_2)
  )

  (:goal
    (And (In chefmate_8_frypan_1 wooden_tray_1_contain_region) (In yellow_book_1 wooden_tray_1_contain_region) (In moka_pot_1 wooden_tray_1_contain_region))
  )

)
