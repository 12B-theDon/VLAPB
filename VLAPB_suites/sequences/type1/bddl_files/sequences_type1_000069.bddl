(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Use user_018's sequence preference and put the objects into the wooden_tray in this order: moka_pot, chefmate_8_frypan, black_book)
    (:regions
      (wooden_tray_region
          (:target living_room_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.0194 0.1706 0.0694 0.2206)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.3204 -0.0624 -0.2704 -0.0124)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (0.1121 -0.2056 0.1621 -0.1556)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    living_room_table - table
  )

  (:objects
    black_book_1 - black_book
    chefmate_8_frypan_1 - chefmate_8_frypan
    moka_pot_1 - moka_pot
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    moka_pot_1 chefmate_8_frypan_1 black_book_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 living_room_table_wooden_tray_region)
    (On black_book_1 living_room_table_object_init_region_0)
    (On chefmate_8_frypan_1 living_room_table_object_init_region_1)
    (On moka_pot_1 living_room_table_object_init_region_2)
  )

  (:goal
    (And (In moka_pot_1 wooden_tray_1_contain_region) (In chefmate_8_frypan_1 wooden_tray_1_contain_region) (In black_book_1 wooden_tray_1_contain_region))
  )

)
