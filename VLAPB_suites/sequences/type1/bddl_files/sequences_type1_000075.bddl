(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Use user_019's sequence preference and put the objects into the wooden_tray in this order: yellow_book, moka_pot, black_book)
    (:regions
      (wooden_tray_region
          (:target living_room_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.0398 0.2251 0.0898 0.2751)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.2473 -0.0463 -0.1973 0.0037)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (0.0926 -0.1900 0.1426 -0.1400)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    living_room_table - table
  )

  (:objects
    black_book_1 - black_book
    moka_pot_1 - moka_pot
    yellow_book_1 - yellow_book
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    yellow_book_1 moka_pot_1 black_book_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 living_room_table_wooden_tray_region)
    (On black_book_1 living_room_table_object_init_region_0)
    (On moka_pot_1 living_room_table_object_init_region_1)
    (On yellow_book_1 living_room_table_object_init_region_2)
  )

  (:goal
    (And (In yellow_book_1 wooden_tray_1_contain_region) (In moka_pot_1 wooden_tray_1_contain_region) (In black_book_1 wooden_tray_1_contain_region))
  )

)
