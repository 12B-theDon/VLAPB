(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Use user_020's sequence preference and put the objects into the wooden_tray in this order: chefmate_8_frypan, moka_pot, black_book)
    (:regions
      (wooden_tray_region
          (:target study_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target study_table)
          (:ranges (
              (0.0604 0.1534 0.1104 0.2034)
            )
          )
      )
      (object_init_region_1
          (:target study_table)
          (:ranges (
              (-0.3250 0.0043 -0.2750 0.0543)
            )
          )
      )
      (object_init_region_2
          (:target study_table)
          (:ranges (
              (0.0593 -0.2106 0.1093 -0.1606)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    study_table - table
  )

  (:objects
    black_book_1 - black_book
    chefmate_8_frypan_1 - chefmate_8_frypan
    moka_pot_1 - moka_pot
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    chefmate_8_frypan_1 moka_pot_1 black_book_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 study_table_wooden_tray_region)
    (On black_book_1 study_table_object_init_region_0)
    (On chefmate_8_frypan_1 study_table_object_init_region_1)
    (On moka_pot_1 study_table_object_init_region_2)
  )

  (:goal
    (And (In chefmate_8_frypan_1 wooden_tray_1_contain_region) (In moka_pot_1 wooden_tray_1_contain_region) (In black_book_1 wooden_tray_1_contain_region))
  )

)
