(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Use user_020's sequence preference and put the objects into the wooden_tray in this order: chefmate_8_frypan, yellow_book, black_book)
    (:regions
      (wooden_tray_region
          (:target study_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target study_table)
          (:ranges (
              (0.0293 0.1877 0.0793 0.2377)
            )
          )
      )
      (object_init_region_1
          (:target study_table)
          (:ranges (
              (-0.3567 -0.0580 -0.3067 -0.0080)
            )
          )
      )
      (object_init_region_2
          (:target study_table)
          (:ranges (
              (0.1162 -0.2216 0.1662 -0.1716)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    study_table - table
  )

  (:objects
    black_book_1 - black_book
    chefmate_8_frypan_1 - chefmate_8_frypan
    yellow_book_1 - yellow_book
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    chefmate_8_frypan_1 yellow_book_1 black_book_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 study_table_wooden_tray_region)
    (On black_book_1 study_table_object_init_region_0)
    (On chefmate_8_frypan_1 study_table_object_init_region_1)
    (On yellow_book_1 study_table_object_init_region_2)
  )

  (:goal
    (And (In chefmate_8_frypan_1 wooden_tray_1_contain_region) (In yellow_book_1 wooden_tray_1_contain_region) (In black_book_1 wooden_tray_1_contain_region))
  )

)
