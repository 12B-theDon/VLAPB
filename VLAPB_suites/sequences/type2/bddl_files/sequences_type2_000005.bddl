(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Put the objects belonging to user_002 into the wooden_tray in this order: cookies, chocolate_pudding, akita_black_bowl)
    (:regions
      (wooden_tray_region
          (:target study_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target study_table)
          (:ranges (
              (0.0629 0.1905 0.1129 0.2405)
            )
          )
      )
      (object_init_region_1
          (:target study_table)
          (:ranges (
              (-0.2151 -0.0178 -0.1651 0.0322)
            )
          )
      )
      (object_init_region_2
          (:target study_table)
          (:ranges (
              (0.0820 -0.2278 0.1320 -0.1778)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    study_table - table
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    chocolate_pudding_1 - chocolate_pudding
    cookies_1 - cookies
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    cookies_1 chocolate_pudding_1 akita_black_bowl_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 study_table_wooden_tray_region)
    (On akita_black_bowl_1 study_table_object_init_region_0)
    (On chocolate_pudding_1 study_table_object_init_region_1)
    (On cookies_1 study_table_object_init_region_2)
  )

  (:goal
    (And (In cookies_1 wooden_tray_1_contain_region) (In chocolate_pudding_1 wooden_tray_1_contain_region) (In akita_black_bowl_1 wooden_tray_1_contain_region))
  )

)
