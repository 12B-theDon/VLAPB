(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Put the objects belonging to user_002 into the wooden_tray in this order: cream_cheese, chocolate_pudding, akita_black_bowl)
    (:regions
      (wooden_tray_region
          (:target study_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target study_table)
          (:ranges (
              (0.0486 0.2234 0.0986 0.2734)
            )
          )
      )
      (object_init_region_1
          (:target study_table)
          (:ranges (
              (-0.2560 -0.0391 -0.2060 0.0109)
            )
          )
      )
      (object_init_region_2
          (:target study_table)
          (:ranges (
              (0.1190 -0.2427 0.1690 -0.1927)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    study_table - table
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    chocolate_pudding_1 - chocolate_pudding
    cream_cheese_1 - cream_cheese
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    cream_cheese_1 chocolate_pudding_1 akita_black_bowl_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 study_table_wooden_tray_region)
    (On akita_black_bowl_1 study_table_object_init_region_0)
    (On chocolate_pudding_1 study_table_object_init_region_1)
    (On cream_cheese_1 study_table_object_init_region_2)
  )

  (:goal
    (And (In cream_cheese_1 wooden_tray_1_contain_region) (In chocolate_pudding_1 wooden_tray_1_contain_region) (In akita_black_bowl_1 wooden_tray_1_contain_region))
  )

)
