(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Put the objects belonging to user_002 into the wooden_tray in this order: cream_cheese, cookies, akita_black_bowl)
    (:regions
      (wooden_tray_region
          (:target kitchen_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.0434 0.1620 0.0934 0.2120)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.2815 -0.0246 -0.2315 0.0254)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (0.0965 -0.2363 0.1465 -0.1863)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    kitchen_table - table
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    cookies_1 - cookies
    cream_cheese_1 - cream_cheese
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    cream_cheese_1 cookies_1 akita_black_bowl_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 kitchen_table_wooden_tray_region)
    (On akita_black_bowl_1 kitchen_table_object_init_region_0)
    (On cookies_1 kitchen_table_object_init_region_1)
    (On cream_cheese_1 kitchen_table_object_init_region_2)
  )

  (:goal
    (And (In cream_cheese_1 wooden_tray_1_contain_region) (In cookies_1 wooden_tray_1_contain_region) (In akita_black_bowl_1 wooden_tray_1_contain_region))
  )

)
