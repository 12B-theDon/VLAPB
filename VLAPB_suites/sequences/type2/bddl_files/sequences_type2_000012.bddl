(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Put the objects belonging to user_003 into the wooden_tray in this order: glazed_rim_porcelain_ramekin, ketchup, milk)
    (:regions
      (wooden_tray_region
          (:target study_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target study_table)
          (:ranges (
              (0.0576 0.1475 0.1076 0.1975)
            )
          )
      )
      (object_init_region_1
          (:target study_table)
          (:ranges (
              (-0.2397 -0.0040 -0.1897 0.0460)
            )
          )
      )
      (object_init_region_2
          (:target study_table)
          (:ranges (
              (0.0717 -0.2380 0.1217 -0.1880)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    study_table - table
  )

  (:objects
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    ketchup_1 - ketchup
    milk_1 - milk
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    glazed_rim_porcelain_ramekin_1 ketchup_1 milk_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 study_table_wooden_tray_region)
    (On glazed_rim_porcelain_ramekin_1 study_table_object_init_region_0)
    (On ketchup_1 study_table_object_init_region_1)
    (On milk_1 study_table_object_init_region_2)
  )

  (:goal
    (And (In glazed_rim_porcelain_ramekin_1 wooden_tray_1_contain_region) (In ketchup_1 wooden_tray_1_contain_region) (In milk_1 wooden_tray_1_contain_region))
  )

)
