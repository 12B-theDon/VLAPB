(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Put the objects belonging to user_005 into the wooden_tray in this order: tomato_sauce, salad_dressing, akita_black_bowl)
    (:regions
      (wooden_tray_region
          (:target kitchen_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.0253 0.2152 0.0753 0.2652)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.2193 -0.0529 -0.1693 -0.0029)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (0.1161 -0.2045 0.1661 -0.1545)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    kitchen_table - table
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    salad_dressing_1 - salad_dressing
    tomato_sauce_1 - tomato_sauce
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    tomato_sauce_1 salad_dressing_1 akita_black_bowl_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 kitchen_table_wooden_tray_region)
    (On akita_black_bowl_1 kitchen_table_object_init_region_0)
    (On salad_dressing_1 kitchen_table_object_init_region_1)
    (On tomato_sauce_1 kitchen_table_object_init_region_2)
  )

  (:goal
    (And (In tomato_sauce_1 wooden_tray_1_contain_region) (In salad_dressing_1 wooden_tray_1_contain_region) (In akita_black_bowl_1 wooden_tray_1_contain_region))
  )

)
