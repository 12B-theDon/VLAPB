(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Put the objects belonging to user_006 into the wooden_tray in this order: akita_black_bowl, white_bowl, white_yellow_mug)
    (:regions
      (wooden_tray_region
          (:target living_room_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.0291 0.1794 0.0791 0.2294)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.2416 -0.0446 -0.1916 0.0054)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (0.1237 -0.2361 0.1737 -0.1861)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    living_room_table - table
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    white_bowl_1 - white_bowl
    white_yellow_mug_1 - white_yellow_mug
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    akita_black_bowl_1 white_bowl_1 white_yellow_mug_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 living_room_table_wooden_tray_region)
    (On akita_black_bowl_1 living_room_table_object_init_region_0)
    (On white_bowl_1 living_room_table_object_init_region_1)
    (On white_yellow_mug_1 living_room_table_object_init_region_2)
  )

  (:goal
    (And (In akita_black_bowl_1 wooden_tray_1_contain_region) (In white_bowl_1 wooden_tray_1_contain_region) (In white_yellow_mug_1 wooden_tray_1_contain_region))
  )

)
