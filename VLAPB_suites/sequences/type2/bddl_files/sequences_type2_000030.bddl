(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Put the objects belonging to user_008 into the wooden_tray in this order: cookies, alphabet_soup, orange_juice)
    (:regions
      (wooden_tray_region
          (:target study_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target study_table)
          (:ranges (
              (0.0313 0.2217 0.0813 0.2717)
            )
          )
      )
      (object_init_region_1
          (:target study_table)
          (:ranges (
              (-0.2152 -0.0488 -0.1652 0.0012)
            )
          )
      )
      (object_init_region_2
          (:target study_table)
          (:ranges (
              (0.1214 -0.2184 0.1714 -0.1684)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    study_table - table
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    cookies_1 - cookies
    orange_juice_1 - orange_juice
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    cookies_1 alphabet_soup_1 orange_juice_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 study_table_wooden_tray_region)
    (On alphabet_soup_1 study_table_object_init_region_0)
    (On cookies_1 study_table_object_init_region_1)
    (On orange_juice_1 study_table_object_init_region_2)
  )

  (:goal
    (And (In cookies_1 wooden_tray_1_contain_region) (In alphabet_soup_1 wooden_tray_1_contain_region) (In orange_juice_1 wooden_tray_1_contain_region))
  )

)
