(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Put the objects belonging to user_009 into the wooden_tray in this order: alphabet_soup, cream_cheese, milk)
    (:regions
      (wooden_tray_region
          (:target living_room_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.0447 0.2066 0.0947 0.2566)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.2548 -0.0381 -0.2048 0.0119)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (0.0831 -0.1899 0.1331 -0.1399)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    living_room_table - table
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    cream_cheese_1 - cream_cheese
    milk_1 - milk
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    alphabet_soup_1 cream_cheese_1 milk_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 living_room_table_wooden_tray_region)
    (On alphabet_soup_1 living_room_table_object_init_region_0)
    (On cream_cheese_1 living_room_table_object_init_region_1)
    (On milk_1 living_room_table_object_init_region_2)
  )

  (:goal
    (And (In alphabet_soup_1 wooden_tray_1_contain_region) (In cream_cheese_1 wooden_tray_1_contain_region) (In milk_1 wooden_tray_1_contain_region))
  )

)
