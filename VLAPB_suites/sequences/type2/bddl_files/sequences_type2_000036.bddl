(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Put the objects belonging to user_009 into the wooden_tray in this order: cream_cheese, milk, porcelain_mug)
    (:regions
      (wooden_tray_region
          (:target study_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target study_table)
          (:ranges (
              (0.0604 0.1860 0.1104 0.2360)
            )
          )
      )
      (object_init_region_1
          (:target study_table)
          (:ranges (
              (-0.2383 -0.0174 -0.1883 0.0326)
            )
          )
      )
      (object_init_region_2
          (:target study_table)
          (:ranges (
              (0.0693 -0.2027 0.1193 -0.1527)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    study_table - table
  )

  (:objects
    cream_cheese_1 - cream_cheese
    milk_1 - milk
    porcelain_mug_1 - porcelain_mug
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    cream_cheese_1 milk_1 porcelain_mug_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 study_table_wooden_tray_region)
    (On cream_cheese_1 study_table_object_init_region_0)
    (On milk_1 study_table_object_init_region_1)
    (On porcelain_mug_1 study_table_object_init_region_2)
  )

  (:goal
    (And (In cream_cheese_1 wooden_tray_1_contain_region) (In milk_1 wooden_tray_1_contain_region) (In porcelain_mug_1 wooden_tray_1_contain_region))
  )

)
