(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Put the objects belonging to user_011 into the wooden_tray in this order: red_coffee_mug, cookies, bbq_sauce)
    (:regions
      (wooden_tray_region
          (:target study_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target study_table)
          (:ranges (
              (0.0325 0.2117 0.0825 0.2617)
            )
          )
      )
      (object_init_region_1
          (:target study_table)
          (:ranges (
              (-0.2498 -0.0500 -0.1998 0.0000)
            )
          )
      )
      (object_init_region_2
          (:target study_table)
          (:ranges (
              (0.0956 -0.1889 0.1456 -0.1389)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    study_table - table
  )

  (:objects
    bbq_sauce_1 - bbq_sauce
    cookies_1 - cookies
    red_coffee_mug_1 - red_coffee_mug
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    red_coffee_mug_1 cookies_1 bbq_sauce_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 study_table_wooden_tray_region)
    (On bbq_sauce_1 study_table_object_init_region_0)
    (On cookies_1 study_table_object_init_region_1)
    (On red_coffee_mug_1 study_table_object_init_region_2)
  )

  (:goal
    (And (In red_coffee_mug_1 wooden_tray_1_contain_region) (In cookies_1 wooden_tray_1_contain_region) (In bbq_sauce_1 wooden_tray_1_contain_region))
  )

)
