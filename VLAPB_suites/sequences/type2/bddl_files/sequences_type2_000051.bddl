(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Put the objects belonging to user_013 into the wooden_tray in this order: tomato_sauce, orange_juice, bbq_sauce)
    (:regions
      (wooden_tray_region
          (:target living_room_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.0398 0.1683 0.0898 0.2183)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.2141 -0.0299 -0.1641 0.0201)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (0.0856 -0.2056 0.1356 -0.1556)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    living_room_table - table
  )

  (:objects
    bbq_sauce_1 - bbq_sauce
    orange_juice_1 - orange_juice
    tomato_sauce_1 - tomato_sauce
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    tomato_sauce_1 orange_juice_1 bbq_sauce_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 living_room_table_wooden_tray_region)
    (On bbq_sauce_1 living_room_table_object_init_region_0)
    (On orange_juice_1 living_room_table_object_init_region_1)
    (On tomato_sauce_1 living_room_table_object_init_region_2)
  )

  (:goal
    (And (In tomato_sauce_1 wooden_tray_1_contain_region) (In orange_juice_1 wooden_tray_1_contain_region) (In bbq_sauce_1 wooden_tray_1_contain_region))
  )

)
