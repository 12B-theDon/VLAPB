(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Put the objects belonging to user_014 into the wooden_tray in this order: butter, chocolate_pudding, milk)
    (:regions
      (wooden_tray_region
          (:target study_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target study_table)
          (:ranges (
              (0.0229 0.1735 0.0729 0.2235)
            )
          )
      )
      (object_init_region_1
          (:target study_table)
          (:ranges (
              (-0.2299 -0.0481 -0.1799 0.0019)
            )
          )
      )
      (object_init_region_2
          (:target study_table)
          (:ranges (
              (0.0873 -0.1771 0.1373 -0.1271)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    study_table - table
  )

  (:objects
    butter_1 - butter
    chocolate_pudding_1 - chocolate_pudding
    milk_1 - milk
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    butter_1 chocolate_pudding_1 milk_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 study_table_wooden_tray_region)
    (On butter_1 study_table_object_init_region_0)
    (On chocolate_pudding_1 study_table_object_init_region_1)
    (On milk_1 study_table_object_init_region_2)
  )

  (:goal
    (And (In butter_1 wooden_tray_1_contain_region) (In chocolate_pudding_1 wooden_tray_1_contain_region) (In milk_1 wooden_tray_1_contain_region))
  )

)
