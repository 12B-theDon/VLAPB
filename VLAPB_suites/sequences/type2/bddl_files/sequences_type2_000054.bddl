(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Put the objects belonging to user_014 into the wooden_tray in this order: butter, chocolate_pudding, red_coffee_mug)
    (:regions
      (wooden_tray_region
          (:target study_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target study_table)
          (:ranges (
              (0.0621 0.1735 0.1121 0.2235)
            )
          )
      )
      (object_init_region_1
          (:target study_table)
          (:ranges (
              (-0.2232 -0.0122 -0.1732 0.0378)
            )
          )
      )
      (object_init_region_2
          (:target study_table)
          (:ranges (
              (0.0723 -0.2218 0.1223 -0.1718)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    study_table - table
  )

  (:objects
    butter_1 - butter
    chocolate_pudding_1 - chocolate_pudding
    red_coffee_mug_1 - red_coffee_mug
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    butter_1 chocolate_pudding_1 red_coffee_mug_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 study_table_wooden_tray_region)
    (On butter_1 study_table_object_init_region_0)
    (On chocolate_pudding_1 study_table_object_init_region_1)
    (On red_coffee_mug_1 study_table_object_init_region_2)
  )

  (:goal
    (And (In butter_1 wooden_tray_1_contain_region) (In chocolate_pudding_1 wooden_tray_1_contain_region) (In red_coffee_mug_1 wooden_tray_1_contain_region))
  )

)
