(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Put the objects belonging to user_015 into the wooden_tray in this order: cookies, tomato_sauce, new_salad_dressing)
    (:regions
      (wooden_tray_region
          (:target study_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target study_table)
          (:ranges (
              (0.0702 0.1541 0.1202 0.2041)
            )
          )
      )
      (object_init_region_1
          (:target study_table)
          (:ranges (
              (-0.2116 0.0012 -0.1616 0.0512)
            )
          )
      )
      (object_init_region_2
          (:target study_table)
          (:ranges (
              (0.0642 -0.2458 0.1142 -0.1958)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    study_table - table
  )

  (:objects
    cookies_1 - cookies
    new_salad_dressing_1 - new_salad_dressing
    tomato_sauce_1 - tomato_sauce
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    cookies_1 tomato_sauce_1 new_salad_dressing_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 study_table_wooden_tray_region)
    (On cookies_1 study_table_object_init_region_0)
    (On new_salad_dressing_1 study_table_object_init_region_1)
    (On tomato_sauce_1 study_table_object_init_region_2)
  )

  (:goal
    (And (In cookies_1 wooden_tray_1_contain_region) (In tomato_sauce_1 wooden_tray_1_contain_region) (In new_salad_dressing_1 wooden_tray_1_contain_region))
  )

)
