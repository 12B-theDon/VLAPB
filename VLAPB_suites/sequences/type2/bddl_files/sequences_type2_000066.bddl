(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Put the objects belonging to user_017 into the wooden_tray in this order: butter, ketchup, white_bowl)
    (:regions
      (wooden_tray_region
          (:target study_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target study_table)
          (:ranges (
              (0.0471 0.2058 0.0971 0.2558)
            )
          )
      )
      (object_init_region_1
          (:target study_table)
          (:ranges (
              (-0.2133 -0.0337 -0.1633 0.0163)
            )
          )
      )
      (object_init_region_2
          (:target study_table)
          (:ranges (
              (0.0893 -0.2033 0.1393 -0.1533)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    study_table - table
  )

  (:objects
    butter_1 - butter
    ketchup_1 - ketchup
    white_bowl_1 - white_bowl
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    butter_1 ketchup_1 white_bowl_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 study_table_wooden_tray_region)
    (On butter_1 study_table_object_init_region_0)
    (On ketchup_1 study_table_object_init_region_1)
    (On white_bowl_1 study_table_object_init_region_2)
  )

  (:goal
    (And (In butter_1 wooden_tray_1_contain_region) (In ketchup_1 wooden_tray_1_contain_region) (In white_bowl_1 wooden_tray_1_contain_region))
  )

)
