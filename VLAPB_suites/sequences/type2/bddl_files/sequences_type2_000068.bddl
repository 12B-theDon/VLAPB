(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Put the objects belonging to user_017 into the wooden_tray in this order: ketchup, salad_dressing, white_bowl)
    (:regions
      (wooden_tray_region
          (:target kitchen_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.0275 0.1936 0.0775 0.2436)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.2119 -0.0463 -0.1619 0.0037)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (0.1300 -0.2345 0.1800 -0.1845)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    kitchen_table - table
  )

  (:objects
    ketchup_1 - ketchup
    salad_dressing_1 - salad_dressing
    white_bowl_1 - white_bowl
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    ketchup_1 salad_dressing_1 white_bowl_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 kitchen_table_wooden_tray_region)
    (On ketchup_1 kitchen_table_object_init_region_0)
    (On salad_dressing_1 kitchen_table_object_init_region_1)
    (On white_bowl_1 kitchen_table_object_init_region_2)
  )

  (:goal
    (And (In ketchup_1 wooden_tray_1_contain_region) (In salad_dressing_1 wooden_tray_1_contain_region) (In white_bowl_1 wooden_tray_1_contain_region))
  )

)
