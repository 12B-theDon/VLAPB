(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Put the objects belonging to user_019 into the wooden_tray in this order: milk, cookies, wine_bottle)
    (:regions
      (wooden_tray_region
          (:target kitchen_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target kitchen_table)
          (:ranges (
              (0.0276 0.1742 0.0776 0.2242)
            )
          )
      )
      (object_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.2128 -0.0422 -0.1628 0.0078)
            )
          )
      )
      (object_init_region_2
          (:target kitchen_table)
          (:ranges (
              (0.1091 -0.2149 0.1591 -0.1649)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    kitchen_table - table
  )

  (:objects
    cookies_1 - cookies
    milk_1 - milk
    wine_bottle_1 - wine_bottle
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    milk_1 cookies_1 wine_bottle_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 kitchen_table_wooden_tray_region)
    (On cookies_1 kitchen_table_object_init_region_0)
    (On milk_1 kitchen_table_object_init_region_1)
    (On wine_bottle_1 kitchen_table_object_init_region_2)
  )

  (:goal
    (And (In milk_1 wooden_tray_1_contain_region) (In cookies_1 wooden_tray_1_contain_region) (In wine_bottle_1 wooden_tray_1_contain_region))
  )

)
