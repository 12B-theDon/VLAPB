(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Put the objects belonging to user_019 into the wooden_tray in this order: salad_dressing, cookies, wine_bottle)
    (:regions
      (wooden_tray_region
          (:target living_room_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.0110 0.1961 0.0610 0.2461)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.2435 -0.0665 -0.1935 -0.0165)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (0.1252 -0.1992 0.1752 -0.1492)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    living_room_table - table
  )

  (:objects
    cookies_1 - cookies
    salad_dressing_1 - salad_dressing
    wine_bottle_1 - wine_bottle
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    salad_dressing_1 cookies_1 wine_bottle_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 living_room_table_wooden_tray_region)
    (On cookies_1 living_room_table_object_init_region_0)
    (On salad_dressing_1 living_room_table_object_init_region_1)
    (On wine_bottle_1 living_room_table_object_init_region_2)
  )

  (:goal
    (And (In salad_dressing_1 wooden_tray_1_contain_region) (In cookies_1 wooden_tray_1_contain_region) (In wine_bottle_1 wooden_tray_1_contain_region))
  )

)
