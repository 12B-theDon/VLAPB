(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Put the objects belonging to user_019 into the wooden_tray in this order: salad_dressing, milk, wine_bottle)
    (:regions
      (wooden_tray_region
          (:target living_room_table)
          (:ranges (
              (-0.0300 -0.0300 0.0300 0.0300)
            )
          )
      )
      (object_init_region_0
          (:target living_room_table)
          (:ranges (
              (0.0319 0.1725 0.0819 0.2225)
            )
          )
      )
      (object_init_region_1
          (:target living_room_table)
          (:ranges (
              (-0.2234 -0.0387 -0.1734 0.0113)
            )
          )
      )
      (object_init_region_2
          (:target living_room_table)
          (:ranges (
              (0.1047 -0.2177 0.1547 -0.1677)
            )
          )
      )
      (contain_region
          (:target wooden_tray_1)
      )
    )

  (:fixtures
    living_room_table - table
  )

  (:objects
    milk_1 - milk
    salad_dressing_1 - salad_dressing
    wine_bottle_1 - wine_bottle
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    salad_dressing_1 milk_1 wine_bottle_1
    wooden_tray_1
  )

  (:init
    (On wooden_tray_1 living_room_table_wooden_tray_region)
    (On milk_1 living_room_table_object_init_region_0)
    (On salad_dressing_1 living_room_table_object_init_region_1)
    (On wine_bottle_1 living_room_table_object_init_region_2)
  )

  (:goal
    (And (In salad_dressing_1 wooden_tray_1_contain_region) (In milk_1 wooden_tray_1_contain_region) (In wine_bottle_1 wooden_tray_1_contain_region))
  )

)
